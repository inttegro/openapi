                                "path": "/canceled_at",
                                "state": "absent"
                            }
                        ]
                    },
                    "when": {
                        "equals": "paid",
                        "path": "/status"
                    }
                }
            },
            {
                "implies": {
                    "then": {
                        "all": [
                            {
                                "path": "/sealed_at",
                                "state": "non-null"
                            },
                            {
                                "path": "/completed_at",
                                "state": "non-null"
                            },
                            {
                                "path": "/canceled_at",
                                "state": "absent"
                            }
                        ]
                    },
                    "when": {
                        "equals": "completed",
                        "path": "/status"
                    }
                }
            },
            {
                "implies": {
                    "then": {
                        "all": [
                            {
                                "path": "/paid_at",
                                "state": "absent"
                            },
                            {
                                "path": "/completed_at",
                                "state": "absent"
                            },
                            {
                                "path": "/canceled_at",
                                "state": "non-null"
                            }
                        ]
                    },
                    "when": {
                        "equals": "canceled",
                        "path": "/status"
                    }
                }
            },
            {
                "implies": {
                    "then": {
                        "all": [
                            {
                                "path": "/expires_at",
                                "state": "non-null"
                            },
                            {
                                "path": "/paid_at",
                                "state": "absent"
                            },
                            {
                                "path": "/completed_at",
                                "state": "absent"
                            },
                            {
                                "path": "/canceled_at",
                                "state": "absent"
                            }
                        ]
                    },
                    "when": {
                        "equals": "expired",
                        "path": "/status"
                    }
                }
            },
            {
                "implies": {
                    "then": {
                        "all": [
                            {
                                "path": "/sealed_at",
                                "state": "absent"
                            },
                            {
                                "path": "/paid_at",
                                "state": "absent"
                            },
                            {
                                "path": "/completed_at",
                                "state": "absent"
                            },
                            {
