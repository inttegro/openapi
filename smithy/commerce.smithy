                                "all": [
                                    {
                                        "path": "/paid_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/failed_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/canceled_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/expired_at",
                                        "state": "non-null"
                                    }
                                ]
                            },
                            "when": {
                                "equals": "expired",
                                "path": "/status"
                            }
                        }
                    },
                    {
                        "implies": {
                            "then": {
                                "all": [
                                    {
                                        "path": "/executed_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/paid_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/failed_at",
                                        "state": "absent"
