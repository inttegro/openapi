    /// Stored byte size after any lossless encoding.
    @required
    stored_size: Long
}

@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/updated_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/inactive_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/expires_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/inactive_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "active",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/inactive_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "equals": "inactive",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/inactive_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "used",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/expires_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/inactive_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "expired",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": true,
                            "path": "/allow_variants"
                        },
                        {
                            "path": "/product",
                            "state": "non-null"
                        },
                        {
                            "path": "/bundle",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "path": "/variant_set",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": false,
                            "path": "/allow_variants"
                        }
                    ]
                },
                "when": {
                    "path": "/variant_set",
                    "state": "absent"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/product",
                            "state": "absent"
                        },
                        {
                            "path": "/variant_set",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "path": "/bundle",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/bundle",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "path": "/product",
                    "state": "non-null"
                }
            }
        }
    ]
)
structure PurchaseIntent with [PurchaseIntentMixin] {}

structure PurchaseIntentBundle {
    about: String
    components: PurchaseIntentBundlecomponents
    /// Current app-owned bundle referenced by the Buy link
    @dataExamples([
    {
        "json": "pbd_abc123"
    }
])
    @pattern("^pbd_")
    @required
    id: String
    media: ProductMedia
    name: String
    price: PurchaseIntentBundleprice
    reference: String
}

structure PurchaseIntentBundleComponent {
    about: String
    category: String
    image_url: String
    @required
    name: String
    @pattern("^pr_")
    price_id: String
    @pattern("^prod_")
    product_id: String
    @range(
        min: 1
    )
    @required
    quantity: Integer
    reference: String
    type: String
}

/// Current bundle catalog price reference. The top-level price is the effective Buy-link offer.
structure PurchaseIntentBundleprice with [PurchaseIntentPriceMixin] {}

/// Bundle selection. Components are resolved from the live catalog. Omit price and price_id to use the current catalog bundle price.
structure PurchaseIntentBundleSelection {
    /// App-owned bundle ID to sell through the Buy link
    @dataExamples([
    {
        "json": "pbd_abc123"
    }
])
    @pattern("^pbd_")
    @required
    id: String
}

/// Current public merchant presentation resolved from the purchase intent's application. It is hydrated at lookup time and is not stored on the purchase intent.
structure PurchaseIntentMerchant {
    @required
    branding: PurchaseIntentMerchantBranding
    @required
    profile: PurchaseIntentMerchantProfile
}

structure PurchaseIntentMerchantAsset {
    /// Accessible description of the merchant asset
    @dataExamples([
    {
        "json": "Tea House"
    }
])
    alt_text: String
    /// Public URL of the merchant asset
    @dataExamples([
    {
        "json": "https://assets.example.com/tea-house.png"
    }
])
    @required
    url: String
}

structure PurchaseIntentMerchantBranding {
    /// Merchant accent color as a normalized six-digit hexadecimal value
    @dataExamples([
    {
        "json": "#16a34a"
    }
])
    @required
    accent_color: String
    @required
    color_scheme: PurchaseIntentMerchantColorScheme
    icon: PurchaseIntentMerchantAsset
    logo: PurchaseIntentMerchantAsset
}

structure PurchaseIntentMerchantColorScheme {
    @dataExamples([
    {
        "json": "#b9e3c8"
    }
])
    @required
    border: String
    @dataExamples([
    {
        "json": "#128650"
    }
])
    @required
    link: String
    @dataExamples([
    {
        "json": "#096d2f"
    }
])
    @required
    muted_text: String
    @dataExamples([
    {
        "json": "#16a34a"
    }
])
    @required
    primary: String
    @dataExamples([
    {
        "json": "#ffffff"
    }
])
    @required
    primary_foreground: String
    @dataExamples([
    {
        "json": "#f1faf5"
    }
])
    @required
    surface: String
    @dataExamples([
    {
        "json": "#e3f4e9"
    }
])
    @required
    surface_muted: String
    @dataExamples([
    {
        "json": "#041d0d"
    }
])
    @required
    text: String
}

structure PurchaseIntentMerchantProfile {
    /// Current public application alias, falling back to its current application name
    @dataExamples([
    {
        "json": "Tea House"
    }
])
    @required
    name: String
    support: PurchaseIntentMerchantSupport
    /// Public merchant website URL
    @dataExamples([
    {
        "json": "https://teahouse.example"
    }
])
    website_url: String
}

structure PurchaseIntentMerchantSupport {
    /// Public merchant support email address
    @dataExamples([
    {
        "json": "support@teahouse.example"
    }
])
    email: String
    /// Public merchant support phone number
    @dataExamples([
    {
        "json": "+233200000000"
    }
])
    phone: String
}

