    @required
    page: FilePage
}

structure FileParty {
    type: String
    id: String
    name: String
    email: String
}

structure FileReferenceInput {
    /// Non-blank file ID after trimming.
    @length(
        min: 1
    )
    @required
    file_id: String
    /// Non-blank resource field after trimming.
    @dataExamples([
    {
        "json": "media.gallery[0]"
    }
])
    @length(
        min: 1
    )
    @required
    field: String
    /// Caller-supplied file or file link reference.
    reference: String
    /// Caller-defined reference kind; `file` and `file_link` are recommended.
    reference_kind: String
    purpose: String
}

structure FileReferenceReconcileRequest {
    /// Non-blank resource type after trimming.
    @dataExamples([
    {
        "json": "product"
    }
])
    @length(
        min: 1
    )
    @required
    resource_type: String
    /// Non-blank resource ID after trimming.
    @dataExamples([
    {
        "json": "prod_123"
    }
])
    @length(
        min: 1
    )
    @required
    resource_id: String
    references: FileReferenceReconcileRequestreferences
}

structure FileReferenceReconcileResponse {
    @required
    reconciled: Boolean
}

