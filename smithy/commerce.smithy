    @required
    name: String
    @required
    address: UpdateOrderPaymentMethodOwnerInputaddress
}

structure UpdateOrderPaymentMethodOwnerInputaddress {
    @required
    country: String
}

@simileSchema(
{
        "additionalProperties": false,
        "allOf": [
            {
                "not": {
                    "properties": {
                        "payment_method_data": {},
                        "payment_method_id": {}
                    },
                    "required": [
                        "payment_method_id",
                        "payment_method_data"
                    ]
                }
            },
            {
                "not": {
                    "properties": {
                        "clear_payment_method": {
                            "enum": [
                                true
                            ]
                        },
                        "payment_method_id": {}
                    },
                    "required": [
                        "clear_payment_method",
                        "payment_method_id"
                    ]
                }
            },
            {
                "not": {
                    "properties": {
                        "clear_payment_method": {
                            "enum": [
                                true
                            ]
                        },
                        "payment_method_data": {}
                    },
                    "required": [
                        "clear_payment_method",
                        "payment_method_data"
                    ]
                }
            },
            {
                "not": {
                    "properties": {
                        "statement_descriptor": {},
                        "statement_descriptor_prefix": {}
                    },
                    "required": [
                        "statement_descriptor",
                        "statement_descriptor_prefix"
                    ]
                }
            }
        ],
        "properties": {
            "clear_payment_method": {
                "default": false,
                "description": "Clears the currently attached payment method. Mutually exclusive with\n`payment_method_id` and `payment_method_data`.\n",
                "type": "boolean"
            },
            "custom_data": {
                "shape": "CustomData"
            },
            "finalize": {
                "description": "Explicit seal decision. Set to `false` to reopen a sealed order and leave it\nopen, or `true` to seal or reseal the order after applying the requested\nmutations.\n",
                "type": "boolean"
            },
            "invoice_settings": {
                "shape": "InvoiceSettings"
            },
            "line_items": {
                "description": "Full replacement for the order's line items. Omit this field to keep the\ncurrent line items unchanged.\n",
                "items": {
                    "shape": "LineItem"
                },
                "minItems": 1,
                "type": "array"
            },
            "number": {
                "description": "Replacement order number.",
                "example": "ORDER-12345-REV2",
                "type": "string"
            },
            "order_id": {
                "description": "Unique identifier of the order to update.",
                "example": "or_48ZW7BGvYUBWc1i6WBkL2jr0iPQP5jUy76mmmHpt",
                "pattern": "^or_",
                "type": "string"
            },
            "payment_method_data": {
                "allOf": [
                    {
                        "shape": "UpdateOrderPaymentMethodData"
                    }
                ],
                "description": "New payment method details to tokenize and attach to the order. Currently\nonly `mobile_money` is supported for order updates. When using inline mobile\nmoney details, include `billing_details.name` and\n`billing_details.address.country`.\n"
            },
            "payment_method_id": {
                "description": "ID of a saved payment method to attach to the order. Mutually exclusive\nwith `payment_method_data` and `clear_payment_method`.\n",
                "example": "pm_xyz123abc456",
                "pattern": "^pm_",
                "type": "string"
            },
            "receipt_number": {
                "description": "Replacement receipt number. Once set, it cannot be unset; provide a\ndifferent non-empty value to change it. No uniqueness is enforced.\n",
                "example": "RCPT-12345-REV2",
                "type": "string"
            },
            "statement_descriptor": {
                "description": "Replacement payment statement descriptor for the order's payment.",
                "example": "ORDER 12345",
                "maxLength": 22,
                "minLength": 3,
                "type": "string"
            },
            "statement_descriptor_prefix": {
                "description": "Static prefix used to build the replacement descriptor as `prefix*order_id`. Mutually exclusive with `statement_descriptor`.",
                "example": "LINE",
                "maxLength": 10,
                "minLength": 2,
                "pattern": "^[^*]+$",
                "type": "string"
            }
        },
        "required": [
            "order_id"
        ],
        "type": "object"
    }
)
structure UpdateOrderRequest {
    /// Clears the currently attached payment method. Mutually exclusive with
    /// `payment_method_id` and `payment_method_data`.
    ///
    clear_payment_method: Boolean
    custom_data: CustomData
    invoice_settings: InvoiceSettings
    /// Explicit seal decision. Set to `false` to reopen a sealed order and leave it
    /// open, or `true` to seal or reseal the order after applying the requested
    /// mutations.
    ///
    finalize: Boolean
    line_items: UpdateOrderRequestlineItems
    /// Replacement order number.
    @dataExamples([
    {
        "json": "ORDER-12345-REV2"
    }
])
    number: String
    /// Replacement receipt number. Once set, it cannot be unset; provide a
    /// different non-empty value to change it. No uniqueness is enforced.
    ///
    @dataExamples([
    {
        "json": "RCPT-12345-REV2"
    }
])
    receipt_number: String
    /// Unique identifier of the order to update.
    @dataExamples([
    {
        "json": "or_48ZW7BGvYUBWc1i6WBkL2jr0iPQP5jUy76mmmHpt"
    }
])
    @pattern("^or_")
    @required
    order_id: String
    payment_method_data: UpdateOrderRequestpaymentMethodData
    /// ID of a saved payment method to attach to the order. Mutually exclusive
    /// with `payment_method_data` and `clear_payment_method`.
    ///
    @dataExamples([
    {
        "json": "pm_xyz123abc456"
    }
])
    @pattern("^pm_")
    payment_method_id: String
    /// Replacement payment statement descriptor for the order's payment.
    @dataExamples([
    {
        "json": "ORDER 12345"
    }
])
    @length(
        min: 3
        max: 22
    )
    statement_descriptor: String
    /// Static prefix used to build the replacement descriptor as `prefix*order_id`. Mutually exclusive with `statement_descriptor`.
    @dataExamples([
    {
        "json": "LINE"
    }
])
    @length(
        min: 2
        max: 10
    )
    @pattern("^[^*]+$")
    statement_descriptor_prefix: String
}

/// New payment method details to tokenize and attach to the order. Currently
/// only `mobile_money` is supported for order updates. When using inline mobile
/// money details, include `billing_details.name` and
/// `billing_details.address.country`.
///
structure UpdateOrderRequestpaymentMethodData with [UpdateOrderPaymentMethodData] {}

structure UpdatePaymentMethodRequest {
    /// ID of the payment method to update
    @dataExamples([
    {
        "json": "pm_xyz789"
    }
])
    @pattern("^pm_")
    @required
    payment_method_id: String
    custom_data: CustomDataPatch
    /// Set to `true` to activate the payment method or `false` to mark it inactive.
    @dataExamples([
    {
        "json": true
    }
])
    active: Boolean
    /// Set to `true` to archive the payment method or `false` to unarchive it.
    @dataExamples([
    {
        "json": false
    }
])
    archived: Boolean
    owner: UpdatePaymentMethodRequestowner
}

/// Owner details to patch onto the payment method.
structure UpdatePaymentMethodRequestowner {
    /// Full legal name of the account holder.
    @dataExamples([
    {
        "json": "Jane Mensah"
    }
])
