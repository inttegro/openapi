    @pattern("^file_")
    file_id: String
    /// Public capability URL returned when available. Treat as bearer-secret material.
    upload_url: String
    @required
    constraints: UploadRequestConstraints
    @required
    display: UploadRequestDisplay
    @required
    subject: FileParty
    @required
    recipient: FileParty
    @required
    resource: FileResource
    @required
    requester: UploadRequestActor
    @required
