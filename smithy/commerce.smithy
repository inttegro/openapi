/// Error encountered when scheduling a chime for a specific recipient
structure ScheduleError {
    /// Recipient address that caused the error
    @dataExamples([
    {
        "json": "+233invalid"
    }
])
    recipient: String
    /// Code indicating how to fix this error
    @dataExamples([
    {
        "json": "check_recipient"
    }
])
    fix_code: String
    /// Error type classification
    @dataExamples([
    {
        "json": "invalid_recipient"
    }
])
    type: String
}

structure ScheduleLookupResponse {
    @required
    scheduled_chime: ScheduleDetail
}

/// Parameters for scheduling a payout.
structure SchedulePayoutRequest {
    /// Financial account that should receive the payout.
    @dataExamples([
    {
        "json": "fa_1234567890abcdef"
    }
])
    @pattern("^fa_")
    @required
    destination_id: String
    /// Optional future time after which execution may begin.
    @dataExamples([
    {
        "json": "2026-08-05T09:00Z"
    }
])
    @timestampFormat("date-time")
    execute_after: Timestamp
    /// Maximum amount, in the smallest currency unit, that this payout may transfer.
    @dataExamples([
    {
        "json": 250000
    }
])
    @range(
        min: 25000
    )
    max_amount: Integer
    /// Merchant reference carried on the payout.
    @dataExamples([
    {
        "json": "PAYOUT-APR-15"
    }
])
    @required
    reference: String
}

structure ScheduleResponse {
    @required
    scheduled_chime: ScheduleCreationDetail
}

/// Public secret key metadata. The bearer token is never returned by read or mutation endpoints.
@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/issued_at",
                    "/updated_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/issued_at",
                    "/revoked_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/issued_at",
                    "/last_used_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": true,
                            "path": "/active"
                        },
                        {
                            "path": "/revoked_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "active",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": false,
                            "path": "/active"
                        },
                        {
                            "path": "/revoked_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "equals": "revoked",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": false,
                            "path": "/active"
                        },
                        {
                            "path": "/revoked_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "expired",
                    "path": "/status"
                }
            }
        }
    ]
)
structure SecretKey {
    /// Application-scoped secret key identifier.
    @dataExamples([
    {
        "json": "sk_2xC7k9gK5yQnZ4w8P1sT6vR3"
    }
])
    @pattern("^sk_")
    @required
    id: String
    /// Optional human-readable label for the secret key.
    @dataExamples([
    {
        "json": "Production checkout"
    }
])
    label: String
    @required
    token_type: SecretKeytokenType
    @required
    @timestampFormat("date-time")
    issued_at: Timestamp
    /// Omitted until the label is changed.
    @timestampFormat("date-time")
    updated_at: Timestamp
    /// Omitted for keys without a fixed expiry.
    @timestampFormat("date-time")
    expires_at: Timestamp
    @required
    status: SecretKeystatus
    @required
    active: Boolean
    /// Omitted until the key is revoked.
    @timestampFormat("date-time")
    revoked_at: Timestamp
    /// Most recent recorded authentication when available; otherwise omitted.
    @timestampFormat("date-time")
    last_used_at: Timestamp
    /// Number of recorded authentications when available; omitted when zero.
    @range(
        min: 0
    )
    usage_count: Integer
}

@simileConstraints(
[
        {
            "aggregate": {
                "operation": "count",
                "source": "/keys/*",
                "target": "/count"
            }
        },
        {
            "bounded": {
                "maximum": {
                    "path": "/size"
                },
                "path": "/count"
            }
        },
        {
            "bounded": {
                "maximum": {
                    "path": "/total"
                },
                "path": "/count"
            }
        }
    ]
)
structure SecretKeyPage {
    @range(
        min: 1
    )
    @required
    number: Integer
    @range(
        min: 1
        max: 100
    )
    @required
    size: Integer
    @range(
        min: 0
        max: 100
    )
    @required
    count: Integer
    @range(
        min: 0
    )
    @required
    total: Integer
    @required
    has_more: Boolean
    @required
    keys: SecretKeyPagekeys
}

@simileConstraints(
[
        {
            "aggregate": {
                "operation": "count",
                "source": "/rows/*",
                "target": "/count"
            }
        }
    ]
)
structure SecretKeyUsagePage {
    @range(
        min: 1
    )
    @required
    number: Integer
    @range(
        min: 0
    )
    @required
    size: Integer
    @range(
        min: 0
    )
    @required
    count: Integer
    @range(
        min: 0
    )
    @required
    total: Integer
    @required
    has_more: Boolean
    @required
    rows: SecretKeyUsagePagerows
}

structure SecretKeyUsageRequest {
    /// Page number. Omitted or 0 is normalized to 1.
    @range(
        min: 0
    )
    number: Integer
    /// Page number alias. Omitted or 0 is normalized to 1.
    @range(
        min: 0
    )
    page: Integer
    /// Secret key identifier whose recent activity should be returned.
    @dataExamples([
    {
        "json": "sk_2xC7k9gK5yQnZ4w8P1sT6vR3"
    }
])
    @pattern("^sk_")
    @required
    secret_key_id: String
    /// Requested page size. Omitted or 0 becomes 50; values above 100 are capped at 100.
    @range(
        min: 0
    )
    size: Integer
}

structure SecretKeyUsageResponse {
    @required
    key: SecretKey
    @required
    usage: SecretKeyUsagePage
}

/// Public authentication outcome associated with the selected key.
structure SecretKeyUsageRow {
    @dataExamples([
    {
        "json": "sk_2xC7k9gK5yQnZ4w8P1sT6vR3"
    }
])
    @pattern("^sk_")
    @required
    secret_key_id: String
    @required
    @timestampFormat("date-time")
    occurred_at: Timestamp
    @required
    auth_result: SecretKeyUsageRowauthResult
}

/// Request to send a chime to a recipient.
/// SMS recipients accept either `full_message` or `message_template`.
/// Email recipients accept either `email` or `message_template`.
///
structure SendChimeRequest {
    @required
    recipient: ChimeRecipient
    /// Complete SMS message content. Use only with SMS recipients.
    @dataExamples([
    {
        "json": "Your verification code is 123456. It expires in 10 minutes."
    }
])
    full_message: String
    email: ChimeEmailMessageInput
    message_template: MessageTemplateReference
    /// Sender identifier shown to recipient. Uses default sender if not provided.
    @dataExamples([
    {
        "json": "YourBrand"
    }
])
    sender_id: String
    /// Purpose of this chime for categorization and analytics
    @dataExamples([
    {
        "json": "verification"
    }
])
    purpose: String
    cooldown: SendChimeRequestcooldown
    custom_data: CustomData
    request_meta: SendChimeRequestrequestMeta
}

/// Optional application-scoped delivery cooldown. A repeat send with the same key is rejected until the duration elapses.
structure SendChimeRequestcooldown {
    /// Stable identifier for the notification being sent.
    @length(
        min: 1
        max: 120
    )
    @required
    key: String
    /// Rolling cooldown from the first accepted send attempt.
    @range(
        min: 1
        max: 86400
    )
    @required
    duration_seconds: Integer
}

/// Optional metadata controlling request processing
structure SendChimeRequestrequestMeta {
    idempotency_key: SendChimeRequestrequestMetaidempotencyKey
    response: RequestResponse
}

/// Unique key to prevent duplicate sends
structure SendChimeRequestrequestMetaidempotencyKey {}

/// Supported payout destination assignments to update.
structure SetPayoutDestinationsRequest {
    @required
    destinations: PayoutDestinations
}

structure Shipping {
    @required
    address: Address
}

structure ShippingDetails {
    /// Unique ID for this shipping charge
    id: String
    /// The tax classification code for the shipping fee
    tax_code: String
    custom_data: CustomData
    @required
    fee: AmountParams
}

structure ShippingLineItem {
    @required
    shipping: ShippingDetails
}

structure SuggestedAmount {
    /// Stable merchant-defined identifier for this suggestion
    @required
    id: String
    /// Suggested amount in the currency's smallest unit
    @required
    value: Integer
    /// Whether this is the recommended suggestion
    recommended: Boolean
}

structure SuggestedAmountParams {
    /// Stable merchant-defined identifier for this suggestion
    @dataExamples([
    {
        "json": "supporter"
    }
])
    @length(
        max: 100
    )
    @required
    id: String
    /// Suggested amount in the currency's smallest unit
    @dataExamples([
    {
        "json": 50000
    }
])
    @range(
        min: 1
    )
    @required
    value: Integer
    /// Whether this is the single recommended suggestion
    recommended: Boolean
}

structure TemplateOperatingPolicySource {
    /// Template identifier.
    @pattern("^op_")
    @required
    id: String
    /// Template version.
    @range(
        min: 1
    )
    @required
    version: Integer
}

structure TokenizedMobileMoneyPaymentMethodObject with [PaymentMethodObjectMixin] {}

structure TokenizeMobileMoneyPaymentMethodRequest {
