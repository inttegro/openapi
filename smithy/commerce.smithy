            "type": {
                "enum": [
                    "fixed_amount"
                ],
                "type": "string"
            },
            "updated_at": {
                "description": "Last update timestamp",
                "example": "2024-01-20T14:45:00Z",
                "format": "date-time",
                "type": [
                    "string",
                    "null"
                ]
            }
        },
        "required": [
            "id",
            "active",
            "type",
            "created_at",
            "fixed_amount"
        ],
        "simileConstraints": [
            {
                "ordered": {
                    "paths": [
                        "/created_at",
                        "/updated_at"
                    ]
                }
            },
            {
                "ordered": {
                    "paths": [
                        "/created_at",
                        "/archived_at"
                    ]
                }
            },
            {
                "implies": {
                    "then": {
                        "all": [
                            {
                                "path": "/archived_at",
                                "state": "null-or-absent"
                            }
                        ]
                    },
                    "when": {
                        "equals": true,
                        "path": "/active"
                    }
                }
            }
        ],
        "type": "object"
    }
)
@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/updated_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/archived_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/archived_at",
                            "state": "null-or-absent"
                        }
                    ]
                },
                "when": {
                    "equals": true,
                    "path": "/active"
                }
            }
        }
    ]
)
@mixin
structure FixedCatalogPriceMixin {
    /// Unique price identifier with pr_ prefix
    @dataExamples([
    {
        "json": "pr_xyz789"
    }
])
    @pattern("^pr_")
    @required
    id: String
    /// Short label for this price
    @dataExamples([
    {
        "json": "Standard pricing"
    }
])
    label: String
    /// Longer description of this price
    @dataExamples([
    {
        "json": "Standard pricing for individual customers"
    }
])
    about: String
    /// Whether this price is active and usable in new flows
    @dataExamples([
    {
        "json": true
    }
])
    @required
    active: Boolean
    @required
    type: FixedCatalogPricetype
    @required
    fixed_amount: Amount
    /// Product ID when the operation returns the relationship by reference
    @dataExamples([
    {
        "json": "prod_abc123"
    }
])
    @pattern("^prod_")
    product_id: String
    product: FixedCatalogPriceproduct
    /// Price creation timestamp
    @dataExamples([
    {
        "json": "2024-01-15T10:30Z"
    }
])
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    /// Last update timestamp
    @dataExamples([
    {
        "json": "2024-01-20T14:45Z"
    }
])
    @timestampFormat("date-time")
    updated_at: Timestamp
    /// Archive timestamp (if archived). A non-null value means `active` is false.
    @timestampFormat("date-time")
    archived_at: Timestamp
}

structure FixedCatalogPriceParams {
    /// Product ID to associate this price with.
    @dataExamples([
    {
        "json": "prod_abc123"
    }
])
    @pattern("^prod_")
    product_id: String
    /// Short label for this price
    @dataExamples([
    {
        "json": "Standard pricing"
    }
])
    @length(
        max: 100
    )
    label: String
    /// Longer description of this price
    @dataExamples([
    {
        "json": "Standard pricing for individual customers"
    }
])
    @length(
        max: 500
    )
    about: String
    @required
    fixed_amount: AmountParams
}

/// Embedded product details, if this price belongs to a product
structure FixedCatalogPriceproduct with [PriceEmbeddedProduct] {}

@simileSchema(
