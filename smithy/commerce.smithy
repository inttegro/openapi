                            "state": "non-null"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failure",
                            "state": "absent"
                        },
                        {
                            "path": "/cancellation",
                            "state": "absent"
                        },
                        {
                            "path": "/error",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "succeeded",
                    "path": "/status"
                }
            }
        },
        {
