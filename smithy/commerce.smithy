                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "preparing",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/sealed_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/completed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "requires_payment",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/sealed_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/paid_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/completed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "paid",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/sealed_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/completed_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "completed",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/completed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "equals": "canceled",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/expires_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/completed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "expired",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/sealed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/completed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "unknown",
                    "path": "/status"
                }
            }
        },
        {
            "equal": {
                "paths": [
                    "/line_item_group/total/currency",
                    "/payment/amount/currency"
                ]
            }
        },
        {
            "equal": {
                "paths": [
                    "/line_item_group/total/value",
                    "/payment/amount/value"
                ]
            }
        }
    ]
)
@mixin
structure OrderMixin {
    /// When the order was canceled. Omitted otherwise.
    @timestampFormat("date-time")
    canceled_at: Timestamp
    checkout_settings: OrdercheckoutSettings
    /// When the order was completed. Omitted otherwise.
    @timestampFormat("date-time")
    completed_at: Timestamp
    created_from: OrdercreatedFrom
    custom_data: NonEmptyCustomData
    @required
    customer: Ordercustomer
    /// When the order expires. Omitted when no expiry is set.
    @timestampFormat("date-time")
    expires_at: Timestamp
    /// Unique identifier for this order
    @dataExamples([
    {
        "json": "or_48ZW7BGvYUBWc1i6WBkL2jr0iPQP5jUy76mmmHpt"
    }
])
    @pattern("^or_")
    @required
    id: String
    /// When order processing began
    @required
    @timestampFormat("date-time")
    initiated_at: Timestamp
    invoice: Orderinvoice
    /// Human-readable order number
    @dataExamples([
    {
        "json": "ORDER-12345"
    }
])
    number: String
    /// Merchant-provided receipt number, when set
    @dataExamples([
    {
        "json": "RCPT-12345"
    }
])
    receipt_number: String
    refunds: Orderrefunds
    invoice_settings: OrderInvoiceSettingsResponse
    @required
    status: Orderstatus
    /// When the order was finalized and became immutable—ready for payment or fulfillment
    @dataExamples([
    {
        "json": "2025-09-14T16:24:41.312701813Z"
    }
])
    @timestampFormat("date-time")
    sealed_at: Timestamp
    line_item_group: OrderlineItemGroup
    payment: Orderpayment
    /// When the order became paid
    @timestampFormat("date-time")
    paid_at: Timestamp
    /// When the order payment becomes overdue
    @timestampFormat("date-time")
    payment_due_at: Timestamp
    /// External order reference when present
    reference: String
}

