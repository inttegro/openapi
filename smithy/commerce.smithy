/// Generate a one-time password and deliver it by SMS or email. Store the returned transaction ID
/// and use it with the recipient's submitted code at the verification endpoint. Retry an
/// uncertain initiation with the same idempotency key and body.
///
@http(
    method: "POST"
    uri: "/otp/initiate"
    code: 200
)
@tags([
    "OTP"
])
@responseRelations(
{
        "200": {
            "application/json": {
                "rules": [
                    {
                        "then": {
                            "omit": [
                                "/transaction/transmission",
                                "/transaction/canceled_at",
                                "/transaction/cancel_reason"
                            ],
                            "set": {
                                "/transaction/status": "pending_delivery"
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "default": false,
                                    "equals": true,
                                    "request": "/async_delivery"
                                }
                            ]
                        }
                    }
                ]
            }
        }
    }
)
operation initiateOTP {
    input: initiateOTPInput
    output: initiateOTP200
    errors: [
        initiateOTP400
        initiateOTP401
        initiateOTP422
    ]
}

