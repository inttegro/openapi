@mixin
structure PriceEmbeddedProduct {
    /// Unique product identifier with prod_ prefix
    @dataExamples([
    {
        "json": "prod_abc123xyz"
    }
])
    @pattern("^prod_")
    @required
    id: String
    /// Full product description
    @dataExamples([
    {
        "json": "Starter plan for solo businesses"
    }
])
    about: String
    /// Whether product is published and available
    @dataExamples([
    {
        "json": true
    }
])
    @required
    active: Boolean
    /// Archive timestamp (if archived). A non-null value means `active` is false.
    @timestampFormat("date-time")
    archived_at: Timestamp
    attributes: PriceEmbeddedProductattributes
    /// Product category
    @dataExamples([
    {
        "json": "software"
    }
])
    category: String
    /// Product creation timestamp
    @dataExamples([
    {
        "json": "2024-01-15T10:30Z"
    }
])
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    custom_data: CustomData
    /// Short description
    @dataExamples([
    {
        "json": "Standard monthly subscription"
    }
])
    description: String
    dimensions: PriceEmbeddedProductdimensions
    media: PriceEmbeddedProductmedia
    /// Product name
    @dataExamples([
    {
        "json": "Starter plan"
    }
])
    @required
    name: String
    /// When the product was published
    @dataExamples([
    {
        "json": "2024-01-15T10:35Z"
    }
])
    @timestampFormat("date-time")
    published_at: Timestamp
    /// External reference or SKU
    @dataExamples([
    {
        "json": "plan-starter-monthly"
    }
])
    reference: String
    shipment: PriceEmbeddedProductshipment
    /// Tax classification code
    @dataExamples([
    {
        "json": "txcd_software"
    }
])
    tax_code: String
    @required
    type: PriceEmbeddedProducttype
    /// Unit dimension label
    @dataExamples([
    {
        "json": "license"
    }
])
    unit_dim: String
    /// Last update timestamp
    @timestampFormat("date-time")
    updated_at: Timestamp
}

structure PriceEmbeddedProductattributesItem {
    /// Attribute name
    @dataExamples([
    {
        "json": "tier"
    }
])
    @required
    name: String
    /// Attribute value
    @dataExamples([
    {
        "json": "starter"
    }
])
    @required
    value: String
}

/// Product dimensions and size metadata
structure PriceEmbeddedProductdimensions with [ProductDimensionsMixin] {}

/// Product media assets
structure PriceEmbeddedProductmedia with [ProductMediaMixin] {}

/// Shipment and fulfillment details
structure PriceEmbeddedProductshipment {}

structure PricePageItem {}

structure PricePageRequest {
    /// Page index to fetch. Omit it or send 0 to request page 1; otherwise use 1 through 10.
    @range(
        min: 0
        max: 10
    )
    page_number: Integer
    /// Number of prices per page (1-256)
    @range(
        min: 1
        max: 256
    )
    page_size: Integer
    /// Optional product ID to scope the page to a single product
    @dataExamples([
    {
        "json": "prod_abc123"
    }
])
    product_id: String
}

structure PricePageResponse {
    @required
    page: PricePageResponsepage
}

@simileConstraints(
[
        {
            "aggregate": {
                "operation": "count",
                "source": "/prices/*",
                "target": "/size"
            }
        }
