    guest: Boolean
    name: String
    email_address: String
    phone_number: String
    billing_address: OrderAddress
    shipping_address: OrderAddress
}

/// Checkout error response. The latest Order snapshot is included when available.
@mixin
structure CheckoutOrderErrorResponse {
    @required
    error: Error
    order: CheckoutOrder
}

structure CheckoutOrderLineItemAmountSelection {
    /// Product line-item ID whose amount should be changed.
    @dataExamples([
    {
        "json": "oli_a1b2c3d4e5f6"
    }
])
    @length(
        min: 1
    )
    @required
    id: String
    @required
    selected_amount: CheckoutSelectedAmount
}

structure CheckoutOrderlineItemGroup {
    line_items: CheckoutOrderlineItemGrouplineItems
    total: Amount
}

structure CheckoutOrderLookupResponse {
    @required
    order: CheckoutOrder
}

@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/initiated_at",
                    "/executed_at",
                    "/paid_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/initiated_at",
                    "/executed_at",
                    "/failed_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/initiated_at",
                    "/canceled_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/initiated_at",
                    "/expired_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/executed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/expired_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "initiated",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/next_action",
                            "state": "non-null"
                        },
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/expired_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "requires_action",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/expired_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "processing",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/due_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/expired_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "overdue",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/executed_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/expired_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "executed",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/paid_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/expired_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "paid",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/expired_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "failed",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/expired_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "canceled",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/expired_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "equals": "expired",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/executed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/paid_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/expired_at",
                            "state": "absent"
                        },
                        {
                            "path": "/next_action",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "unknown",
                    "path": "/status"
                }
            }
        }
    ]
)
structure CheckoutOrderpayment {
    @pattern("^py_")
    id: String
    statement_descriptor: String
    payment_method_types: CheckoutOrderpaymentpaymentMethodTypes
    payment_method: OrderPaymentMethod
    billing_details: OrderPaymentBillingDetails
    receipt: CheckoutInvoiceView
    latest_attempt: OrderPaymentAttempt
    amount: Amount
    next_action: PaymentNextAction
    latest_error: OrderPaymentError
    status: CheckoutOrderpaymentstatus
    @timestampFormat("date-time")
    initiated_at: Timestamp
    @timestampFormat("date-time")
    executed_at: Timestamp
    @timestampFormat("date-time")
    due_at: Timestamp
    @timestampFormat("date-time")
    canceled_at: Timestamp
    @timestampFormat("date-time")
    expired_at: Timestamp
    @timestampFormat("date-time")
    paid_at: Timestamp
    paid_offline: Boolean
    @timestampFormat("date-time")
    failed_at: Timestamp
}

structure CheckoutOrderReferenceRequest {
    /// The finalized Order to inspect or pay.
    @dataExamples([
    {
        "json": "or_a1b2c3d4e5f6"
    }
])
    @length(
        min: 1
    )
    @pattern("^or_")
    @required
    order_id: String
}

/// Successful checkout response.
structure CheckoutOrderResponse {
    @required
    order: CheckoutOrder
}

structure CheckoutOrderSelectAmountRequest {
    /// Existing finalized Order whose amount should be changed before payment begins.
    @dataExamples([
    {
        "json": "or_a1b2c3d4e5f6"
    }
])
    @length(
        min: 1
    )
    @pattern("^or_")
    @required
    order_id: String
    @required
    line_items: CheckoutOrderSelectAmountRequestlineItems
}

structure CheckoutPaymentAddress {
    name: String
    phone_number: String
    line1: String
    line2: String
    city: String
    region: String
    post_code: String
    /// ISO 3166-1 alpha-2 country code.
    @dataExamples([
    {
        "json": "GH"
    }
])
    @required
    country: String
}

@mixin
structure CheckoutPaymentMethodData {
    @required
    type: CheckoutPaymentMethodDatatype
    @required
    mobile_money: CheckoutMobileMoneyData
    billing_details: CheckoutPaymentMethodDatabillingDetails
}

/// Billing details for this new payment method. They do not replace the
/// Order customer's identity or the Order's shipping address.
///
structure CheckoutPaymentMethodDatabillingDetails with [CheckoutBillingDetails] {}

structure CheckoutPurchaseIntentLookupResponse {
    @required
    purchase_intent: PurchaseIntent
}

/// Creates an Order from a Purchase Intent and pays it with a newly supplied payment method.
@simileSchema(
{
        "additionalProperties": false,
        "allOf": [
            {
                "anyOf": [
                    {
                        "not": {
                            "properties": {
                                "save_payment_method": {
                                    "enum": [
                                        true
                                    ]
                                }
                            },
                            "required": [
                                "save_payment_method"
                            ]
                        }
                    },
                    {
                        "properties": {
                            "payment_method_data": {
                                "additionalProperties": true,
                                "properties": {
                                    "billing_details": {}
                                },
                                "required": [
                                    "billing_details"
                                ],
                                "type": "object"
                            }
                        }
                    }
                ]
            }
        ],
        "description": "Creates an Order from a Purchase Intent and pays it with a newly supplied payment method.",
        "properties": {
            "customer_data": {
                "shape": "CheckoutCustomerData"
            },
            "payment_method_data": {
                "allOf": [
                    {
                        "shape": "CheckoutPaymentMethodData"
                    }
                ],
                "description": "New payment method details supplied by the payer. Shipping details are not\naccepted here because checkout cannot change the resulting Order's shipping address.\n"
            },
            "purchase_intent_id": {
                "description": "Purchase Intent to turn into an Order and pay in this request.",
                "example": "sale_a1b2c3d4e5f6",
                "minLength": 1,
                "type": "string"
            },
            "quantity": {
                "description": "Quantity selected by the payer. Defaults to the Purchase Intent minimum.",
                "minimum": 1,
                "type": "integer"
            },
            "save_payment_method": {
                "default": false,
                "description": "Save the newly supplied payment method to the Order's customer.",
                "type": "boolean"
            },
            "selected_amount": {
                "allOf": [
                    {
                        "shape": "CheckoutSelectedAmount"
                    }
                ],
                "description": "Amount selected by the payer when the Purchase Intent accepts customer-selected pricing."
            },
            "variant_product_id": {
                "description": "Selected variant when the Purchase Intent offers product variants.",
                "minLength": 1,
                "type": "string"
            }
        },
        "required": [
            "purchase_intent_id",
            "customer_data",
            "payment_method_data"
        ],
        "title": "Purchase Intent payment",
        "type": "object"
    }
)
structure CheckoutPurchaseIntentPayRequest {
    /// Purchase Intent to turn into an Order and pay in this request.
    @dataExamples([
    {
        "json": "sale_a1b2c3d4e5f6"
    }
])
    @length(
        min: 1
    )
    @required
    purchase_intent_id: String
    /// Selected variant when the Purchase Intent offers product variants.
    @length(
        min: 1
    )
    variant_product_id: String
    /// Quantity selected by the payer. Defaults to the Purchase Intent minimum.
    @range(
        min: 1
    )
    quantity: Integer
    selected_amount: CheckoutPurchaseIntentPayRequestselectedAmount
    @required
    customer_data: CheckoutCustomerData
    @required
    payment_method_data: CheckoutPurchaseIntentPayRequestpaymentMethodData
    /// Save the newly supplied payment method to the Order's customer.
    save_payment_method: Boolean
}

/// New payment method details supplied by the payer. Shipping details are not
/// accepted here because checkout cannot change the resulting Order's shipping address.
///
structure CheckoutPurchaseIntentPayRequestpaymentMethodData with [CheckoutPaymentMethodData] {}

/// Amount selected by the payer when the Purchase Intent accepts customer-selected pricing.
structure CheckoutPurchaseIntentPayRequestselectedAmount with [CheckoutSelectedAmountMixin] {}

structure CheckoutPurchaseIntentSelectAmountRequest {
    /// Purchase Intent used to create a new Checkout Order.
    @dataExamples([
    {
        "json": "sale_a1b2c3d4e5f6"
    }
])
    @length(
        min: 1
    )
    @required
    purchase_intent_id: String
    @required
    selected_amount: CheckoutSelectedAmount
}

structure CheckoutSelectedAmount with [CheckoutSelectedAmountMixin] {}

@mixin
structure CheckoutSelectedAmountMixin {
    @required
    currency: Currency
    /// Payer-selected amount in the currency's smallest unit.
    @dataExamples([
    {
        "json": 5000
    }
])
    @range(
        min: 1
    )
    @required
    value: Integer
}

