    @required
    confirms_use: ChildrenPolicyPaymentMethodCapabilitiesconfirmsUse
}

structure ChildrenPolicyPaymentMethodsCapabilities {
    mobile_money: ChildrenPolicyPaymentMethodCapabilities
    bank_account: ChildrenPolicyPaymentMethodCapabilities
    motito: ChildrenPolicyPaymentMethodCapabilities
    card: ChildrenPolicyPaymentMethodCapabilities
}

structure ChildrenPolicyPaymentsCapabilities {
