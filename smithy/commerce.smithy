structure Order with [OrderMixin] {}

structure OrderAddress {
    name: String
    phone_number: String
    line1: String
    line2: String
    city: String
    region: String
    post_code: String
    @required
    country: String
}

/// Checkout and payment flow configuration for this order
structure OrdercheckoutSettings {
    /// URL to redirect the customer after payment completion
    redirect_url: String
    /// URL to redirect the customer after canceling checkout
    cancel_url: String
}

/// Attribution for the public resource that created this order, when available.
structure OrdercreatedFrom {
    source: String
    resource_type: OrdercreatedFromresourceType
    resource_id: String
}

structure Ordercustomer {
    @pattern("^cu_")
    @required
    id: String
    @required
    guest: Boolean
    @required
    name: String
    email_address: String
    phone_number: String
    billing_address: OrderAddress
    shipping_address: OrderAddress
}

structure OrderDiscount {}

structure OrderDiscountLineItem {
    @required
    discount: OrderDiscount
}

/// Delivery result for one hosted order document link.
@simileConstraints(
[
        {
            "distinct": {
                "source": "/deliveries/*/channel"
            }
        },
        {
            "distinct": {
                "source": "/failures/*/channel"
            }
        }
    ]
)
structure OrderDocumentDelivery with [OrderDocumentDeliveryMixin] {}

/// Chime delivery accepted for one channel.
structure OrderDocumentDeliveryAttempt {
    /// Authoritative time at which Chime accepted this channel delivery.
    @timestampFormat("date-time")
    accepted_at: Timestamp
    @required
    channel: OrderDocumentDeliveryAttemptchannel
    /// Chime ID created for this delivery.
    @dataExamples([
    {
        "json": "ch_7QYpB8c3V9kL2nM4"
    }
])
    @pattern("^ch_")
    chime_id: String
}

/// Bounded aggregate of Chime-accepted sends through one channel.
structure OrderDocumentDeliveryChannelSummary {
    /// Number of deliveries accepted through this channel.
    @range(
        min: 1
    )
    @required
    count: Long
    /// Latest authoritative Chime acceptance time for this channel.
    @required
    @timestampFormat("date-time")
    latest_sent_at: Timestamp
}

/// Failed order document delivery. Partial delivery and order details are included when available.
@mixin
structure OrderDocumentDeliveryErrorResponse {
    delivery: OrderDocumentDelivery
    @required
    error: Error
    order: Order
}

/// Chime delivery failure for one channel.
structure OrderDocumentDeliveryFailure {
    @required
    channel: OrderDocumentDeliveryFailurechannel
}

/// Delivery result for one hosted order document link.
@simileConstraints(
[
        {
            "distinct": {
                "source": "/deliveries/*/channel"
            }
        },
        {
            "distinct": {
                "source": "/failures/*/channel"
            }
        }
    ]
)
@mixin
structure OrderDocumentDeliveryMixin {
    deliveries: OrderDocumentDeliverydeliveries
    @required
    document_kind: OrderDocumentDeliverydocumentKind
    /// Hosted invoice or receipt URL sent to the customer. Receipt URLs use the hosted receipt path, not the invoice PDF path.
    @dataExamples([
    {
        "json": "https://pages.inttegro.com/invoices/or_48ZW7BGvYUBWc1i6WBkL2jr0iPQP5jUy76mmmHpt"
    }
])
    @required
    document_url: String
    failed_channels: OrderDocumentDeliveryfailedChannels
    failures: OrderDocumentDeliveryfailures
    @required
    sent_channels: OrderDocumentDeliverysentChannels
}

structure OrderDocumentDeliveryRequest {
    /// Order whose hosted invoice or receipt link should be delivered.
    @dataExamples([
    {
        "json": "or_48ZW7BGvYUBWc1i6WBkL2jr0iPQP5jUy76mmmHpt"
    }
])
    @pattern("^or_")
    @required
    order_id: String
}

/// Successful or partially successful deliberate order document delivery.
@mixin
structure OrderDocumentDeliveryResponse {
    @required
    delivery: OrderDocumentDelivery
    @required
    order: Order
}

/// Bounded aggregate of Chime-accepted sends for one generated order document.
structure OrderDocumentDeliverySummary {
    @required
    channels: OrderDocumentDeliverySummarychannels
    /// Latest authoritative Chime acceptance time across all channels.
    @required
    @timestampFormat("date-time")
    latest_sent_at: Timestamp
    /// Total channel deliveries accepted for this document.
    @range(
        min: 1
    )
    @required
    total_count: Long
}

/// Accepted send totals grouped by delivery channel. Channels with no accepted sends are omitted.
structure OrderDocumentDeliverySummarychannels {
    email: OrderDocumentDeliveryChannelSummary
    sms: OrderDocumentDeliveryChannelSummary
}

structure OrderDocumentFormat {
    @required
    url: String
}

/// Partial order-document delivery with at least one accepted and one failed channel.
@simileConstraints(
[
        {
            "set": {
                "left": "/failed_channels",
                "relation": "disjoint",
                "right": "/sent_channels"
            }
        },
        {
            "distinct": {
                "source": "/deliveries/*/channel"
            }
        },
        {
            "distinct": {
                "source": "/failures/*/channel"
            }
        }
    ]
)
@mixin
structure OrderDocumentPartialDelivery {
    @required
    deliveries: OrderDocumentPartialDeliverydeliveries
    @required
    document_kind: OrderDocumentPartialDeliverydocumentKind
    @required
    document_url: String
    @required
    failed_channels: OrderDocumentPartialDeliveryfailedChannels
    @required
    failures: OrderDocumentPartialDeliveryfailures
    @required
    sent_channels: OrderDocumentPartialDeliverysentChannels
}

/// Order operation error. The latest Order snapshot is included when available.
@mixin
structure OrderErrorResponse {
    @required
    error: Error
    order: Order
}

structure OrderFeeLineItem {
    @required
    fee: OrderFeeLineItemfee
}

structure OrderFeeLineItemfee {
    /// Immutable order-line identifier with the `oli_` prefix.
    @pattern("^oli_")
    @required
    id: String
    description: String
    tax_code: String
    @required
    amount: Amount
    @required
    label: String
}

structure Orderinvoice {
    delivery_summary: OrderDocumentDeliverySummary
    number: String
    @required
    format: Orderinvoiceformat
}

structure Orderinvoiceformat {
    @required
    web: OrderDocumentFormat
    @required
    pdf: OrderDocumentFormat
}

/// Persisted order-level invoice rendering data returned when at least one setting is present.
structure OrderInvoiceSettingsResponse {
    /// Optional invoice number.
    @dataExamples([
    {
        "json": "INV-1001"
    }
])
    number: String
    /// Optional invoice memo.
    @dataExamples([
    {
        "json": "Thanks for your order."
    }
])
    memo: String
    /// Optional invoice footer.
    @dataExamples([
    {
        "json": "Payment due within 7 days."
    }
])
    footer: String
    custom_data: CustomData
}

/// Cart contents and totals
structure OrderlineItemGroup {
    @required
    line_items: OrderlineItemGrouplineItems
    @required
    total: Amount
}

/// Complete order record with line items, customer details, payment state, and fulfillment information
@simileSchema(
{
        "additionalProperties": false,
        "description": "Complete order record with line items, customer details, payment state, and fulfillment information",
        "properties": {
            "canceled_at": {
                "description": "When the order was canceled. Omitted otherwise.",
                "format": "date-time",
                "type": "string"
            },
            "checkout_settings": {
                "additionalProperties": false,
                "description": "Checkout and payment flow configuration for this order",
                "properties": {
                    "cancel_url": {
                        "description": "URL to redirect the customer after canceling checkout",
                        "format": "uri",
                        "type": "string"
                    },
                    "redirect_url": {
                        "description": "URL to redirect the customer after payment completion",
                        "format": "uri",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "completed_at": {
                "description": "When the order was completed. Omitted otherwise.",
                "format": "date-time",
                "type": "string"
            },
            "created_from": {
                "additionalProperties": false,
                "description": "Attribution for the public resource that created this order, when available.",
                "minProperties": 1,
                "properties": {
                    "resource_id": {
                        "type": "string"
                    },
                    "resource_type": {
                        "enum": [
                            "purchase_intent"
                        ],
                        "type": "string"
                    },
                    "source": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "custom_data": {
                "shape": "NonEmptyCustomData"
            },
            "customer": {
                "additionalProperties": false,
                "properties": {
                    "billing_address": {
                        "shape": "OrderAddress"
                    },
                    "email_address": {
                        "format": "email",
                        "type": "string"
                    },
                    "guest": {
                        "type": "boolean"
                    },
                    "id": {
                        "pattern": "^cu_",
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "phone_number": {
                        "type": "string"
                    },
                    "shipping_address": {
                        "shape": "OrderAddress"
                    }
                },
                "required": [
                    "guest",
                    "id",
                    "name"
                ],
                "type": "object"
            },
            "expires_at": {
                "description": "When the order expires. Omitted when no expiry is set.",
                "format": "date-time",
                "type": "string"
            },
            "id": {
                "description": "Unique identifier for this order",
                "example": "or_48ZW7BGvYUBWc1i6WBkL2jr0iPQP5jUy76mmmHpt",
                "pattern": "^or_",
                "type": "string"
            },
            "initiated_at": {
                "description": "When order processing began",
                "format": "date-time",
                "type": "string"
            },
            "invoice": {
