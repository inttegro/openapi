/// Standard error response structure returned by all API endpoints.
/// Provides machine-readable codes, human-readable messages, and actionable guidance for resolution.
///
structure Error with [ErrorMixin] {}

/// Stable category describing the reason for failure, such as invalid input, an unmet precondition, or a state conflict.
structure ErrorcauseSchema {}

/// Unique machine-readable identifier for this specific error condition. Unlike type and cause which group errors, code pinpoints the exact problem.
structure ErrorcodeSchema {}

@mixin
structure ErrorEnvelope {
    @required
    error: Error
}

/// Machine-readable suggestion for how to resolve the error (e.g., "retry_with_exponential_backoff", "change_request_parameters").
structure ErrorfixCodeSchema {}

/// Standard error response structure returned by all API endpoints.
/// Provides machine-readable codes, human-readable messages, and actionable guidance for resolution.
///
@mixin
structure ErrorMixin {
    /// Concise, caller-safe explanation of why the request was rejected or could not finish.
    @dataExamples([
    {
        "json": "payment method could not be used for this order"
    }
])
    message: String
    fix_code: ErrorfixCodeSchema
    /// Explanation of the relevant rule and next safe action. It never contains raw dependency, storage, or implementation errors.
    @dataExamples([
    {
        "json": "the specified payment method could not be used for this order. verify that it belongs to the order customer and is active."
    }
])
    detail: String
    cause: ErrorcauseSchema
    @required
    type: ErrortypeSchema
    @required
    code: ErrorcodeSchema
    @required
    url: Errorurl
}

/// Broad error category to help clients determine retry strategies (e.g., "invalid_request_parameter", "transient_error").
structure ErrortypeSchema {}

/// Link to error reference documentation with detailed explanation, common causes, and resolution guidance.
structure Errorurl {}

