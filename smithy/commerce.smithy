@simileConstraints(
[
        {
            "equal": {
                "paths": [
                    "/amount/currency",
                    "/available_amount/currency",
                    "/pending_amount/currency",
                    "/spent_amount/currency"
                ]
            }
        },
        {
            "equation": {
                "target": "/amount/value",
                "value": {
                    "add": [
                        {
                            "path": "/available_amount/value"
                        },
                        {
                            "path": "/pending_amount/value"
                        },
                        {
                            "path": "/spent_amount/value"
                        }
                    ]
                }
            }
        }
    ]
)
structure PaymentBalanceTransaction {
    @required
    allocations: PaymentBalanceTransactionallocations
    @required
    amount: BalanceTransactionAmount
    @required
    available_amount: PaymentBalanceTransactionavailableAmount
    @timestampFormat("date-time")
    available_at: Timestamp
    /// Legacy whole-transaction payout claim timestamp. New integrations should inspect `allocations`.
    @timestampFormat("date-time")
    claimed_at: Timestamp
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @dataExamples([
    {
        "json": "bt_0123456789abcdefghijklmnopqrstuvwxyzABCD"
    }
])
    @pattern("^bt_")
    @required
    id: String
    @dataExamples([
    {
        "json": "or_0123456789abcdefghijklmnopqrstuvwxyzABCD"
    }
])
    @pattern("^or_")
    @required
    order_id: String
    /// Legacy whole-transaction payout completion timestamp. New integrations should inspect `allocations`.
    @timestampFormat("date-time")
    paid_at: Timestamp
    @dataExamples([
    {
        "json": "py_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmn"
    }
])
    @pattern("^py_")
    @required
    payment_id: String
    /// Legacy payout owning the whole transaction remainder. New integrations should inspect `allocations`.
    @dataExamples([
    {
        "json": "po_zyxwvutsrqponmlkjihgfedcbaABCDEFGHIJKLMN"
    }
])
    @pattern("^po_")
    payout_id: String
    payout_configuration: PaymentBalanceTransactionpayoutConfiguration
    @required
    pending_amount: PaymentBalanceTransactionpendingAmount
    @required
    spent_amount: PaymentBalanceTransactionspentAmount
}

/// Amount still available for a refund or payout.
structure PaymentBalanceTransactionavailableAmount with [BalanceTransactionAmountMixin] {}

structure PaymentBalanceTransactionpayoutConfiguration {
    @required
    enable_fx: Boolean
    @required
    destination: PaymentBalanceTransactionpayoutConfigurationdestination
}

structure PaymentBalanceTransactionpayoutConfigurationdestination {
    @pattern("^fa_")
    @required
    financial_account_id: String
}

/// Amount temporarily unavailable because a refund or payout is unresolved.
structure PaymentBalanceTransactionpendingAmount with [BalanceTransactionAmountMixin] {}

/// Amount permanently consumed by completed refund and payout allocations.
structure PaymentBalanceTransactionspentAmount with [BalanceTransactionAmountMixin] {}

