structure UpdatePurchaseIntentRequest with [UpdatePurchaseIntentRequestFields] {}

@simileSchema(
{
        "additionalProperties": false,
        "properties": {
            "expires_at": {
                "description": "RFC3339 expiry timestamp, including a past time for immediate expiry, or null to clear expiry",
                "format": "date-time",
                "type": [
                    "string",
                    "null"
                ]
            },
            "id": {
                "description": "Purchase intent ID to update. Send this or purchase_intent_id.",
                "example": "sale_ABCXYZ",
                "minLength": 1,
                "pattern": "^sale_",
                "type": "string"
            },
            "presentation": {
                "shape": "UpdatePurchaseIntentPresentation"
            },
            "purchase_intent_id": {
                "description": "Alias for id. If both are present, this value takes precedence.",
                "example": "sale_ABCXYZ",
                "minLength": 1,
                "pattern": "^sale_",
                "type": "string"
            },
            "quantity": {
                "additionalProperties": false,
                "description": "Replacement quantity bounds. Omit the object to preserve the current bounds. Within the object, min is required and omitting max removes the upper bound. When present, max must be greater than or equal to min.",
                "properties": {
                    "max": {
                        "description": "Optional maximum quantity the customer can buy. It must be greater than or equal to min.",
                        "example": 3,
                        "minimum": 1,
                        "type": "integer"
                    },
                    "min": {
                        "description": "Minimum quantity the customer can buy",
                        "example": 1,
                        "minimum": 1,
                        "type": "integer"
                    }
                },
                "required": [
                    "min"
                ],
                "simileConstraints": [
                    {
                        "bounded": {
                            "minimum": {
                                "path": "/min"
                            },
                            "path": "/max"
                        }
                    }
                ],
                "type": "object"
            },
            "reactivate": {
                "description": "Clears the state that prevents new purchases. For canceled\nBuy links this removes inactive_at. For expired Buy links this\nclears an existing elapsed expires_at value. It does not remove\nthe order claim from a used single-use intent.\n",
                "example": true,
                "type": "boolean"
            }
        },
        "type": "object"
    }
)
@mixin
structure UpdatePurchaseIntentRequestFields {
    /// RFC3339 expiry timestamp, including a past time for immediate expiry, or null to clear expiry
    @timestampFormat("date-time")
    expires_at: Timestamp
    /// Purchase intent ID to update. Send this or purchase_intent_id.
    @dataExamples([
    {
        "json": "sale_ABCXYZ"
    }
])
    @length(
        min: 1
    )
    @pattern("^sale_")
    id: String
    quantity: UpdatePurchaseIntentRequestFieldsquantity
    /// Alias for id. If both are present, this value takes precedence.
    @dataExamples([
    {
        "json": "sale_ABCXYZ"
    }
])
    @length(
        min: 1
    )
    @pattern("^sale_")
    purchase_intent_id: String
    /// Clears the state that prevents new purchases. For canceled
    /// Buy links this removes inactive_at. For expired Buy links this
    /// clears an existing elapsed expires_at value. It does not remove
    /// the order claim from a used single-use intent.
    ///
    @dataExamples([
    {
        "json": true
    }
])
    reactivate: Boolean
    presentation: UpdatePurchaseIntentPresentation
}

/// Replacement quantity bounds. Omit the object to preserve the current bounds. Within the object, min is required and omitting max removes the upper bound. When present, max must be greater than or equal to min.
@simileConstraints(
[
        {
            "bounded": {
                "minimum": {
                    "path": "/min"
                },
                "path": "/max"
            }
        }
    ]
)
structure UpdatePurchaseIntentRequestFieldsquantity {
    /// Minimum quantity the customer can buy
    @dataExamples([
    {
        "json": 1
    }
])
    @range(
        min: 1
    )
    @required
    min: Integer
    /// Optional maximum quantity the customer can buy. It must be greater than or equal to min.
    @dataExamples([
    {
        "json": 3
    }
])
    @range(
        min: 1
    )
    max: Integer
}

