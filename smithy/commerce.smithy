                "then": {
                    "all": [
                        {
                            "path": "/succeeded_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failure",
                            "state": "non-null"
                        },
                        {
                            "path": "/cancellation",
                            "state": "absent"
                        },
                        {
                            "path": "/error",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "equals": "failed",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/succeeded_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/failure",
                            "state": "absent"
                        },
                        {
                            "path": "/cancellation",
                            "state": "non-null"
                        },
                        {
                            "path": "/error",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "canceled",
                    "path": "/status"
                }
            }
        },
        {
            "equal": {
                "paths": [
                    "/max_amount/currency",
                    "/amount/currency",
                    "/balance_transactions/*/amount/currency",
                    "/balance_transactions/*/allocated_amount/currency"
                ]
            }
        },
        {
            "bounded": {
                "maximum": {
                    "path": "/max_amount/value"
                },
                "path": "/amount/value"
            }
        },
        {
            "aggregate": {
                "operation": "sum",
                "source": "/balance_transactions/*/allocated_amount/value",
                "target": "/amount/value",
                "when": {
                    "path": "/amount",
                    "state": "non-null"
                }
            }
        }
    ]
)
structure Payout with [PayoutMixin] {}

structure Payoutamount with [AmountMixin] {}

/// Inclusive payout amount range. Values use the currency's smallest unit.
@simileConstraints(
[
        {
            "bounded": {
                "maximum": {
                    "path": "/max/value"
                },
                "path": "/min/value"
            }
        }
    ]
)
structure PayoutAmountLimits {
    @required
    min: PayoutLimitValue
    @required
    max: PayoutLimitValue
}

/// A historical view of one balance transaction's contribution to a payout. Released contributions remain present so clients can inspect the payout's original composition.
@simileConstraints(
[
        {
            "equal": {
                "paths": [
                    "/allocated_amount/currency",
                    "/amount/currency"
                ]
            }
        },
        {
            "bounded": {
                "maximum": {
                    "path": "/amount/value"
                },
                "path": "/allocated_amount/value"
            }
        }
    ]
)
structure PayoutBalanceTransaction {
    @required
    allocated_amount: PayoutBalanceTransactionallocatedAmount
    @required
    amount: PayoutBalanceTransactionamount
    /// Unique balance transaction identifier.
    @dataExamples([
    {
        "json": "bt_1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZabcd"
    }
])
    @pattern("^bt_")
    @required
    id: String
    @required
    status: PayoutBalanceTransactionstatus
}

structure PayoutBalanceTransactionallocatedAmount with [AmountMixin] {}

structure PayoutBalanceTransactionamount with [AmountMixin] {}

/// Stable, caller-safe information and guidance for a canceled payout.
@mixin
structure PayoutCancellation {
    /// Human-readable explanation safe to show to an operator.
    @required
    detail: String
    @required
    reason: PayoutCancellationreason
    /// Recommended next step safe to show to an operator.
    @required
    remediation: String
}

/// Caller-safe explanation and next step for a canceled payout. Present only when `status` is `canceled`.
structure PayoutcancellationSchema with [PayoutCancellation] {}

/// Immutable debit created once a payout succeeds.
structure PayoutDebitBalanceTransaction {
    @required
    amount: BalanceTransactionAmount
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @dataExamples([
    {
        "json": "bt_0123456789abcdefghijklmnopqrstuvwxyzABCD"
    }
])
    @pattern("^bt_")
    @required
    id: String
    /// Payout that created this finalized debit.
    @dataExamples([
    {
        "json": "po_zyxwvutsrqponmlkjihgfedcbaABCDEFGHIJKLMN"
    }
])
    @pattern("^po_")
    @required
    payout_id: String
}

/// Supported currency-to-financial-account destination assignments.
structure PayoutDestinations {
    /// Financial account that receives Ghana cedi payouts. Send an empty string to remove the assignment.
    @dataExamples([
    {
        "json": "fa_1234567890abcdef"
    }
])
    ghs: String
}

/// Deprecated compatibility projection of `PayoutFailure`.
@mixin
structure PayoutError {
    /// Public explanation of the underlying failure cause.
    @required
    cause: String
    /// Human-readable failure message.
    @required
    message: String
    /// When the failure occurred.
    @required
    @timestampFormat("date-time")
    occurred_at: Timestamp
    /// Stable machine-readable failure category.
    @required
    type: String
}

/// Deprecated compatibility projection of `failure`. New integrations should use `failure`.
structure PayouterrorSchema with [PayoutError] {}

/// Stable, caller-safe information about a terminal payout failure.
@mixin
structure PayoutFailure {
    /// Human-readable explanation safe to show to an operator.
    @required
    detail: String
    @required
    reason: PayoutFailurereason
    /// Whether creating a new payout attempt may succeed without changing the destination or request.
    @required
    retryable: Boolean
}

/// Caller-safe failure information. Present only when `status` is `failed`.
structure PayoutfailureSchema with [PayoutFailure] {}

/// A payout limit in the currency's smallest unit. The enclosing map key identifies the currency.
structure PayoutLimitValue {
    @range(
        min: 1
    )
    @required
    value: Long
}

structure PayoutmaxAmount with [AmountMixin] {}

