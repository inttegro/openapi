structure ChimeSavedCustomerRecipient {
    @dataExamples([
    {
        "json": "cu_abc123def456"
    }
])
    @required
    customer_id: String
    @required
    transport: ChimeSavedCustomerRecipienttransport
}

structure ChimeSettings {
    @required
    sms: ChimeSMSSettings
    @required
    email: ChimeEmailSettings
}

structure ChimeSettingsResponse {
    @required
    settings: ChimeSettings
}

@simileConstraints(
[
        {
            "bounded": {
                "maximum": {
                    "path": "/max_sender_char_len"
                },
                "path": "/min_sender_char_len"
            }
        }
    ]
)
structure ChimeSMSSettings {
    /// Platform fallback sender ID for SMS delivery.
    @required
    default_sender: String
    @range(
        min: 0
    )
    @required
    min_sender_char_len: Integer
    @range(
        min: 0
    )
    @required
    max_sender_char_len: Integer
}

/// Public delivery lifecycle for a Chime.
@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/initialized_at",
                    "/sent_at",
                    "/delivered_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/initialized_at",
                    "/sent_at",
                    "/failed_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/sent_at",
                            "state": "absent"
                        },
                        {
                            "path": "/delivered_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "initialized",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/sent_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/delivered_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "sent",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/delivered_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "delivered",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/delivered_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "equals": "failed",
                    "path": "/status"
                }
            }
        }
    ]
)
structure ChimeTransmission {
    @required
    address: String
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @timestampFormat("date-time")
    delivered_at: Timestamp
    @timestampFormat("date-time")
    failed_at: Timestamp
    @required
    @timestampFormat("date-time")
    initialized_at: Timestamp
    @required
    mechanism: ChimeTransmissionmechanism
    @timestampFormat("date-time")
    sent_at: Timestamp
    sent_via: ChimeTransmissionsentVia
    @required
    status: String
    @timestampFormat("date-time")
    suppressed_at: Timestamp
}

structure CompleteOrderRequest {
    /// Unique identifier of the order to complete
    @dataExamples([
    {
        "json": "or_48ZW7BGvYUBWc1i6WBkL2jr0iPQP5jUy76mmmHpt"
    }
])
    @pattern("^or_")
    @required
    order_id: String
    /// Set to true if payment was received outside Inttegro
    /// (e.g., cash, bank transfer, check). When true, the associated payment
    /// will be marked as paid offline before completing the order.
    ///
    @dataExamples([
    {
        "json": false
    }
])
    paid_out_of_band: Boolean
}

@dataExamples([
    {
        "json": {
            "order": {
                "completed_at": "2025-01-25T11:00:00Z",
                "customer": {
                    "guest": false,
                    "id": "cu_abc123def456",
                    "name": "Akua Mensah"
                },
                "expires_at": "2025-02-01T10:25:00Z",
                "id": "or_48ZW7BGvYUBWc1i6WBkL2jr0iPQP5jUy76mmmHpt",
                "initiated_at": "2025-01-25T10:25:00Z",
                "number": "ORDER-12345",
                "sealed_at": "2025-01-25T10:30:00Z",
                "status": "completed"
            }
        }
    }
])
structure CompleteOrderResponse {
    @required
    order: Order
}

structure ConfirmPaymentRequest {
    /// Unique identifier of the order
    @dataExamples([
    {
        "json": "or_JoPtqOmsjgZKwkPvqTrqGsopu07wfC7ttoWqmfwt"
    }
])
    @pattern("^or_")
    @required
    order_id: String
    /// Unique identifier of the payment being confirmed
    @dataExamples([
    {
        "json": "py_123"
    }
])
    @pattern("^py_")
    @required
    payment_id: String
    /// Unique identifier of the confirmation challenge
    @dataExamples([
    {
        "json": "conf_123"
    }
])
    @required
    confirmation_id: String
    /// Verification token (OTP) sent to customer
    @dataExamples([
    {
        "json": "302673"
    }
])
    @required
    token: String
}

structure ConnectFinancialAccountResponse {
    @required
    account: FinancialAccountConnectedResponse
}

/// A banking institution available in a country
structure CountryBank {
    /// Stable bank identifier
    @dataExamples([
    {
        "json": "absa_gh_ltd"
    }
])
    @required
    id: String
    /// Bank display name
    @dataExamples([
    {
        "json": "ABSA (GH) LTD"
    }
])
    @required
    name: String
    /// SWIFT/BIC code for the bank, when available
    @dataExamples([
    {
        "json": "BARCGHAC"
    }
])
    swift_code: String
    /// Ghana sort code prefix for the bank
    @dataExamples([
    {
        "json": "03"
    }
])
    sort_code_prefix: String
    @required
    branches: CountryBankbranches
}

/// A bank branch in a country bank directory
structure CountryBankBranch {
    /// Stable branch identifier
    @dataExamples([
    {
        "json": "absa_gh_ltd_kasoa_branch"
    }
])
    @required
    id: String
    /// Branch display name
    @dataExamples([
    {
        "json": "ABSA (GH) LTD-KASOA BRANCH"
    }
])
    @required
    name: String
    /// Ghana bank branch sort code
    @dataExamples([
    {
        "json": "030101"
    }
])
    @required
    sort_code: String
}

/// Bank reference data available for country-specific bank accounts
structure CountryBankDirectory {
    /// Country-specific bank account subtype used by financial account APIs
    @dataExamples([
    {
        "json": "ghana_bank_account"
    }
])
    @required
    bank_account_type: String
    /// Identifier scheme used for bank branch codes
    @dataExamples([
    {
        "json": "sort_code"
    }
])
    @required
    code_scheme: String
    @required
    items: CountryBankDirectoryitems
}

/// Complete specification for a country including supported features and requirements
structure CountrySpecification {
    /// ISO 3166-1 alpha-2 country code
    @dataExamples([
    {
        "json": "gh"
    }
])
    @required
    country_code: String
    /// Full country name
    @dataExamples([
    {
        "json": "Ghana"
    }
])
    @required
    country_name: String
    @required
    currencies: CountrySpecificationcurrencies
    @required
    payment_methods: CountrySpecificationpaymentMethods
    @required
    payout_schedules: CountrySpecificationpayoutSchedules
    @required
    bt_aging_specs: CountrySpecificationbtAgingSpecs
    @required
    legal_entity_types: CountrySpecificationlegalEntityTypes
    @required
    financial_account_types: CountrySpecificationfinancialAccountTypes
    @required
    id_document_types: CountrySpecificationidDocumentTypes
    banks: CountryBankDirectory
}

structure CreateApplicationRequest {
    /// Display name for the application.
    @required
    name: String
    /// Optional short name for the application.
    alias: String
    /// Optional application description.
    description: String
    /// Caller-defined legal-entity label. Common values are `government`, `non_profit`, `business`, and `individual`.
    legal_entity_type: String
    /// Optional application under which the new app should be placed.
    placement_parent_application_id: String
    operating_policy: CreateApplicationRequestoperatingPolicy
    relationship_policy: CreateApplicationRequestrelationshipPolicy
}

@availability(
"private-beta"
)
structure CreateApplicationRequestoperatingPolicy {}

/// Optional direct-placement relationship policy. Omitted values default to parent management and child credentials.
structure CreateApplicationRequestrelationshipPolicy {
    /// Initial standing assigned to the child in this relationship.
    child_standing: String
    management: CreateApplicationRequestrelationshipPolicymanagement
    credentials: CreateApplicationRequestrelationshipPolicycredentials
}

structure CreateApplicationResponse {
    @required
    app: CreateApplicationResponseapp
}

structure CreateApplicationResponseapp {
    @pattern("^app_")
    @required
    id: String
    @required
    name: String
    alias: String
    description: String
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @required
    capabilities: ApplicationCapabilityProjection
    children_policy: CreateApplicationResponseappchildrenPolicy
    operating_policy: CreateApplicationResponseappoperatingPolicy
    secret_key: CreateApplicationResponseappsecretKey
    relationship: CreateApplicationResponseapprelationship
}

/// Active children policy assigned to the application. Omitted when the private beta is unavailable to the caller.
@availability(
"private-beta"
)
structure CreateApplicationResponseappchildrenPolicy with [ChildrenPolicyMixin] {}

/// Immutable operating policy applied to the application. Omitted for root applications and when the private beta is unavailable to the caller.
@availability(
"private-beta"
)
structure CreateApplicationResponseappoperatingPolicy with [ApplicationOperatingPolicy] {}

/// Identifies the created app's direct placement relationship.
structure CreateApplicationResponseapprelationship {
    @pattern("^apprel_")
    @required
    id: String
    @required
    kind: CreateApplicationResponseapprelationshipkind
    @required
    parent: CreateApplicationResponseapprelationshipparent
    @required
    status: CreateApplicationResponseapprelationshipstatus
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
}

/// Application that directly contains the created app.
structure CreateApplicationResponseapprelationshipparent {
    @pattern("^app_")
    @required
    id: String
    @required
    name: String
    alias: String
}

structure CreateApplicationResponseappsecretKey {
    @pattern("^sk_")
    id: String
    token_type: String
    @timestampFormat("date-time")
    issued_at: Timestamp
    token: String
}

