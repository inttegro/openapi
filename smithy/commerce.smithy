@mixin
structure PayoutMixin {
    amount: Payoutamount
    balance_transactions: PayoutbalanceTransactions
    /// Immutable debit balance transaction created when this payout succeeds.
    @dataExamples([
    {
        "json": "bt_1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZabcd"
    }
])
    @pattern("^bt_")
    balance_transaction_id: String
    /// When the payout was canceled
    @timestampFormat("date-time")
    canceled_at: Timestamp
    cancellation: PayoutcancellationSchema
    custom_data: CustomData
    /// Financial account receiving the funds
    @dataExamples([
    {
        "json": "fa_1234567890abcdef"
    }
])
    @pattern("^fa_")
    @required
    destination_id: String
    error: PayouterrorSchema
    /// Earliest moment payout execution may begin
    @dataExamples([
    {
        "json": "2026-08-05T09:00Z"
    }
])
    @required
    @timestampFormat("date-time")
    execute_after: Timestamp
    /// Actor that executed the payout
    executed_by: String
    /// Expected completion time
    @timestampFormat("date-time")
    expected_at: Timestamp
    /// When the payout entered the `failed` state.
    @timestampFormat("date-time")
    failed_at: Timestamp
    failure: PayoutfailureSchema
    /// Unique payout identifier
    @dataExamples([
    {
        "json": "po_yQ2wXm5Dc7Pk9Ls1Vn0RgHaB"
    }
])
    @pattern("^po_")
    @required
    id: String
    /// When the payout was created
    @required
    @timestampFormat("date-time")
    initiated_at: Timestamp
    /// Actor that initiated the payout
    initiated_by: String
    @required
    max_amount: PayoutmaxAmount
    /// Merchant reference carried on the payout
    @dataExamples([
    {
        "json": "PAYOUT-APR-15"
    }
])
    reference: String
    /// Schedule associated with the payout
    @pattern("^posc_")
    schedule_id: String
    /// When the payout was scheduled
    @timestampFormat("date-time")
    scheduled_at: Timestamp
    /// Actor that scheduled the payout
    scheduled_by: String
    /// When the transfer was sent
    @timestampFormat("date-time")
    sent_at: Timestamp
    /// Source identifier associated with the payout
    source_id: String
    @required
    status: Payoutstatus
    /// When the payout succeeded
    @timestampFormat("date-time")
    succeeded_at: Timestamp
}

/// A page of payouts ordered from newest to oldest.
structure PayoutPage {
    /// Page number returned.
    @required
    number: Integer
    /// Number of payouts returned.
    @required
    size: Integer
    payouts: PayoutPagepayouts
}

/// Response envelope containing a page of payouts.
structure PayoutPageResponse {
    @required
    page: PayoutPage
}

/// Response envelope containing a payout.
structure PayoutResponse with [PayoutResponseMixin] {}

/// Response envelope containing a payout.
@mixin
structure PayoutResponseMixin {
    @required
    payout: Payout
}

structure PayoutSearchResponse {
    @required
    search: PayoutSearchResponsesearch
}

structure PayoutSearchResponsesearch with [ResourceSearchPageMixin] {}

structure PayoutSearchResponsesearchallOf1resourceTotalsItem with [ResourceSearchResourceTotalMixin] {}

structure PayoutSearchResponsesearchallOf1resultsItem with [ResourceSearchResultMixin] {}

structure PayoutSearchResponsesearchallOf1resultsItemallOf1resource with [ResourceSearchResourceReferenceMixin] {}

/// Platform limits applied to payouts.
structure PayoutSettingsLimits {
    @required
    amount: PayoutSettingsLimitsamount
}

/// Complete payout settings read model
structure PayoutSettingsLookup {
    @required
    destinations: PayoutDestinations
    /// Present only when foreign exchange is enabled in stored settings
    fx_enabled: Boolean
    @required
    limits: PayoutSettingsLimits
    schedule: PayoutSettingsLookupSchedule
}

/// Response envelope containing complete payout settings.
structure PayoutSettingsLookupResponse {
    @required
    settings: PayoutSettingsLookup
}

/// Active payout schedule returned when settings are retrieved.
structure PayoutSettingsLookupSchedule {
    @required
    aging_spec: PayoutSettingsLookupScheduleAgingSpec
    @required
    description: String
    @required
    interval: String
    @required
    name: String
    @required
    schedule_on: String
    @required
    type: String
}

/// Rules that determine when balance transactions become eligible for payout.
structure PayoutSettingsLookupScheduleAgingSpec {
    /// How strictly the aging period is applied.
    @required
    abide: String
    /// Public identifier for the balance transaction aging specification.
    @dataExamples([
    {
        "json": "bt_aging_spec_168_hourly"
    }
])
    @pattern("^bt_aging_spec_")
    @required
    public_id: String
    /// Human-readable aging rule label.
    @required
    label: String
    /// Required transaction age.
    @dataExamples([
    {
        "json": "168h"
    }
])
    @required
    t_plus: String
}

/// Payout settings fields returned after a mutation
structure PayoutSettingsMutation {
    destinations: PayoutDestinations
    /// Updated foreign-exchange setting, returned by FX mutations.
    fx_enabled: Boolean
    /// Payout settings identifier
    id: String
    @required
    limits: PayoutSettingsLimits
    schedule: PayoutSettingsMutationSchedule
}

/// Response envelope containing updated payout settings.
structure PayoutSettingsMutationResponse with [PayoutSettingsMutationResponseMixin] {}

/// Response envelope containing updated payout settings.
@mixin
structure PayoutSettingsMutationResponseMixin {
    @required
    settings: PayoutSettingsMutation
}

/// Updated payout schedule returned after a settings mutation.
structure PayoutSettingsMutationSchedule {
    @required
    description: String
    @required
    id: String
    @required
    interval: String
    @required
    name: String
    @required
    schedule_on: String
    @required
    spec: PayoutSettingsMutationScheduleSpec
    @required
    type: String
}

/// Public payout schedule specification returned after a settings mutation.
structure PayoutSettingsMutationScheduleSpec {
    @required
    abide: String
    /// Public identifier for the balance transaction aging specification.
    @dataExamples([
    {
        "json": "bt_aging_spec_168_hourly"
    }
])
    @pattern("^bt_aging_spec_")
    @required
    public_id: String
    @required
    label: String
    @dataExamples([
    {
        "json": "168h"
    }
])
    @required
    t_plus: String
}

structure PendingReviewApplicationCapability {
    @required
    status: PendingReviewApplicationCapabilitystatus
    @required
    status_reason: PendingReviewApplicationCapabilitystatusReason
    @required
    @timestampFormat("date-time")
    status_changed_at: Timestamp
}

@simileConstraints(
[
        {
            "bounded": {
                "maximum": {
                    "path": "/max"
                },
                "path": "/min"
            }
        }
    ]
)
structure PolicyAmountRange {
    /// Inclusive minimum amount in minor currency units.
    @range(
        min: 0
    )
    @required
    min: Long
    /// Inclusive maximum amount in minor currency units.
    @range(
        min: 1
    )
    @required
    max: Long
}

structure PolicyBTAgingSpec {
    @required
    id: PolicyBTAgingSpecid
    /// Platform-owned whole-hour aging duration.
    @pattern("^(0|[1-9][0-9]*)h$")
    @required
    t_plus: String
}

structure PolicyBTAgingSpecReference {
    @required
    id: PolicyBTAgingSpecReferenceid
}

structure PolicyLimits {
    @required
    amount: PolicyAmountRange
}

/// An inline price returned by the API.
structure Price with [AmountMixin] {}

structure PriceActionRequest {
    /// Price ID to perform the action on
    @dataExamples([
    {
        "json": "pr_xyz789"
    }
])
    @pattern("^pr_")
    @required
    price_id: String
}

