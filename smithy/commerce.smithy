/// A notification sent to one recipient
structure Chime {
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    custom_data: CustomData
    @pattern("^cu_")
    customer_id: String
    email: ChimeEmailMessage
    /// Rendered SMS content. Empty for email Chimes.
    @required
    full_message: String
    @pattern("^ch_")
    @required
    id: String
    idempotency_key: String
    purpose: String
    @required
    recipient: ChimeRecipientResponse
    @required
    sender_id: String
    transmission: ChimeTransmission
}

structure ChimeEmailMailbox {
    /// Optional display name
    @dataExamples([
    {
        "json": "Acme"
    }
])
    name: String
    /// Email address
    @dataExamples([
    {
        "json": "notifications@inttegro.com"
    }
])
    address: String
}

/// Email content, safety scan result, and system-generated schema markup for email chimes.
@simileSchema(
{
        "additionalProperties": false,
        "description": "Email content, safety scan result, and system-generated schema markup for email chimes.",
        "properties": {
            "from": {
                "shape": "ChimeEmailMailbox"
            },
            "headers": {
                "shape": "MessageHeaders"
            },
            "html": {
                "description": "Optional HTML email body before provider-specific rendering",
                "type": [
                    "string",
                    "null"
                ]
            },
            "reply_to": {
                "shape": "ChimeEmailMailbox"
            },
            "safety": {
                "shape": "ChimeEmailSafetyResult"
            },
            "schema": {
                "shape": "ChimeEmailSchemaMarkup"
            },
            "subject": {
                "description": "Email subject",
                "example": "Your receipt",
                "type": "string"
            },
            "text": {
                "description": "Plain-text email body",
                "example": "Your receipt is ready.",
                "type": "string"
            }
        },
        "type": "object"
    }
)
structure ChimeEmailMessage {
    /// Email subject
    @dataExamples([
    {
        "json": "Your receipt"
    }
])
    subject: String
    /// Plain-text email body
    @dataExamples([
    {
        "json": "Your receipt is ready."
    }
])
    text: String
    /// Optional HTML email body before provider-specific rendering
    html: String
    from: ChimeEmailMailbox
    reply_to: ChimeEmailMailbox
    headers: MessageHeaders
    safety: ChimeEmailSafetyResult
    schema: ChimeEmailSchemaMarkup
}

/// Email content accepted for email chimes, broadcasts, and schedules.
structure ChimeEmailMessageInput {
    /// Email subject.
    @dataExamples([
    {
        "json": "Your receipt"
    }
])
    @required
    subject: String
    /// Plain-text email body.
    @dataExamples([
    {
        "json": "Your receipt is ready."
    }
])
    @required
    text: String
    /// Optional HTML email body. Unsafe HTML is rejected or sanitized before delivery.
    html: String
    @required
    from: ChimeEmailMailbox
    /// Optional reply-to email address.
    @dataExamples([
    {
        "json": "support@example.com"
    }
])
    reply_to: String
    headers: MessageHeaders
}

structure ChimeEmailRecipient {
    @required
    email: ChimeEmailRecipientemail
    name: String
    @required
    type: ChimeEmailRecipienttype
}

structure ChimeEmailRecipientemail {
    @dataExamples([
    {
        "json": "user@example.com"
    }
])
    @required
    address: String
}

/// Result of the email safety scan
@simileSchema(
{
        "additionalProperties": false,
        "description": "Result of the email safety scan",
        "properties": {
            "content_hash": {
                "description": "Hash of the scanned email content",
                "type": "string"
            },
            "links": {
                "items": {
                    "shape": "ChimeEmailScannedLink"
                },
                "type": "array"
            },
            "normalized_text": {
                "description": "Normalized plain-text body used by the scanner",
                "type": "string"
            },
            "quarantine_notes": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "reason_codes": {
                "description": "Machine-readable reasons for non-allowed results",
                "items": {
                    "type": "string"
                },
                "type": "array"
            },
            "sanitized_html": {
                "description": "Sanitized HTML body used for provider send when present",
                "type": [
                    "string",
                    "null"
                ]
            },
            "scanner": {
                "description": "Safety scanner identifier",
                "example": "content-safety",
                "type": "string"
            },
            "status": {
                "description": "Safety decision for the email content",
                "enum": [
                    "allowed",
                    "rejected",
                    "quarantined"
                ],
                "type": "string"
            }
        },
        "type": "object"
    }
)
structure ChimeEmailSafetyResult {
    status: ChimeEmailSafetyResultstatus
    reason_codes: ChimeEmailSafetyResultreasonCodes
    /// Sanitized HTML body used for provider send when present
    sanitized_html: String
    /// Normalized plain-text body used by the scanner
    normalized_text: String
    links: ChimeEmailSafetyResultlinks
    /// Safety scanner identifier
    @dataExamples([
    {
        "json": "content-safety"
    }
])
    scanner: String
    /// Hash of the scanned email content
    content_hash: String
    quarantine_notes: String
}

structure ChimeEmailScannedLink {
    raw: String
    scheme: String
    host: String
    status: ChimeEmailScannedLinkstatus
    reason: String
}

/// Schema.org JSON-LD markup generated at email send time.
structure ChimeEmailSchemaMarkup {
    kind: ChimeEmailSchemaMarkupkind
    json_ld: JSONData
}

structure ChimeEmailSettings {
    /// Platform fallback From address for email delivery.
    @required
    default_from: String
    @required
    allowed_from: ChimeEmailSettingsallowedFrom
}

structure ChimePhoneRecipient {
    name: String
    @required
    phone: ChimePhoneRecipientphone
