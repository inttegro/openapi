            "line_items"
        ],
        "type": "object"
    }
)
structure CreateOrderExistingCustomer {
    /// ID of existing customer
    @dataExamples([
    {
        "json": "cu_dZjC0hAsYi2dObveagp6pJLoXvgmicoBQj8KuNOZ"
    }
])
    @pattern("^cu_")
    @required
    customer_id: String
    payment_method_types: CreateOrderExistingCustomerpaymentMethodTypes
    /// ID of saved payment method to use
    @dataExamples([
    {
        "json": "OaNWqiOeYa5OJMcxUPZC1pLCW94Ne3toks4HIVPRa"
    }
])
    payment_method_id: String
    payment_method_data: CreateOrderExistingCustomerpaymentMethodData
    /// Optional payment due time.
    @timestampFormat("date-time")
    payment_due_after: Timestamp
    /// Optional order number for reference. When omitted, Inttegro uses the generated order ID.
    @dataExamples([
    {
        "json": "ORDER-NUMBER-2"
    }
])
    number: String
    /// Optional receipt number for downstream reconciliation. Uses the same length rules as `number`.
    @dataExamples([
    {
        "json": "RCPT-NUMBER-2"
    }
])
    receipt_number: String
    /// Optional statement descriptor shown on the customer's bank statement
    @length(
        min: 3
        max: 22
    )
    statement_descriptor: String
    /// Optional static prefix used to build the statement descriptor as `prefix*order_id`. Mutually exclusive with `statement_descriptor`.
    @dataExamples([
    {
        "json": "LINE"
    }
])
    @length(
        min: 2
        max: 10
    )
    @pattern("^[^*]+$")
    statement_descriptor_prefix: String
    /// Whether to execute payment immediately
    execute_payment: Boolean
    /// Whether to explicitly finalize the order. When true, the order is finalized regardless of payment state. When false or omitted, finalization follows default heuristics (finalize if payment is executable).
    finalize: Boolean
    request_meta: CreateOrderExistingCustomerrequestMeta
    checkout_settings: CreateOrderExistingCustomercheckoutSettings
    invoice_settings: InvoiceSettings
    payout_settings: OrderPayoutSettingsRequest
    @required
    line_items: CreateOrderExistingCustomerlineItems
    custom_data: CustomData
    billing_details: BillingDetails
    shipping: Shipping
}

/// Checkout and payment flow configuration. Strongly recommended to provide both redirect_url and cancel_url for a delightful customer experience.
