    created_at: Timestamp
    @required
    @timestampFormat("date-time")
    updated_at: Timestamp
    @required
    @timestampFormat("date-time")
    expires_at: Timestamp
    @timestampFormat("date-time")
    uploading_at: Timestamp
    @timestampFormat("date-time")
    fulfilled_at: Timestamp
    @timestampFormat("date-time")
    expired_at: Timestamp
    @timestampFormat("date-time")
    canceled_at: Timestamp
}

@simileConstraints(
[
        {
            "aggregate": {
                "operation": "count",
                "source": "/upload_requests/*",
                "target": "/size"
            }
        }
    ]
)
structure UploadRequestPage {
    @required
    number: Integer
    @required
    size: Integer
    @required
    upload_requests: UploadRequestPageuploadRequests
}

structure UploadRequestPageResponse {
    @required
    page: UploadRequestPage
}

structure UploadRequestResponse {
    @required
    upload_request: UploadRequestObject
}

@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/reviewed_at"
                ]
            }
        }
    ]
)
structure UploadRequestReview {
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @required
    decision: UploadRequestReviewdecision
    @pattern("^file_")
    file_id: String
    public_message: String
    reasons: UploadRequestReviewreasons
    @required
    @timestampFormat("date-time")
    reviewed_at: Timestamp
    @required
    type: UploadRequestReviewtype
}

structure UploadRequestReviewReason {
    @length(
        min: 1
    )
    @required
    code: String
    @length(
        min: 1
    )
    @required
    message: String
    param: String
}

structure UploadRequestReviewReasonInput {
    @length(
        min: 1
    )
    @required
    code: String
    @length(
        min: 1
    )
    @required
    message: String
    param: String
}

@mixin
structure UploadRequestValidationErrorResponse {
    @required
    upload_request: UploadRequestWithAttemptObject
    @required
    error: UploadRequestValidationErrorResponseerror
}

structure UploadRequestValidationErrorResponseerror {
    @required
    code: String
    param: String
    @required
    message: String
    @required
    retryable: Boolean
}

structure UploadRequestWithAttemptObject with [UploadRequestObjectMixin] {
    attempt: UploadRequestAttempt
}

structure UploadRequestWithAttemptResponse {
    @required
    upload_request: UploadRequestWithAttemptObject
}

structure VerifyOTPRequest {
    /// ID of the OTP transaction to verify (with ot_ prefix)
    @dataExamples([
    {
        "json": "ot_3f8a9c7e2d1b4a6f"
    }
])
    @pattern("^ot_")
    @required
    transaction_id: String
    /// Phone number or bare email address that received the OTP; must match the stored transaction transport.
    @dataExamples([
    {
        "json": "+233241234567"
    }
])
    @required
    recipient: String
    /// OTP token submitted by the user
    @dataExamples([
    {
        "json": "847293"
    }
])
    @required
    token: String
}

structure VerifyOTPResponse {
    @required
    transaction: OTPTransaction
    @required
    verification_attempt: OTPVerificationAttempt
}

