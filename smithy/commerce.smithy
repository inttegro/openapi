/// Creates the first immutable version of a reusable operating policy owned by the
/// application. The selected capabilities must fit its active children policy. This
/// feature is available to selected accounts during private beta.
///
@http(
    method: "POST"
    uri: "/operating_policies/create"
    code: 200
)
@tags([
    "Operating Policies"
])
@responseRelations(
{
        "200": {
            "application/json": {
                "bindings": [
                    {
                        "from": "/capabilities/payments/currencies",
                        "to": "/operating_policy/capabilities/payments/currencies"
                    },
                    {
                        "from": "/capabilities/payments/limits",
                        "to": "/operating_policy/capabilities/payments/limits"
                    },
                    {
                        "from": "/capabilities/payment_methods",
                        "to": "/operating_policy/capabilities/payment_methods"
                    },
                    {
                        "from": "/capabilities/payouts/enabled",
                        "to": "/operating_policy/capabilities/payouts/enabled"
                    },
                    {
                        "from": "/capabilities/payouts/limits",
                        "to": "/operating_policy/capabilities/payouts/limits"
                    },
                    {
                        "from": "/capabilities/payouts/bt_aging_spec/id",
                        "to": "/operating_policy/capabilities/payouts/bt_aging_spec/id"
                    },
                    {
                        "from": "/description",
                        "to": "/operating_policy/description"
                    },
                    {
                        "from": "/name",
                        "to": "/operating_policy/name"
                    }
                ],
                "rules": [
                    {
                        "then": {
                            "set": {
                                "/operating_policy/capabilities/payouts/bt_aging_spec/t_plus": "0h"
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "equals": "bt_aging_spec_immediate",
                                    "request": "/capabilities/payouts/bt_aging_spec/id"
                                }
                            ]
                        }
                    },
                    {
                        "then": {
                            "set": {
                                "/operating_policy/capabilities/payouts/bt_aging_spec/t_plus": "24h"
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "equals": "bt_aging_spec_24_hourly",
                                    "request": "/capabilities/payouts/bt_aging_spec/id"
                                }
                            ]
                        }
                    },
                    {
                        "then": {
                            "set": {
                                "/operating_policy/capabilities/payouts/bt_aging_spec/t_plus": "48h"
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "equals": "bt_aging_spec_48_hourly",
                                    "request": "/capabilities/payouts/bt_aging_spec/id"
                                }
                            ]
                        }
                    },
                    {
                        "then": {
                            "set": {
                                "/operating_policy/capabilities/payouts/bt_aging_spec/t_plus": "168h"
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "equals": "bt_aging_spec_168_hourly",
                                    "request": "/capabilities/payouts/bt_aging_spec/id"
                                }
                            ]
                        }
                    }
                ]
            }
        }
    }
)
operation createOperatingPolicy {
    input: createOperatingPolicyInput
    output: createOperatingPolicy200
    errors: [
        createOperatingPolicy400
        createOperatingPolicy401
        createOperatingPolicy403
        createOperatingPolicy409
        createOperatingPolicy422
        createOperatingPolicy503
    ]
}

/// Creates a new order in Inttegro. This endpoint supports two flows:
/// 1. New customer flow: Provide `customer_data` to create a new customer and order
/// 2. Existing customer flow: Provide `customer_id` and optionally `payment_method_id` for known customers
///
/// The order can be configured to execute payment immediately or require manual payment later.
///
@http(
    method: "POST"
    uri: "/orders/create"
    code: 200
)
@tags([
    "Orders"
])
@responseRelations(
{
        "200": {
            "application/json": {
                "bindings": [
                    {
                        "from": "/customer_id",
                        "to": "/order/customer/id"
                    },
                    {
                        "from": "/customer_data/name",
                        "to": "/order/customer/name"
                    },
                    {
                        "from": "/customer_data/email_address",
                        "to": "/order/customer/email_address"
                    },
                    {
                        "from": "/customer_data/phone_number",
                        "to": "/order/customer/phone_number"
                    },
                    {
                        "from": "/number",
                        "to": "/order/number"
                    },
                    {
                        "from": "/receipt_number",
                        "to": "/order/receipt_number"
                    },
                    {
                        "from": "/custom_data",
                        "to": "/order/custom_data"
                    },
                    {
                        "from": "/line_items",
                        "to": "/order/line_item_group/line_items"
                    },
                    {
                        "from": "/line_items/*/product/price/currency",
                        "to": "/order/line_item_group/total/currency"
                    },
                    {
                        "from": "/line_items/*/fee/amount/currency",
                        "to": "/order/line_item_group/total/currency"
                    },
                    {
                        "from": "/line_items/*/shipping/fee/currency",
                        "to": "/order/line_item_group/total/currency"
                    },
                    {
                        "to": "/order/line_item_group/total/value",
                        "value": {
                            "add": [
                                {
                                    "sum": {
                                        "each": "/line_items/*/product",
                                        "value": {
                                            "multiply": [
                                                {
                                                    "path": "/quantity"
                                                },
                                                {
                                                    "path": "/price/value"
                                                }
                                            ]
                                        }
                                    }
                                },
                                {
                                    "sum": {
                                        "each": "/line_items/*/fee",
                                        "value": {
                                            "path": "/amount/value"
                                        }
                                    }
                                },
                                {
                                    "sum": {
                                        "each": "/line_items/*/shipping",
                                        "value": {
                                            "path": "/fee/value"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                ],
                "rules": [
                    {
                        "then": {
                            "omit": [
                                "/order/paid_at",
                                "/order/completed_at",
                                "/order/canceled_at",
                                "/order/refunds"
                            ],
                            "set": {
                                "/order/status": "requires_payment"
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "default": false,
                                    "equals": false,
                                    "request": "/execute_payment"
                                },
                                {
                                    "default": false,
                                    "equals": true,
                                    "request": "/finalize"
                                }
                            ]
                        }
                    },
                    {
                        "then": {
                            "omit": [
                                "/order/sealed_at",
                                "/order/paid_at",
                                "/order/completed_at",
                                "/order/canceled_at",
                                "/order/payment",
                                "/order/refunds"
                            ],
                            "set": {
                                "/order/status": "preparing"
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "default": false,
                                    "equals": false,
                                    "request": "/execute_payment"
                                },
                                {
                                    "default": false,
                                    "equals": false,
                                    "request": "/finalize"
                                }
                            ]
                        }
                    }
                ]
            }
        }
    }
)
operation createOrder {
    input: createOrderInput
    output: createOrder200
    errors: [
        createOrder400
        createOrder401
        createOrder409
        createOrder500
        createOrder503
    ]
}

/// Creates a new price in your catalog. Fixed prices may optionally be associated with a product;
/// customer-selected prices must be associated with a product. Multiple prices can exist for the
/// same product to support different currencies, markets, or customer segments.
///
/// Key points:
/// - Price amounts are immutable after creation (create new price to change amount)
/// - Product association (product_id) is optional for fixed prices, required for customer-selected prices, and immutable once set
/// - Customer-selected price definitions are available only to Commerce internal services and Upper private beta organizations and applications
/// - Label and about fields can be updated later
/// - Amount must be a positive integer representing the smallest currency unit (cents, pence, etc.)
