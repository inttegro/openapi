/// Send exactly one checkout reference. With `order_id`, Checkout pays the existing
/// finalized Order. With `purchase_intent_id`, Checkout validates the selected product,
/// quantity, and amount, creates the finalized Order, and starts payment as one
/// idempotent operation when the payer submits payment. Purchase Intent payments must
/// include `customer_data` and new `payment_method_data`; saved payment methods can be
/// used only with an existing Order.
///
/// Retry an uncertain request with the same idempotency key and body.
///
@http(
    method: "POST"
    uri: "/checkout/pay"
    code: 200
)
@tags([
    "Checkout"
])
@auth([])
@responseRelations(
{
        "200": {
            "application/json": {
                "bindings": [
                    {
                        "from": "/order_id",
                        "to": "/order/id"
                    },
                    {
                        "from": "/purchase_intent_id",
                        "to": "/order/created_from/resource_id"
                    },
                    {
                        "from": "/customer_data/name",
                        "to": "/order/customer/name"
                    },
                    {
                        "from": "/customer_data/email_address",
                        "to": "/order/customer/email_address"
                    },
                    {
                        "from": "/customer_data/phone_number",
                        "to": "/order/customer/phone_number"
                    },
                    {
                        "from": "/payment_method_id",
                        "to": "/order/payment/payment_method/id"
                    }
                ]
            }
        }
    }
)
operation payCheckout {
    input: payCheckoutInput
    output: payCheckout200
    errors: [
        payCheckout400
        payCheckout409
        payCheckout422
        payCheckout503
        payCheckout504
    ]
}

