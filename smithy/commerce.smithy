@mixin
structure PurchaseIntentMixin {
    /// Whether the intent was configured with a variant set
    @dataExamples([
    {
        "json": false
    }
])
    @required
    allow_variants: Boolean
    /// Application that owns the purchase intent. This is routing metadata, not merchant presentation.
    @dataExamples([
    {
        "json": "app_abc123"
    }
])
    @pattern("^app_")
    @required
    application_id: String
    bundle: PurchaseIntentBundle
    /// Creation timestamp
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    /// Timestamp at or after which the Buy link is expired
    @timestampFormat("date-time")
    expires_at: Timestamp
    /// Unique purchase intent identifier with sale_ prefix. Append it to https://pages.inttegro.com/buy/ to build the hosted Buy link.
    @dataExamples([
    {
        "json": "sale_ABCXYZ"
    }
])
    @pattern("^sale_")
    @required
    id: String
    /// When the Buy link was explicitly canceled
    @timestampFormat("date-time")
    inactive_at: Timestamp
    merchant: PurchaseIntentMerchant
    price: PurchaseIntentpriceSchema
    presentation: PurchaseIntentPresentation
    product: PurchaseIntentProduct
    @required
    quantity: PurchaseIntentquantity
    @required
    status: PurchaseIntentstatus
    /// Last mutation timestamp
    @timestampFormat("date-time")
    updated_at: Timestamp
    @required
    usage: PurchaseIntentUsage
    variant_set: PurchaseIntentVariantSet
}

structure PurchaseIntentMultiUseUsage {
    @required
    multi_use: Boolean
}

structure PurchaseIntentOriginalPrice {
    /// Whether the resolved comparison price is active
    @dataExamples([
    {
        "json": true
    }
])
    @required
    active: Boolean
    /// Catalog price ID when the comparison price is not inline
    @dataExamples([
    {
        "json": "pr_original123"
    }
])
    @pattern("^pr_")
    id: String
    /// Catalog price label when available
    @dataExamples([
    {
        "json": "Regular price"
    }
])
    label: String
    @required
    nominal: Amount
}

structure PurchaseIntentPresentation {
    buy_page: PurchaseIntentPresentationbuyPage
}

structure PurchaseIntentPresentationbuyPage {
    text: PurchaseIntentPresentationbuyPagetext
}

structure PurchaseIntentPresentationbuyPagetext {
    checkout_section_title: String
    amount_field_label: String
    primary_action_label: String
}

structure PurchaseIntentPrice with [PurchaseIntentPriceMixin] {}

/// Effective Buy-link offer price. For a bundle without an explicit override, this is the current catalog default.
structure PurchaseIntentpriceSchema with [PurchaseIntentPriceMixin] {}

@mixin
structure PurchaseIntentPriceMixin {
    /// Whether the resolved price can be used
    @dataExamples([
    {
        "json": true
    }
])
    @required
    active: Boolean
    /// Catalog price ID when the offer price is not inline
    @dataExamples([
    {
        "json": "pr_xyz789"
    }
])
    @pattern("^pr_")
    id: String
    /// Catalog price label when available
    @dataExamples([
    {
        "json": "Campaign price"
    }
])
    label: String
    @required
    nominal: Amount
    original: PurchaseIntentOriginalPrice
}

/// Price selection for the Buy-link offer. Products require it; bundles may omit it to use the current catalog default. Send exactly one of id or nominal and at most one of original or original_id.
@simileSchema(
{
        "additionalProperties": false,
        "allOf": [
            {
                "oneOf": [
                    {
                        "properties": {
                            "id": {}
                        },
                        "required": [
                            "id"
                        ]
                    },
                    {
                        "properties": {
                            "nominal": {}
                        },
                        "required": [
                            "nominal"
                        ]
                    }
                ]
            },
            {
                "not": {
                    "properties": {
                        "original": {},
                        "original_id": {}
                    },
                    "required": [
                        "original",
                        "original_id"
                    ]
                }
            }
        ],
        "description": "Price selection for the Buy-link offer. Products require it; bundles may omit it to use the current catalog default. Send exactly one of id or nominal and at most one of original or original_id.",
        "properties": {
            "id": {
                "description": "Active, unarchived app-owned price ID. It must belong to a selected product; for a bundle it must be fixed and use the bundle catalog currency.",
                "example": "pr_xyz789",
                "pattern": "^pr_",
                "type": "string"
            },
            "nominal": {
                "allOf": [
                    {
                        "shape": "PriceParams"
                    }
                ],
                "description": "Inline offer amount when no price ID is provided"
            },
            "original": {
                "additionalProperties": false,
                "allOf": [
                    {
                        "oneOf": [
                            {
                                "properties": {
                                    "id": {}
                                },
                                "required": [
                                    "id"
                                ]
                            },
                            {
                                "properties": {
                                    "nominal": {}
                                },
                                "required": [
                                    "nominal"
                                ]
                            }
                        ]
                    }
                ],
                "description": "Optional original price used for comparison display",
                "properties": {
                    "id": {
                        "description": "App-owned fixed comparison price ID. It must belong to a selected product; for a bundle it must use the bundle catalog currency.",
                        "example": "pr_original123",
                        "pattern": "^pr_",
                        "type": "string"
                    },
                    "nominal": {
                        "allOf": [
                            {
                                "shape": "PriceParams"
                            }
                        ],
                        "description": "Inline original price amount"
                    }
                },
                "type": "object"
            },
            "original_id": {
                "description": "App-owned comparison price ID when not using original.id",
                "example": "pr_original123",
                "pattern": "^pr_",
                "type": "string"
            }
        },
        "type": "object"
    }
)
structure PurchaseIntentPriceSelection {
    /// Active, unarchived app-owned price ID. It must belong to a selected product; for a bundle it must be fixed and use the bundle catalog currency.
    @dataExamples([
    {
        "json": "pr_xyz789"
    }
])
    @pattern("^pr_")
    id: String
    nominal: PurchaseIntentPriceSelectionnominal
    original: PurchaseIntentPriceSelectionoriginal
    /// App-owned comparison price ID when not using original.id
    @dataExamples([
    {
        "json": "pr_original123"
    }
])
    @pattern("^pr_")
    original_id: String
}

/// Inline offer amount when no price ID is provided
structure PurchaseIntentPriceSelectionnominal with [
    AmountParamsMixin
    PriceParamsMixin
] {}

apply PurchaseIntentPriceSelectionnominal$currency @required

apply PurchaseIntentPriceSelectionnominal$value {
    @dataExamples([
    {
        "json": 20000
    }
])
    @documentation("Amount in smallest currency unit (e.g., pesewas for GHS)")
    @range(
        min: 0
    )
    @required
}

/// Optional original price used for comparison display
structure PurchaseIntentPriceSelectionoriginal {
    /// App-owned fixed comparison price ID. It must belong to a selected product; for a bundle it must use the bundle catalog currency.
    @dataExamples([
    {
        "json": "pr_original123"
    }
])
    @pattern("^pr_")
    id: String
    nominal: PurchaseIntentPriceSelectionoriginalnominal
}

/// Inline original price amount
structure PurchaseIntentPriceSelectionoriginalnominal with [
    AmountParamsMixin
    PriceParamsMixin
] {}

apply PurchaseIntentPriceSelectionoriginalnominal$currency @required

apply PurchaseIntentPriceSelectionoriginalnominal$value {
    @dataExamples([
    {
        "json": 20000
    }
])
    @documentation("Amount in smallest currency unit (e.g., pesewas for GHS)")
    @range(
        min: 0
    )
    @required
}

structure PurchaseIntentProduct with [PriceEmbeddedProduct] {
    prices: PurchaseIntentProductallOf1prices
    /// Variant set configured for this Buy link
    @dataExamples([
    {
        "json": "pg_variantset123"
    }
])
    @pattern("^pg_")
    variant_set_id: String
}

/// Product selection with optional variant-set configuration. Use this instead of product_id.
structure PurchaseIntentProductSelection {
    /// Product ID to sell through the Buy link
    @dataExamples([
    {
        "json": "prod_abc123"
    }
])
    @pattern("^prod_")
    @required
    id: String
    /// Optional variant set ID the hosted checkout may use for sibling product selection
    @dataExamples([
    {
        "json": "pg_variantset123"
    }
])
    @pattern("^pg_")
    variant_set_id: String
}

/// Quantity bounds enforced by the hosted checkout. max is omitted when the offer has no upper bound.
@simileConstraints(
[
        {
            "bounded": {
                "minimum": {
                    "path": "/min"
                },
                "path": "/max"
            }
        }
    ]
)
structure PurchaseIntentquantity {
    /// Minimum quantity the hosted checkout allows
    @dataExamples([
    {
        "json": 1
    }
])
    @range(
        min: 1
    )
    @required
    min: Integer
    /// Optional maximum quantity the hosted checkout allows. It is always greater than or equal to min when present.
    @dataExamples([
    {
        "json": 5
    }
])
    @range(
        min: 1
    )
    max: Integer
}

structure PurchaseIntentResponse with [PurchaseIntentResponseMixin] {}

@mixin
structure PurchaseIntentResponseMixin {
    @required
    purchase_intent: PurchaseIntent
}

structure PurchaseIntentSingleUseUsage {
    order: PurchaseIntentUsageOrder
    @required
    single_use: Boolean
}

structure PurchaseIntentUsageOrder {
    /// When order creation consumed the single-use Buy link
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    /// Order that consumed the Buy link
    @dataExamples([
    {
        "json": "or_abc123"
    }
])
    @pattern("^or_")
    @required
    id: String
}

structure PurchaseIntentVariant {
    @dataExamples([
    {
        "json": true
    }
])
    @required
    active: Boolean
    @dataExamples([
    {
        "json": 0
    }
])
    position: Integer
    price: PurchaseIntentPrice
    product: PurchaseIntentProduct
    @dataExamples([
    {
        "json": "prod_variant123"
    }
])
    @pattern("^prod_")
    @required
    product_id: String
    @required
    variant_values: VariantValues
}

structure PurchaseIntentVariantAxis {
    @dataExamples([
    {
        "json": "size"
    }
])
    @required
    key: String
    @dataExamples([
    {
        "json": "Size"
    }
])
    @required
    label: String
    @dataExamples([
    {
        "json": 0
    }
])
    @required
    position: Integer
}

structure PurchaseIntentVariantSet {
    @dataExamples([
    {
        "json": true
    }
])
    @required
    active: Boolean
    @dataExamples([
    {
        "json": "prod_abc123"
    }
])
    @pattern("^prod_")
    default_product_id: String
    @dataExamples([
    {
        "json": "Choose a tin size"
    }
])
    description: String
    @dataExamples([
    {
        "json": "pg_variantset123"
    }
])
    @pattern("^pg_")
    @required
    id: String
    @dataExamples([
    {
        "json": "Tin size"
    }
])
    @required
    name: String
    @dataExamples([
    {
        "json": "matcha-tin-size"
    }
])
    reference: String
    @required
    variant_axes: PurchaseIntentVariantSetvariantAxes
    @required
    variants: PurchaseIntentVariantSetvariants
}

structure ReconnectFinancialAccountResponse {
    @required
    account: FinancialAccountCompactResponse
}

@simileConstraints(
[
        {
            "lifecycle": {
                "created-at": "/created_at",
                "state": "/status",
                "transitions": [
                    {
                        "at": "/processing_at",
                        "from": "pending",
                        "to": "processing"
                    },
                    {
                        "at": "/succeeded_at",
                        "from": "processing",
                        "to": "succeeded"
                    },
                    {
                        "at": "/failed_at",
                        "from": "processing",
                        "to": "failed"
                    },
                    {
                        "at": "/canceled_at",
                        "from": "pending",
                        "to": "canceled"
                    }
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/failure",
                            "state": "absent"
                        },
                        {
                            "path": "/cancel_reason",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "pending",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/failure",
                            "state": "absent"
                        },
                        {
                            "path": "/cancel_reason",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "processing",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/failure",
                            "state": "absent"
                        },
                        {
                            "path": "/cancel_reason",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "succeeded",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/failure",
                            "state": "non-null"
                        },
                        {
                            "path": "/cancel_reason",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "failed",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/failure",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "canceled",
                    "path": "/status"
                }
            }
        },
        {
            "equal": {
                "paths": [
                    "/total/currency",
                    "/order_amount/currency",
                    "/line_items/*/original_amount_paid/currency",
                    "/line_items/*/refund_amount/currency"
                ]
            }
        },
        {
            "aggregate": {
                "operation": "sum",
                "source": "/line_items/*/refund_amount/value",
                "target": "/total/value"
