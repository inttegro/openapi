@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/published_at",
                    "/updated_at",
                    "/archived_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/published_at",
                            "state": "absent"
                        },
                        {
                            "path": "/archived_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "draft",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/published_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/archived_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "published",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/archived_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "equals": "archived",
                    "path": "/status"
                }
            }
        }
    ]
)
structure MessageTemplate {
    /// API-generated unique template id.
    @dataExamples([
    {
        "json": "mtpl_receipt"
    }
])
    @pattern("^mtpl_")
    @required
    id: String
    @dataExamples([
    {
        "json": "Receipt email"
    }
])
    @required
    name: String
    @dataExamples([
    {
        "json": "Sent after successful payment."
    }
])
    about: String
    @required
    channel: MessageTemplatechannel
    @dataExamples([
    {
        "json": "receipt"
    }
])
    @required
    purpose: String
    @dataExamples([
    {
        "json": "en"
    }
])
    @required
    locale: String
    @required
    status: MessageTemplatestatus
    @dataExamples([
    {
        "json": 2
    }
])
    @required
    version: Integer
    @dataExamples([
    {
        "json": 1
    }
])
    published_version: Integer
    @dataExamples([
    {
        "json": 2
    }
])
    @required
    draft_version: Integer
    @required
    has_unpublished_changes: Boolean
    variables: MessageTemplatevariablesSchema
    sms: MessageTemplateSMSContent
    email: MessageTemplateEmailContent
    attachments: MessageTemplateAttachmentIDs
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @required
    @timestampFormat("date-time")
    updated_at: Timestamp
    @timestampFormat("date-time")
    published_at: Timestamp
    @timestampFormat("date-time")
    archived_at: Timestamp
}

structure MessageTemplateEmailContent {
    /// Email subject template.
    @dataExamples([
    {
        "json": "Your receipt"
    }
])
    @required
    subject: String
    /// HTML email body template.
    @dataExamples([
    {
        "json": "<p>Thanks {{customer_name}}.</p>"
    }
])
    @required
    html: String
    from: MessageTemplateEmailContentfrom
    reply_to: MessageTemplateMailbox
    headers: MessageHeaders
}

/// Optional sender identity. When omitted, Mercurio stores and uses the configured default sender. A supplied address must be a literal sender approved for the authenticated application; template expressions are not accepted in the sender address.
structure MessageTemplateEmailContentfrom with [MessageTemplateMailboxMixin] {}

structure MessageTemplateEnvelope {
    @required
    message_template: MessageTemplate
}

structure MessageTemplateIDRequest {
    /// API-generated message template id.
    @dataExamples([
    {
        "json": "mtpl_receipt"
    }
])
    @pattern("^mtpl_")
    @required
    id: String
}

structure MessageTemplateMailbox with [MessageTemplateMailboxMixin] {}

@mixin
structure MessageTemplateMailboxMixin {
    /// Literal or templated mailbox address, such as `{{recipient_email}}`.
    @dataExamples([
    {
        "json": "{{recipient_email}}"
    }
])
    @required
    address: String
    @dataExamples([
    {
        "json": "Acme"
    }
])
    name: String
}

structure MessageTemplateReference {
    /// API-generated message template id.
    @dataExamples([
    {
        "json": "mtpl_receipt"
    }
])
    @pattern("^mtpl_")
    @required
    template_id: String
    variables: MessageTemplateVariables
}

/// Result of the email safety scan.
structure MessageTemplateSafetyResult {
    @required
    content_hash: String
    links: MessageTemplateSafetyResultlinks
    @required
    normalized_text: String
    quarantine_notes: String
    reason_codes: MessageTemplateSafetyResultreasonCodes
    sanitized_html: String
    @required
    scanner: String
    @required
    status: MessageTemplateSafetyResultstatus
}

structure MessageTemplateScannedLink {
    host: String
    @required
    raw: String
    reason: String
    @required
    scheme: String
    @required
    status: String
}

structure MessageTemplateSMSContent {
    /// SMS body template.
    @dataExamples([
    {
        "json": "Your code is {{code}}."
    }
])
    @required
    message_template: String
}

@simileConstraints(
[
        {
            "aggregate": {
                "operation": "count",
                "source": "/message_templates/*",
                "target": "/size"
            }
        }
    ]
)
structure MessageTemplatesPage {
    @dataExamples([
    {
        "json": 1
    }
])
    @required
    number: Integer
    /// Number of templates returned in this page after filters are applied.
    @dataExamples([
    {
        "json": 25
    }
])
    @required
    size: Integer
    @required
    message_templates: MessageTemplatesPagemessageTemplates
}

structure MessageTemplatesPageEnvelope {
    @required
    page: MessageTemplatesPage
}

structure MessageTemplateVariable {
    about: String
    /// Default value used when this variable is omitted.
    default: Document
    items: MessageTemplateVariableitems
    @required
    name: String
    @required
    required: Boolean
    @required
    type: MessageTemplateVariabletype
}

structure MessageTemplateVariableInput {
    @dataExamples([
    {
        "json": "customer_name"
    }
])
    @pattern("^[a-z][a-z0-9_]{0,63}$")
    @required
    name: String
    @required
    type: MessageTemplateVariableInputtype
    required: Boolean
    /// Default value used when this variable is omitted.
    default: Document
    /// Optional description of the variable.
    about: String
    items: MessageTemplateVariableInputitems
}

structure MessageTemplateVariableItem {
    about: String
    /// Default value used when this variable is omitted.
    default: Document
    @required
    name: String
    @required
    required: Boolean
    @required
    type: MessageTemplateVariableItemtype
}

structure MessageTemplateVariableItemInput {
    about: String
    /// Default value used when this variable is omitted.
    default: Document
    @pattern("^[a-z][a-z0-9_]{0,63}$")
    @required
    name: String
    required: Boolean
    @required
    type: MessageTemplateVariableItemInputtype
}

@simileConstraints(
[
        {
            "bounded": {
                "maximum": {
                    "path": "/active_version"
                },
                "path": "/version"
            }
        },
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/version_created_at",
                    "/updated_at"
                ]
            }
        }
    ]
)
structure OperatingPolicy {
    @pattern("^op_")
    @required
    id: String
    @range(
        min: 1
    )
    @required
    version: Integer
    @range(
        min: 1
    )
    @required
    active_version: Integer
    @required
    name: String
    description: String
    @required
    capabilities: OperatingPolicyCapabilities
    @pattern("^cp_")
    @required
    children_policy_id: String
    @range(
        min: 1
    )
    @required
    children_policy_version: Integer
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @required
    @timestampFormat("date-time")
    updated_at: Timestamp
    @required
    @timestampFormat("date-time")
    version_created_at: Timestamp
}

structure OperatingPolicyCapabilities {
    payments: OperatingPolicyPaymentsCapabilities
    payouts: OperatingPolicyPayoutsCapabilities
    payment_methods: OperatingPolicyPaymentMethodsCapabilities
}

structure OperatingPolicyCapabilitiesInput {
    payments: OperatingPolicyPaymentsCapabilitiesInput
    payouts: OperatingPolicyPayoutsCapabilitiesInput
    payment_methods: OperatingPolicyPaymentMethodsCapabilities
}

structure OperatingPolicyPaymentMethodCapabilities {
    @required
    enabled: Boolean
    @required
    confirms_use: Boolean
}

structure OperatingPolicyPaymentMethodsCapabilities {
    mobile_money: OperatingPolicyPaymentMethodCapabilities
    bank_account: OperatingPolicyPaymentMethodCapabilities
    motito: OperatingPolicyPaymentMethodCapabilities
    card: OperatingPolicyPaymentMethodCapabilities
}

structure OperatingPolicyPaymentsCapabilities {
    currencies: OperatingPolicyPaymentsCapabilitiescurrencies
    limits: PolicyLimits
}

structure OperatingPolicyPaymentsCapabilitiesInput {
    currencies: OperatingPolicyPaymentsCapabilitiesInputcurrencies
    limits: PolicyLimits
}

structure OperatingPolicyPayoutsCapabilities {
    enabled: Boolean
    limits: PolicyLimits
    bt_aging_spec: PolicyBTAgingSpec
}

structure OperatingPolicyPayoutsCapabilitiesInput {
    enabled: Boolean
    limits: PolicyLimits
    bt_aging_spec: PolicyBTAgingSpecReference
}

structure OperatingPolicyResponse {
    @required
    operating_policy: OperatingPolicy
}

structure OperatingPolicySelectionByID {
    /// Active operating policy owned by the placement parent.
    @pattern("^op_")
    @required
    id: String
}

@simileConstraints(
[
        {
            "aggregate": {
                "operation": "count",
                "source": "/versions/*",
                "target": "/count"
            }
        }
    ]
)
structure OperatingPolicyVersionsPage {
    @range(
        min: 1
    )
    @required
    number: Integer
    @range(
        min: 1
        max: 100
    )
    @required
    size: Integer
    @range(
        min: 0
    )
    @required
    count: Integer
    @range(
        min: 1
    )
    @required
    total: Integer
    @required
    has_more: Boolean
    @required
    versions: OperatingPolicyVersionsPageversions
}

structure OperatingPolicyVersionsPageResponse {
    @required
    page: OperatingPolicyVersionsPage
}

/// Complete order record with line items, customer details, payment state, and fulfillment information
@simileSchema(
{
        "additionalProperties": false,
        "description": "Complete order record with line items, customer details, payment state, and fulfillment information",
        "properties": {
            "canceled_at": {
                "description": "When the order was canceled. Omitted otherwise.",
                "format": "date-time",
                "type": "string"
            },
            "checkout_settings": {
                "additionalProperties": false,
                "description": "Checkout and payment flow configuration for this order",
                "properties": {
                    "cancel_url": {
                        "description": "URL to redirect the customer after canceling checkout",
                        "format": "uri",
                        "type": "string"
                    },
                    "redirect_url": {
                        "description": "URL to redirect the customer after payment completion",
                        "format": "uri",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "completed_at": {
                "description": "When the order was completed. Omitted otherwise.",
                "format": "date-time",
                "type": "string"
            },
            "created_from": {
                "additionalProperties": false,
                "description": "Attribution for the public resource that created this order, when available.",
                "minProperties": 1,
                "properties": {
                    "resource_id": {
                        "type": "string"
                    },
                    "resource_type": {
                        "enum": [
                            "purchase_intent"
                        ],
                        "type": "string"
                    },
                    "source": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "custom_data": {
                "shape": "NonEmptyCustomData"
            },
            "customer": {
                "additionalProperties": false,
                "properties": {
                    "billing_address": {
                        "shape": "OrderAddress"
                    },
                    "email_address": {
                        "format": "email",
                        "type": "string"
                    },
                    "guest": {
                        "type": "boolean"
                    },
                    "id": {
                        "pattern": "^cu_",
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "phone_number": {
                        "type": "string"
                    },
                    "shipping_address": {
                        "shape": "OrderAddress"
                    }
                },
                "required": [
                    "guest",
                    "id",
                    "name"
                ],
                "type": "object"
            },
            "expires_at": {
                "description": "When the order expires. Omitted when no expiry is set.",
                "format": "date-time",
                "type": "string"
            },
            "id": {
                "description": "Unique identifier for this order",
                "example": "or_48ZW7BGvYUBWc1i6WBkL2jr0iPQP5jUy76mmmHpt",
                "pattern": "^or_",
                "type": "string"
            },
            "initiated_at": {
                "description": "When order processing began",
                "format": "date-time",
                "type": "string"
            },
            "invoice": {
                "additionalProperties": false,
                "properties": {
                    "delivery_summary": {
                        "shape": "OrderDocumentDeliverySummary"
                    },
                    "format": {
                        "additionalProperties": false,
                        "properties": {
                            "pdf": {
                                "shape": "OrderDocumentFormat"
                            },
                            "web": {
                                "shape": "OrderDocumentFormat"
                            }
                        },
                        "required": [
                            "web",
                            "pdf"
                        ],
                        "type": "object"
                    },
                    "number": {
                        "type": "string"
                    }
                },
                "required": [
                    "format"
                ],
                "type": "object"
            },
            "invoice_settings": {
                "shape": "OrderInvoiceSettingsResponse"
            },
            "line_item_group": {
                "additionalProperties": false,
                "description": "Cart contents and totals",
                "properties": {
                    "line_items": {
                        "description": "Array of products, fees, and shipping charges",
                        "items": {
                            "shape": "OrderLineItem"
                        },
                        "minItems": 1,
                        "type": "array"
                    },
                    "total": {
                        "shape": "Amount"
                    }
                },
                "required": [
                    "line_items",
                    "total"
                ],
                "type": "object"
            },
            "number": {
                "description": "Human-readable order number",
                "example": "ORDER-12345",
                "type": "string"
            },
            "paid_at": {
                "description": "When the order became paid",
                "format": "date-time",
                "type": "string"
            },
            "payment": {
                "additionalProperties": false,
                "description": "Payment intent tied to this order",
                "properties": {
                    "amount": {
                        "shape": "Amount"
                    },
                    "balance_transaction": {
                        "shape": "BalanceTransaction"
                    },
                    "billing_details": {
                        "additionalProperties": false,
                        "properties": {
                            "owner": {
                                "additionalProperties": false,
                                "properties": {
                                    "address": {
                                        "shape": "OrderAddress"
                                    },
                                    "name": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "name"
                                ],
                                "type": "object"
                            }
                        },
                        "type": "object"
                    },
                    "canceled_at": {
                        "description": "When payment was canceled",
                        "format": "date-time",
                        "type": "string"
                    },
                    "customer": {
                        "additionalProperties": false,
                        "properties": {
                            "billing_address": {
                                "shape": "OrderAddress"
                            },
                            "email_address": {
                                "format": "email",
                                "type": "string"
                            },
                            "guest": {
                                "type": "boolean"
                            },
                            "id": {
                                "pattern": "^cu_",
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "phone_number": {
                                "type": "string"
                            },
                            "shipping_address": {
                                "shape": "OrderAddress"
                            }
                        },
                        "required": [
                            "id",
                            "guest",
                            "name"
                        ],
                        "type": "object"
                    },
                    "due_at": {
                        "description": "When payment becomes overdue",
                        "format": "date-time",
                        "type": "string"
                    },
                    "executed_at": {
                        "description": "When payment execution started",
                        "format": "date-time",
                        "type": "string"
                    },
                    "expired_at": {
                        "description": "When payment expired",
                        "format": "date-time",
                        "type": "string"
                    },
                    "failed_at": {
                        "description": "When payment failed",
                        "format": "date-time",
                        "type": "string"
                    },
                    "id": {
                        "description": "Payment intent ID",
                        "example": "py_OHFv6I3OZBvB1R46TQQGNxPPtgbPR6CXpQ8En9wl",
                        "pattern": "^py_",
                        "type": "string"
                    },
                    "initiated_at": {
                        "description": "When we kicked off the payment intent",
                        "format": "date-time",
                        "type": "string"
                    },
                    "latest_attempt": {
                        "additionalProperties": false,
                        "description": "Most recent payment attempt details",
                        "properties": {
                            "error": {
                                "additionalProperties": false,
                                "properties": {
                                    "message": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "message"
                                ],
                                "type": "object"
                            },
                            "initiated_at": {
                                "format": "date-time",
                                "type": "string"
                            },
                            "payment_method_id": {
                                "example": "pm_hg7D2A5qT6g6mVDSJu6zweKXwsiiNWf3Q85book6",
                                "pattern": "^pm_",
                                "type": "string"
                            },
                            "payment_method_type": {
                                "example": "mobile_money",
                                "type": "string"
                            },
                            "reference": {
                                "description": "External payment reference",
                                "example": "68c6ecbc3bf0a6548973b598",
                                "type": "string"
                            },
                            "status": {
                                "enum": [
                                    "initiated",
                                    "executed",
                                    "succeeded",
                                    "canceled",
                                    "expired",
                                    "failed",
                                    "unknown"
                                ],
                                "example": "succeeded",
                                "type": "string"
                            },
                            "succeeded_at": {
                                "format": "date-time",
                                "type": "string"
                            }
                        },
                        "required": [
                            "status",
                            "initiated_at"
                        ],
                        "simileConstraints": [
                            {
                                "ordered": {
                                    "paths": [
                                        "/initiated_at",
                                        "/succeeded_at"
                                    ]
                                }
                            },
                            {
                                "implies": {
                                    "then": {
                                        "all": [
                                            {
                                                "path": "/succeeded_at",
                                                "state": "non-null"
                                            }
                                        ]
                                    },
                                    "when": {
                                        "equals": "succeeded",
                                        "path": "/status"
                                    }
                                }
                            },
                            {
                                "implies": {
                                    "then": {
                                        "all": [
                                            {
                                                "equals": "succeeded",
                                                "path": "/status"
                                            }
                                        ]
                                    },
                                    "when": {
                                        "path": "/succeeded_at",
                                        "state": "non-null"
                                    }
                                }
                            }
                        ],
                        "type": "object"
                    },
                    "latest_error": {
                        "additionalProperties": false,
                        "properties": {
                            "code": {
                                "type": "string"
                            },
                            "docs_url": {
                                "format": "uri",
                                "type": "string"
                            },
                            "message": {
                                "type": "string"
                            },
                            "source": {
                                "type": "string"
                            },
                            "type": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "message",
                            "docs_url",
                            "source",
                            "type",
                            "code"
                        ],
                        "type": "object"
                    },
                    "next_action": {
                        "shape": "PaymentNextAction"
                    },
                    "paid_at": {
                        "description": "When payment completed successfully",
                        "format": "date-time",
                        "type": "string"
                    },
                    "paid_offline": {
                        "description": "Whether payment was recorded as received outside Inttegro",
                        "type": "boolean"
                    },
                    "payment_method": {
                        "shape": "OrderPaymentMethod"
                    },
                    "payment_method_types": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "payout_configuration": {
                        "additionalProperties": false,
                        "description": "Payout configuration for this payment",
                        "properties": {
                            "destination": {
                                "additionalProperties": false,
                                "description": "Where the funds will be paid out",
                                "properties": {
                                    "financial_account_id": {
                                        "description": "ID of the financial account receiving the payout",
                                        "example": "fa_1234567890abcdef",
                                        "pattern": "^fa_",
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "financial_account_id"
                                ],
                                "type": "object"
                            },
                            "enable_fx": {
                                "description": "Compatibility flag. Cross-currency payout execution is not currently available.",
                                "enum": [
                                    false
                                ],
                                "example": false,
                                "type": "boolean"
                            }
                        },
                        "required": [
                            "enable_fx",
                            "destination"
                        ],
                        "type": [
                            "object",
                            "null"
                        ]
                    },
                    "receipt": {
                        "shape": "OrderReceipt"
                    },
                    "statement_descriptor": {
                        "description": "Optional statement descriptor shown on the customer's bank statement",
                        "example": "STATEMENT",
                        "type": "string"
                    },
                    "status": {
                        "description": "Payment state",
                        "enum": [
                            "initiated",
                            "requires_action",
                            "processing",
                            "overdue",
                            "executed",
                            "paid",
                            "canceled",
                            "expired",
                            "failed",
                            "unknown"
                        ],
                        "example": "paid",
                        "type": "string"
                    }
                },
                "required": [
                    "amount",
                    "id",
                    "initiated_at",
                    "statement_descriptor",
                    "status"
                ],
                "simileConstraints": [
                    {
                        "ordered": {
                            "paths": [
                                "/initiated_at",
                                "/executed_at",
                                "/paid_at"
                            ]
                        }
                    },
                    {
                        "ordered": {
                            "paths": [
                                "/initiated_at",
                                "/executed_at",
                                "/failed_at"
                            ]
                        }
                    },
                    {
                        "ordered": {
                            "paths": [
                                "/initiated_at",
                                "/canceled_at"
                            ]
                        }
                    },
                    {
                        "ordered": {
                            "paths": [
                                "/initiated_at",
                                "/expired_at"
                            ]
                        }
                    },
                    {
                        "implies": {
                            "then": {
                                "all": [
                                    {
                                        "path": "/executed_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/paid_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/failed_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/canceled_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/expired_at",
                                        "state": "absent"
                                    }
                                ]
                            },
                            "when": {
                                "equals": "initiated",
                                "path": "/status"
                            }
                        }
                    },
                    {
                        "implies": {
                            "then": {
                                "all": [
                                    {
                                        "path": "/next_action",
                                        "state": "non-null"
                                    },
                                    {
                                        "path": "/paid_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/failed_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/canceled_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/expired_at",
                                        "state": "absent"
                                    }
                                ]
                            },
                            "when": {
                                "equals": "requires_action",
                                "path": "/status"
                            }
                        }
                    },
                    {
                        "implies": {
                            "then": {
                                "all": [
                                    {
                                        "path": "/paid_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/failed_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/canceled_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/expired_at",
                                        "state": "absent"
                                    }
                                ]
                            },
                            "when": {
                                "equals": "processing",
                                "path": "/status"
                            }
                        }
                    },
                    {
                        "implies": {
                            "then": {
                                "all": [
                                    {
                                        "path": "/due_at",
                                        "state": "non-null"
                                    },
                                    {
                                        "path": "/paid_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/failed_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/canceled_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/expired_at",
                                        "state": "absent"
                                    }
                                ]
                            },
                            "when": {
                                "equals": "overdue",
                                "path": "/status"
                            }
                        }
                    },
                    {
                        "implies": {
                            "then": {
                                "all": [
                                    {
                                        "path": "/executed_at",
                                        "state": "non-null"
                                    },
                                    {
                                        "path": "/paid_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/failed_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/canceled_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/expired_at",
                                        "state": "absent"
                                    }
                                ]
                            },
                            "when": {
                                "equals": "executed",
                                "path": "/status"
                            }
                        }
                    },
                    {
                        "implies": {
                            "then": {
                                "all": [
                                    {
                                        "path": "/paid_at",
                                        "state": "non-null"
                                    },
                                    {
                                        "path": "/failed_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/canceled_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/expired_at",
                                        "state": "absent"
                                    }
                                ]
                            },
                            "when": {
                                "equals": "paid",
                                "path": "/status"
                            }
                        }
                    },
                    {
                        "implies": {
                            "then": {
                                "all": [
                                    {
                                        "path": "/paid_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/failed_at",
                                        "state": "non-null"
                                    },
                                    {
                                        "path": "/canceled_at",
                                        "state": "absent"
                                    },
                                    {
                                        "path": "/expired_at",
                                        "state": "absent"
                                    }
                                ]
                            },
                            "when": {
                                "equals": "failed",
                                "path": "/status"
                            }
                        }
                    },
                    {
