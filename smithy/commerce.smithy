}

/// Live operational commitments read from the canonical balance position.
structure BalanceHolds {
    /// When these strongly consistent hold amounts were read.
    @required
    @timestampFormat("date-time")
    as_of: Timestamp
    @required
    payout: BalanceHoldspayout
    @required
    refund: BalanceHoldsrefund
}

/// Funds committed to in-flight or unresolved payouts.
structure BalanceHoldspayout with [BalanceValueMixin] {}

/// Funds committed to in-flight or unresolved refunds.
structure BalanceHoldsrefund with [BalanceValueMixin] {}

/// The latest GHS balance snapshot for the application.
structure BalanceSnapshot {
    @required
    ghs: CurrencyBalanceSnapshot
}

structure BalanceSnapshotResponse {
    @required
    balances: BalanceSnapshot
}

@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/completed_at",
                    "/updated_at"
                ]
            }
        },
        {
            "equal": {
                "paths": [
                    "/completed_at",
                    "/updated_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/completed_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "pending",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/completed_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "equals": "completed",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": "completed",
                            "path": "/status"
                        }
                    ]
                },
                "when": {
                    "path": "/completed_at",
                    "state": "non-null"
                }
            }
        }
    ]
)
structure BalanceTransactionAllocationBase {
    /// When the allocated amount became permanently consumed. Present only when `status` is `completed`.
    @timestampFormat("date-time")
    completed_at: Timestamp
    /// When the amount first became unavailable for another refund or payout.
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    /// Stable public allocation identifier for reconciliation and support.
    @dataExamples([
    {
        "json": "bta_0123456789abcdefghijklmnopqrstuvwxyzABCD"
    }
])
    @pattern("^bta_")
    @required
    id: String
    @required
    status: BalanceTransactionAllocationStatus
    @required
    type: BalanceTransactionAllocationBasetype
    /// When the public allocation status last changed.
    @required
    @timestampFormat("date-time")
    updated_at: Timestamp
}

structure BalanceTransactionAmount with [BalanceTransactionAmountMixin] {}

@mixin
structure BalanceTransactionAmountMixin {
    /// Currency code as stored on the transaction
    @dataExamples([
    {
        "json": "GHS"
    }
])
    @required
    currency: String
    /// Unsigned amount in the currency's smallest unit
    @dataExamples([
    {
        "json": 20000
    }
])
    @range(
        min: 0
    )
    @required
    value: Integer
}

structure BalanceTransactionBase {
    @required
    amount: BalanceTransactionAmount
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @dataExamples([
    {
        "json": "bt_0123456789abcdefghijklmnopqrstuvwxyzABCD"
    }
])
    @pattern("^bt_")
    @required
    id: String
    @required
    type: BalanceTransactionBasetype
}

