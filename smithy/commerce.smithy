    {
        "json": 1
    }
])
    @range(
        min: 1
        max: 10
    )
    page_number: Integer
    /// Number of chimes to return
    @dataExamples([
    {
        "json": 25
    }
])
    @range(
        min: 1
        max: 256
    )
    page_size: Integer
    /// Restrict the page to chimes whose recipient exactly matches this phone number or email address
    @dataExamples([
    {
        "json": "+233544998605"
    }
])
    recipient: String
}

