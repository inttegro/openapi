@simileSchema(
{
        "additionalProperties": false,
        "allOf": [
            {
                "not": {
                    "properties": {
                        "token_alphabet": {},
                        "token_alphabet_type": {}
                    },
                    "required": [
                        "token_alphabet",
                        "token_alphabet_type"
                    ]
                }
            }
        ],
        "properties": {
            "async_delivery": {
                "default": false,
                "description": "Return after accepting the transaction while delivery continues asynchronously.",
                "type": "boolean"
            },
            "message_template": {
                "description": "SMS body or email copy containing the required `{token}` placeholder and optional `{service}` placeholder. Email templates must contain `{token}` exactly once. A custom template replaces the purpose-specific default body, while `purpose` still controls the email subject and heading. Email sends this as the plain-text fallback and renders the copy around a prominent code in the HTML version. Defaults are transport-specific.",
                "example": "Your {service} code is {token}.",
                "type": "string"
            },
            "purpose": {
                "shape": "OTPPurpose"
            },
            "recipient": {
                "description": "Phone number in international format (E.164) or bare email address. Transport is inferred from the address unless specified.",
                "example": "+233241234567",
                "type": "string"
            },
            "sender": {
                "description": "Optional SMS sender identifier (3-12 characters). Email OTP always uses `{service_name} <noreply@inttegro.com>`; omit this field for email or supply exactly the bare `noreply@inttegro.com` address.",
                "example": "Acme",
                "type": "string"
            },
            "service_name": {
                "description": "Service name substituted for `{service}` (2-20 characters).",
                "example": "Acme Bank",
                "maxLength": 20,
                "minLength": 2,
                "type": "string"
            },
            "token_alphabet": {
                "description": "Custom alphabet for token generation (mutually exclusive with token_alphabet_type)",
                "example": "0123456789ABCDEF",
                "type": "string"
            },
            "token_alphabet_type": {
                "description": "Predefined alphabet type (mutually exclusive with token_alphabet)",
                "enum": [
                    "numeric",
                    "alpha",
                    "alphanumeric"
                ],
                "example": "numeric",
                "type": "string"
            },
            "token_size": {
                "description": "Length of generated token (5-10 characters)",
                "example": 6,
                "maximum": 10,
                "minimum": 5,
                "type": "integer"
            },
            "transport": {
                "description": "Optional delivery transport. When omitted, an email address selects email and a phone number selects SMS.",
                "enum": [
                    "sms",
                    "email"
                ],
                "type": "string"
            },
            "validity_duration_in_minutes": {
                "description": "How long the token remains valid (3-10080 minutes)",
                "example": 10,
                "maximum": 10080,
                "minimum": 3,
                "type": "integer"
            }
        },
        "required": [
            "purpose",
            "recipient",
            "service_name",
            "token_size"
        ],
        "type": "object"
    }
)
structure InitiateOTPRequest {
    /// Return after accepting the transaction while delivery continues asynchronously.
    async_delivery: Boolean
    /// SMS body or email copy containing the required `{token}` placeholder and optional `{service}` placeholder. Email templates must contain `{token}` exactly once. A custom template replaces the purpose-specific default body, while `purpose` still controls the email subject and heading. Email sends this as the plain-text fallback and renders the copy around a prominent code in the HTML version. Defaults are transport-specific.
    @dataExamples([
    {
        "json": "Your {service} code is {token}."
    }
])
    message_template: String
    @required
    purpose: OTPPurpose
    /// Phone number in international format (E.164) or bare email address. Transport is inferred from the address unless specified.
    @dataExamples([
    {
        "json": "+233241234567"
    }
])
    @required
    recipient: String
    /// Optional SMS sender identifier (3-12 characters). Email OTP always uses `{service_name} <noreply@inttegro.com>`; omit this field for email or supply exactly the bare `noreply@inttegro.com` address.
    @dataExamples([
    {
        "json": "Acme"
    }
])
    sender: String
    /// Service name substituted for `{service}` (2-20 characters).
    @dataExamples([
    {
        "json": "Acme Bank"
    }
])
    @length(
        min: 2
        max: 20
    )
    @required
    service_name: String
    /// Custom alphabet for token generation (mutually exclusive with token_alphabet_type)
    @dataExamples([
    {
        "json": "0123456789ABCDEF"
    }
])
    token_alphabet: String
    token_alphabet_type: InitiateOTPRequesttokenAlphabetType
    /// Length of generated token (5-10 characters)
    @dataExamples([
    {
        "json": 6
    }
])
    @range(
        min: 5
        max: 10
    )
    @required
    token_size: Integer
    transport: InitiateOTPRequesttransport
    /// How long the token remains valid (3-10080 minutes)
    @dataExamples([
    {
        "json": 10
    }
])
    @range(
        min: 3
        max: 10080
    )
    validity_duration_in_minutes: Integer
}

structure InitiateOTPResponse {
    @required
    transaction: OTPTransaction
}

