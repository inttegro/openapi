    /// First address line.
    @dataExamples([
    {
        "json": "1 High Street"
    }
])
    line1: String
    /// Second address line.
    @dataExamples([
    {
        "json": "Osu"
    }
])
    line2: String
    /// Recipient name for the address, if different from owner name.
    @dataExamples([
    {
        "json": "Jane Mensah"
    }
])
    name: String
    /// Phone number for the address.
    @dataExamples([
    {
        "json": "+233201234567"
    }
])
    phone_number: String
    /// Postal or ZIP code.
    @dataExamples([
    {
        "json": "GA-123-4567"
    }
])
    post_code: String
    /// Region, state, or province.
    @dataExamples([
    {
        "json": "Greater Accra"
    }
])
    region: String
}

structure UpdatePaymentMethodResponse {
    @required
    payment_method: PaymentMethodObject
}

