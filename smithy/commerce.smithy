)
structure PricePageResponsepage {
    /// The page number returned
    @required
    number: Integer
    /// The number of prices in this page
    @required
    size: Integer
    @required
    prices: PricePageResponsepageprices
}

/// An inline price supplied in a request.
structure PriceParams with [
    AmountParamsMixin
    PriceParamsMixin
] {}

apply PriceParams$currency @required

apply PriceParams$value {
    @dataExamples([
    {
        "json": 20000
    }
])
    @documentation("Amount in smallest currency unit (e.g., pesewas for GHS)")
    @range(
        min: 0
    )
    @required
}

/// An inline price supplied in a request.
@mixin
structure PriceParamsMixin with [AmountParamsMixin] {}

structure PriceResponse {
    @required
    price: CatalogPrice
}

