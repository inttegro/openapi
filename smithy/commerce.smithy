                                }
                            ]
                        }
                    },
                    {
                        "then": {
                            "omit": [
                                "/product/published_at"
                            ],
                            "set": {
                                "/product/active": false
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "default": false,
                                    "equals": false,
                                    "request": "/publish"
                                }
                            ]
                        }
                    }
                ]
