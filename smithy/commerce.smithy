/// OTP transaction object returned by initiate, verify, and lookup endpoints
@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/initiated_at",
                    "/expires_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/initiated_at",
                    "/canceled_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/initiated_at",
                    "/transmission/sent_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/canceled_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "equals": "canceled",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": "canceled",
                            "path": "/status"
                        }
                    ]
                },
                "when": {
                    "path": "/canceled_at",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/transmission",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/cancel_reason",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "pending_delivery",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/transmission",
                            "state": "non-null"
                        },
                        {
                            "path": "/transmission/sent_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/cancel_reason",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "pending",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/transmission",
                            "state": "non-null"
                        },
                        {
                            "path": "/transmission/sent_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/cancel_reason",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "pending_verification",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/cancel_reason",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "verified",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/cancel_reason",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "expired",
                    "path": "/status"
                }
            }
        }
    ]
)
structure OTPTransaction {
    /// Omitted unless the transaction was canceled.
    cancel_reason: String
    /// Omitted unless the transaction was canceled.
    @timestampFormat("date-time")
    canceled_at: Timestamp
    @required
    @timestampFormat("date-time")
    expires_at: Timestamp
    /// Message text with the `{token}` placeholder preserved; no generated token is returned.
    @dataExamples([
    {
        "json": "Your Acme Bank code is {token}."
    }
])
    @required
    full_message: String
    /// Unique identifier with ot_ prefix
    @dataExamples([
    {
        "json": "ot_3f8a9c7e2d1b4a6f"
    }
])
    @pattern("^ot_")
    @required
    id: String
    @required
    @timestampFormat("date-time")
    initiated_at: Timestamp
    @required
    status: OTPTransactionstatus
    transmission: OTPTransmission
}

structure OTPTransmission {
    @dataExamples([
    {
        "json": "+233241234567"
    }
])
    @required
    recipient: String
    /// SMS sender identifier or approved email From address.
    @dataExamples([
    {
        "json": "Acme"
    }
])
    @required
    sender_id: String
    @timestampFormat("date-time")
    sent_at: Timestamp
    sent_via: OTPTransmissionsentVia
    status: OTPTransmissionstatus
}

/// Details of a verification attempt
structure OTPVerificationAttempt {
    @required
    @timestampFormat("date-time")
    attempted_at: Timestamp
    @dataExamples([
    {
        "json": "ov_9e8d7c6b5a4f3e2d"
    }
])
    @pattern("^ov_")
    @required
    id: String
    /// Token submitted for this verification attempt.
    @required
    presented_token: String
    @required
    recipient: String
    @required
    result: OTPVerificationAttemptresult
}

structure OTPVerificationAttemptresult {
    /// Omitted when no detail is available.
    detail: String
    @required
    verdict: OTPVerificationAttemptresultverdict
}

