                "type": "string"
            },
            "customer_selected_amount": {
                "shape": "CustomerSelectedAmount"
            },
            "id": {
                "description": "Unique price identifier with pr_ prefix",
                "example": "pr_xyz789",
                "pattern": "^pr_",
                "type": "string"
            },
            "label": {
                "description": "Short label for this price",
                "example": "Standard pricing",
                "type": [
                    "string",
                    "null"
                ]
            },
            "product": {
                "allOf": [
                    {
                        "shape": "PriceEmbeddedProduct"
                    }
                ],
                "description": "Embedded product details, if this price belongs to a product",
                "type": [
                    "object",
                    "null"
                ]
            },
            "product_id": {
                "description": "Product ID when the operation returns the relationship by reference",
                "example": "prod_abc123",
                "pattern": "^prod_",
                "type": "string"
            },
            "type": {
                "enum": [
                    "customer_selected_amount"
                ],
                "type": "string"
            },
            "updated_at": {
                "description": "Last update timestamp",
                "example": "2024-01-20T14:45:00Z",
                "format": "date-time",
                "type": [
                    "string",
                    "null"
                ]
            }
        },
        "required": [
            "id",
            "active",
            "type",
            "created_at",
            "customer_selected_amount"
        ],
        "simileConstraints": [
            {
                "ordered": {
                    "paths": [
                        "/created_at",
                        "/updated_at"
                    ]
                }
            },
            {
                "ordered": {
                    "paths": [
                        "/created_at",
                        "/archived_at"
                    ]
                }
            },
            {
                "implies": {
                    "then": {
                        "all": [
                            {
                                "path": "/archived_at",
                                "state": "null-or-absent"
                            }
                        ]
                    },
                    "when": {
                        "equals": true,
                        "path": "/active"
                    }
                }
            }
        ],
        "type": "object"
    }
)
