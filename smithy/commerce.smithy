/// Creates and activates a new immutable version of an operating policy. Supply the
/// current `expected_version` to prevent lost updates. This feature is available to
/// selected accounts during private beta.
///
@http(
    method: "POST"
    uri: "/operating_policies/update"
    code: 200
)
@tags([
    "Operating Policies"
])
@responseRelations(
{
        "200": {
            "application/json": {
                "bindings": [
                    {
                        "from": "/operating_policy_id",
                        "to": "/operating_policy/id"
                    },
                    {
                        "from": "/capabilities/payments/currencies",
                        "to": "/operating_policy/capabilities/payments/currencies"
                    },
                    {
                        "from": "/capabilities/payments/limits",
                        "to": "/operating_policy/capabilities/payments/limits"
                    },
                    {
                        "from": "/capabilities/payment_methods",
                        "to": "/operating_policy/capabilities/payment_methods"
                    },
                    {
                        "from": "/capabilities/payouts/enabled",
                        "to": "/operating_policy/capabilities/payouts/enabled"
                    },
                    {
                        "from": "/capabilities/payouts/limits",
                        "to": "/operating_policy/capabilities/payouts/limits"
                    },
                    {
                        "from": "/capabilities/payouts/bt_aging_spec/id",
                        "to": "/operating_policy/capabilities/payouts/bt_aging_spec/id"
                    },
                    {
                        "from": "/description",
                        "to": "/operating_policy/description"
                    },
                    {
                        "from": "/name",
                        "to": "/operating_policy/name"
                    },
                    {
                        "to": "/operating_policy/version",
                        "value": {
                            "add": [
                                {
                                    "request": "/expected_version"
                                },
                                {
                                    "literal": 1
                                }
                            ]
                        }
                    },
                    {
                        "to": "/operating_policy/active_version",
                        "value": {
                            "add": [
                                {
                                    "request": "/expected_version"
                                },
                                {
                                    "literal": 1
                                }
                            ]
                        }
                    }
                ],
                "rules": [
                    {
                        "then": {
                            "set": {
                                "/operating_policy/capabilities/payouts/bt_aging_spec/t_plus": "0h"
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "equals": "bt_aging_spec_immediate",
                                    "request": "/capabilities/payouts/bt_aging_spec/id"
                                }
                            ]
                        }
                    },
                    {
                        "then": {
                            "set": {
                                "/operating_policy/capabilities/payouts/bt_aging_spec/t_plus": "24h"
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "equals": "bt_aging_spec_24_hourly",
                                    "request": "/capabilities/payouts/bt_aging_spec/id"
                                }
                            ]
                        }
                    },
                    {
                        "then": {
                            "set": {
                                "/operating_policy/capabilities/payouts/bt_aging_spec/t_plus": "48h"
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "equals": "bt_aging_spec_48_hourly",
                                    "request": "/capabilities/payouts/bt_aging_spec/id"
                                }
                            ]
                        }
                    },
                    {
                        "then": {
                            "set": {
                                "/operating_policy/capabilities/payouts/bt_aging_spec/t_plus": "168h"
                            }
                        },
                        "when": {
                            "all": [
                                {
                                    "equals": "bt_aging_spec_168_hourly",
                                    "request": "/capabilities/payouts/bt_aging_spec/id"
                                }
                            ]
                        }
                    }
                ]
            }
        }
    }
)
operation updateOperatingPolicy {
    input: updateOperatingPolicyInput
    output: updateOperatingPolicy200
    errors: [
        updateOperatingPolicy400
        updateOperatingPolicy401
        updateOperatingPolicy403
        updateOperatingPolicy404
        updateOperatingPolicy409
        updateOperatingPolicy422
        updateOperatingPolicy503
    ]
}

/// Updates mutable fields on an existing order and returns the same response shape as
/// `/orders/lookup`.
///
/// Use this endpoint to replace the order's full line item set, update the order number,
/// receipt number, invoice settings, or statement descriptor, replace order-level `custom_data`,
/// switch to a different saved payment method, tokenize a new payment method, clear the current
/// payment method, or explicitly open, seal, or reseal the order via `finalize`.
///
/// `line_items` is a full replacement field, not a sparse merge. `payment_method_id`,
/// `payment_method_data`, and `clear_payment_method` are mutually exclusive. `custom_data`
/// is metadata-only and does not require reopen or reseal by itself. Completed, paid,
/// canceled, and expired orders cannot be updated.
///
/// When mutating seal-sensitive fields on a sealed order, set `finalize: false` to
/// reopen the order and leave it editable, or set `finalize: true` to apply the changes
/// and reseal in the same request. If payment confirmation or execution has already
/// started, Inttegro rejects edits that would change the order's economics or payment
/// configuration.
///
@http(
    method: "POST"
    uri: "/orders/update"
    code: 200
)
@tags([
    "Orders"
])
@responseRelations(
{
        "200": {
            "application/json": {
                "bindings": [
                    {
                        "from": "/order_id",
                        "to": "/order/id"
                    },
                    {
                        "from": "/custom_data",
                        "to": "/order/custom_data"
                    },
                    {
                        "from": "/invoice_settings",
                        "to": "/order/invoice_settings"
                    },
                    {
                        "from": "/line_items",
                        "to": "/order/line_item_group/line_items"
                    },
                    {
                        "from": "/number",
                        "to": "/order/number"
                    },
                    {
                        "from": "/payment_method_id",
                        "to": "/order/payment/payment_method/id"
                    },
                    {
                        "from": "/receipt_number",
                        "to": "/order/receipt_number"
                    },
                    {
                        "from": "/statement_descriptor",
                        "to": "/order/payment/statement_descriptor"
                    }
                ],
                "rules": [
                    {
                        "then": {
                            "omit": [
                                "/order/payment/payment_method"
                            ]
                        },
                        "when": {
                            "all": [
                                {
                                    "default": false,
                                    "equals": true,
                                    "request": "/clear_payment_method"
                                }
                            ]
                        }
                    }
                ]
            }
        }
    }
)
operation updateOrder {
    input: updateOrderInput
    output: updateOrder200
    errors: [
        updateOrder400
        updateOrder401
    ]
}

/// Update mutable payment method metadata for the authenticated
/// application.
///
/// Supported updates:
/// - `custom_data` merges into existing metadata
/// - `owner` applies patch semantics and updates only the
///   provided owner fields
/// - `active` toggles whether the payment method can be reused
/// - `archived` archives or unarchives the payment method
///
/// **Custom Data Merge Semantics:**
/// - New keys are added to existing custom_data
/// - Existing keys are updated with new values
/// - JSON null explicitly deletes the key
/// - Keys not present in the update are preserved
///
/// When adding a new owner address to a payment method that does
/// not already have one, `owner.address.country` is required.
///
/// Archived payment methods reject all updates except a pure
/// unarchive request. Unarchiving leaves the payment method
/// inactive until you activate it again.
///
@http(
    method: "POST"
    uri: "/payment_methods/update"
    code: 200
)
@tags([
    "Payment Methods"
])
@responseRelations(
{
        "200": {
            "application/json": {
                "bindings": [
                    {
                        "from": "/payment_method_id",
                        "to": "/payment_method/id"
                    },
                    {
                        "from": "/active",
                        "to": "/payment_method/active"
                    },
                    {
                        "from": "/custom_data",
                        "to": "/payment_method/custom_data"
                    },
                    {
                        "from": "/owner",
                        "to": "/payment_method/owner"
                    }
                ],
                "rules": [
                    {
                        "then": {
                            "omit": [
                                "/payment_method/archived_at"
                            ]
                        },
                        "when": {
                            "all": [
                                {
                                    "equals": false,
                                    "request": "/archived"
                                }
                            ]
                        }
                    }
                ]
            }
        }
    }
)
operation updatePaymentMethod {
    input: updatePaymentMethodInput
    output: updatePaymentMethod200
    errors: [
        updatePaymentMethod400
        updatePaymentMethod401
        updatePaymentMethod404
    ]
}

