structure OrderPaymentMethod {
    @pattern("^pm_")
    @required
    id: String
    bank_account: OrderPaymentMethodbankAccount
    card: PaymentMethodCard
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @pattern("^cu_")
    @required
    customer_id: String
    mobile_money: OrderPaymentMethodmobileMoney
    owner: OrderPaymentMethodowner
    @required
    type: OrderPaymentMethodtype
    @required
    verified: Boolean
    @timestampFormat("date-time")
    verified_at: Timestamp
}

structure OrderPaymentMethodbankAccount {
    @required
    type: String
    ghana_bank_account: OrderPaymentMethodbankAccountghanaBankAccount
}

structure OrderPaymentMethodbankAccountghanaBankAccount {
    @required
    account_number: String
    branch: String
    name: String
    sort_code: String
    swift_code: String
}

structure OrderPaymentMethodmobileMoney {
    @required
    network: OrderPaymentMethodmobileMoneynetwork
    /// Masked number in the form `****1234`.
    @length(
        min: 8
        max: 8
    )
    @required
    account_number: String
    @length(
        min: 4
        max: 4
    )
    @required
    last4: String
}

structure OrderPaymentMethodowner {
    @required
    name: String
    address: OrderAddress
}

/// Payout configuration for this payment
structure OrderpaymentpayoutConfiguration {
    /// Compatibility flag. Cross-currency payout execution is not currently available.
    @dataExamples([
    {
        "json": false
    }
])
    @required
    enable_fx: Boolean
    @required
    destination: OrderpaymentpayoutConfigurationdestination
}

/// Where the funds will be paid out
structure OrderpaymentpayoutConfigurationdestination {
    /// ID of the financial account receiving the payout
    @dataExamples([
    {
        "json": "fa_1234567890abcdef"
    }
])
    @pattern("^fa_")
    @required
    financial_account_id: String
}

structure OrderPayoutSettingsRequest {
    destination: OrderPayoutSettingsRequestdestination
    /// Omit this field or set it to false. Cross-currency payouts are not currently available.
    enable_fx: Boolean
}

structure OrderPayoutSettingsRequestdestination {
    /// Same-currency financial account with push capability enabled
    @required
    financial_account_id: String
}

structure OrderProductLineItem {
    @required
    product: OrderProductLineItemproduct
}

structure OrderProductLineItemproduct {
    /// Immutable order-line identifier with the `oli_` prefix.
    @dataExamples([
    {
        "json": "oli_7QYpB8c3V9kL2nM4"
    }
])
    @pattern("^oli_")
    @required
    id: String
    /// Source catalog product ID when this line snapshots a catalog product.
    @pattern("^prod_")
    product_id: String
    /// Source catalog price ID when this line snapshots a saved price.
    @pattern("^pr_")
    price_id: String
    reference: String
    about: String
    custom_data: CustomData
    tax_code: String
    @required
    name: String
    category: String
    type: String
    @required
    price: Price
    @range(
        min: 1
    )
    @required
    quantity: Integer
}

/// Receipt issued for a paid order payment.
structure OrderReceipt {
    number: String
    delivery_summary: OrderDocumentDeliverySummary
    @required
    format: OrderReceiptformat
}

structure OrderReceiptformat {
