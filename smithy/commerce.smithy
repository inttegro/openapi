structure PaymentNextAction {
    @required
    type: PaymentNextActiontype
    confirm_payment: PaymentNextActionconfirmPayment
    redirect: PaymentNextActionredirect
    authorize: PaymentNextActionauthorize
    request_confirmation: PaymentNextActionrequestConfirmation
}

/// Details for authorization action
structure PaymentNextActionauthorize {
    /// Beneficiary requiring authorization
    @required
    beneficiary: String
    /// Authorization scheme
    @required
    scheme: String
    /// When the authorization request expires
    @required
    @timestampFormat("date-time")
    expires_at: Timestamp
}

/// Details for customer payment confirmation
structure PaymentNextActionconfirmPayment {
    /// When the confirmation request expires
    @dataExamples([
    {
        "json": "2025-10-24T21:16:11.917533316Z"
    }
])
    @required
    @timestampFormat("date-time")
    expires_at: Timestamp
    /// Authentication scheme used
    @dataExamples([
    {
        "json": "inttegro_defined_auth"
    }
])
    @required
    scheme: String
    request: PaymentNextActionconfirmPaymentrequest
    attempt: PaymentNextActionconfirmPaymentattempt
    /// Whether the payment confirmation has completed
    @dataExamples([
    {
        "json": false
    }
])
    @required
    confirmed: Boolean
    /// Confirmation status
    @dataExamples([
    {
        "json": "pending"
    }
])
    @required
    status: String
}

/// Latest confirmation attempt
structure PaymentNextActionconfirmPaymentattempt {
    /// Attempt status
    @dataExamples([
    {
        "json": "pending"
    }
])
    @required
    status: String
    /// Whether the confirmation has succeeded
    @dataExamples([
    {
        "json": false
    }
])
    @required
    confirmed: Boolean
    /// Reason for the current attempt state
    @dataExamples([
    {
        "json": "awaiting_customer_confirmation"
    }
])
    @required
    reason: String
    /// When the attempt was executed
    @timestampFormat("date-time")
    executed_at: Timestamp
    /// When the attempt was created
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
}

/// Confirmation request details
structure PaymentNextActionconfirmPaymentrequest {
    /// Unique identifier for the confirmation request
    @dataExamples([
    {
        "json": "Jmjup0uRSVI2LvllHfdJ"
    }
])
    @required
    id: String
    /// Recipient of the confirmation token
    @dataExamples([
    {
        "json": "0242057831"
    }
])
    @required
    recipient: String
    @required
    sent_via: PaymentNextActionconfirmPaymentrequestsentVia
    /// Number of digits in the token
    @dataExamples([
    {
        "json": 6
    }
])
    @required
    token_size: Integer
    /// Sender ID for the message
    @dataExamples([
    {
        "json": "zverify"
    }
])
    @required
    sender_id: String
    /// Current request status
    status: String
}

/// Details for redirect action
structure PaymentNextActionredirect {
    /// URL to redirect the customer to
    @dataExamples([
    {
        "json": "https://pages.inttegro.com/authorize?order_id=3deNYydEjIGCqK1tGlAPwJYSCsZnQ4XGF"
    }
])
    @required
    redirect_url: String
    /// When the redirect URL expires
    @required
    @timestampFormat("date-time")
    valid_until: Timestamp
    latest_visit: PaymentNextActionredirectlatestVisit
}

/// Latest redirect visit details
structure PaymentNextActionredirectlatestVisit {
    @required
    user_agent: String
    @required
    ip_address: String
    @required
    @timestampFormat("date-time")
    at: Timestamp
}

/// Details for requesting a fresh customer confirmation.
structure PaymentNextActionrequestConfirmation {
    last_request: PaymentNextActionrequestConfirmationlastRequest
    @timestampFormat("date-time")
    after: Timestamp
}

structure PaymentNextActionrequestConfirmationlastRequest {
    @required
    id: String
    @required
    recipient: String
    @required
    sent_via: PaymentNextActionrequestConfirmationlastRequestsentVia
    @required
    token_size: Integer
    @required
    sender_id: String
    status: String
}

/// New mobile-money payment method details supplied while paying an order.
structure PayOrderPaymentMethodData {
    @required
    type: PayOrderPaymentMethodDatatype
    @required
    mobile_money: PaymentMethodMobileMoneyInput
    billing_details: PaymentMethodBillingDetailsInput
    shipping: PaymentMethodShippingInput
}

@simileSchema(
{
        "additionalProperties": false,
        "allOf": [
            {
                "not": {
                    "properties": {
                        "payment_method_data": {},
                        "payment_method_id": {}
                    },
                    "required": [
                        "payment_method_id",
                        "payment_method_data"
                    ]
                }
            },
            {
                "not": {
                    "properties": {
                        "paid_out_of_band": {
                            "enum": [
                                true
                            ]
                        },
                        "payment_method_id": {}
                    },
                    "required": [
                        "paid_out_of_band",
                        "payment_method_id"
                    ]
                }
            },
            {
                "not": {
                    "properties": {
                        "paid_out_of_band": {
                            "enum": [
                                true
                            ]
                        },
                        "payment_method_data": {}
                    },
                    "required": [
                        "paid_out_of_band",
                        "payment_method_data"
                    ]
                }
            },
            {
                "anyOf": [
                    {
                        "not": {
                            "properties": {
                                "payment_method_data": {},
                                "save_payment_method": {
                                    "enum": [
                                        true
                                    ]
                                }
                            },
                            "required": [
                                "save_payment_method",
                                "payment_method_data"
                            ]
                        }
                    },
                    {
                        "properties": {
                            "payment_method_data": {
                                "additionalProperties": true,
                                "properties": {
                                    "billing_details": {}
                                },
                                "required": [
                                    "billing_details"
                                ],
                                "type": "object"
                            }
                        }
                    }
                ]
            }
        ],
        "properties": {
            "order_id": {
                "description": "Unique identifier of the order to pay",
                "example": "or_GKj7A8lM5wEGRUvbqpI4bkDFsQvpqVyh5fqePNnb",
                "pattern": "^or_",
                "type": "string"
            },
            "paid_out_of_band": {
                "default": false,
                "description": "Set to true if payment was received outside Inttegro (cash, bank transfer, check).\nMarks the payment as paid offline. Mutually exclusive with payment_method_id and\npayment_method_data. Defaults to false.\n",
                "example": false,
                "type": "boolean"
            },
            "payment_method_data": {
                "shape": "PayOrderPaymentMethodData"
            },
            "payment_method_id": {
                "description": "ID of a saved payment method to use for this payment",
                "example": "pm_xyz123abc456",
                "pattern": "^pm_",
                "type": "string"
            },
            "payment_method_types": {
                "description": "Payment method types to expose for this payment attempt.",
                "items": {
                    "shape": "PaymentMethodType"
                },
                "type": "array"
            },
            "save_payment_method": {
                "default": false,
                "description": "Save a newly supplied payment method. When true and payment_method_data is present, billing_details is required.",
                "type": "boolean"
            }
        },
        "required": [
            "order_id"
        ],
        "type": "object"
    }
)
structure PayOrderRequest {
    /// Unique identifier of the order to pay
    @dataExamples([
    {
        "json": "or_GKj7A8lM5wEGRUvbqpI4bkDFsQvpqVyh5fqePNnb"
    }
])
    @pattern("^or_")
    @required
    order_id: String
    payment_method_types: PayOrderRequestpaymentMethodTypes
    payment_method_data: PayOrderPaymentMethodData
    /// ID of a saved payment method to use for this payment
    @dataExamples([
    {
        "json": "pm_xyz123abc456"
    }
])
    @pattern("^pm_")
    payment_method_id: String
    /// Save a newly supplied payment method. When true and payment_method_data is present, billing_details is required.
    save_payment_method: Boolean
    /// Set to true if payment was received outside Inttegro (cash, bank transfer, check).
    /// Marks the payment as paid offline. Mutually exclusive with payment_method_id and
    /// payment_method_data. Defaults to false.
    ///
    @dataExamples([
    {
        "json": false
    }
])
    paid_out_of_band: Boolean
}

/// A payout scheduled from your Inttegro balance to a destination financial account
@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/initiated_at",
                    "/scheduled_at",
                    "/sent_at",
                    "/succeeded_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/initiated_at",
                    "/scheduled_at",
                    "/sent_at",
                    "/failed_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/initiated_at",
                    "/scheduled_at",
                    "/canceled_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/scheduled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/sent_at",
                            "state": "absent"
                        },
                        {
                            "path": "/succeeded_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failure",
                            "state": "absent"
                        },
                        {
                            "path": "/cancellation",
                            "state": "absent"
                        },
                        {
                            "path": "/error",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "initialized",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/scheduled_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/sent_at",
                            "state": "absent"
                        },
                        {
                            "path": "/succeeded_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failure",
                            "state": "absent"
                        },
                        {
                            "path": "/cancellation",
                            "state": "absent"
                        },
                        {
                            "path": "/error",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "scheduled",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/sent_at",
                            "state": "absent"
                        },
                        {
                            "path": "/succeeded_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failure",
                            "state": "absent"
                        },
                        {
                            "path": "/cancellation",
                            "state": "absent"
                        },
                        {
                            "path": "/error",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "executing",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/sent_at",
                            "state": "non-null"
                        },
                        {
                            "path": "/succeeded_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failed_at",
                            "state": "absent"
                        },
                        {
                            "path": "/canceled_at",
                            "state": "absent"
                        },
                        {
                            "path": "/failure",
                            "state": "absent"
                        },
                        {
                            "path": "/cancellation",
                            "state": "absent"
                        },
                        {
                            "path": "/error",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
