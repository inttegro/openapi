/// Postal address for the payment method owner.
structure UpdatePaymentMethodRequestowneraddress {
    /// City or locality.
    @dataExamples([
    {
        "json": "Accra"
    }
])
    city: String
    /// Two-letter ISO country code. Required when adding a brand new owner address.
    @dataExamples([
    {
        "json": "GH"
    }
])
