    }
])
    @pattern("^(\\+?\\d{10,15})$")
    @required
    account_number: String
}

/// A tokenized payment instrument tied to a customer
@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/archived_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/verification/initiated_at",
                    "/verification/completed_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/supplied/supplied_at",
                    "/created_at"
                ]
            }
        },
        {
            "equal": {
                "paths": [
                    "/verified_at",
                    "/verification/completed_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/archived_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": true,
                    "path": "/active"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": false,
                            "path": "/active"
                        }
                    ]
                },
                "when": {
                    "path": "/archived_at",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/verification/completed_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "path": "/verified_at",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/verified_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "path": "/verification/completed_at",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/mobile_money",
                            "state": "non-null"
                        },
                        {
                            "path": "/bank_account",
                            "state": "absent"
                        },
                        {
                            "path": "/card",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "mobile_money",
                    "path": "/type"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/bank_account",
                            "state": "non-null"
                        },
                        {
                            "path": "/mobile_money",
                            "state": "absent"
                        },
                        {
                            "path": "/card",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "bank_account",
                    "path": "/type"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/mobile_money",
                            "state": "absent"
                        },
                        {
                            "path": "/bank_account",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "card",
                    "path": "/type"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/mobile_money",
                            "state": "absent"
                        },
                        {
                            "path": "/bank_account",
                            "state": "absent"
                        },
                        {
                            "path": "/card",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "motito",
                    "path": "/type"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": "mobile_money",
                            "path": "/type"
                        }
                    ]
                },
                "when": {
                    "path": "/mobile_money",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": "bank_account",
                            "path": "/type"
                        }
                    ]
                },
                "when": {
                    "path": "/bank_account",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": "card",
                            "path": "/type"
                        }
                    ]
                },
                "when": {
                    "path": "/card",
                    "state": "non-null"
                }
            }
        }
    ]
)
structure PaymentMethodObject with [PaymentMethodObjectMixin] {}

/// Bank account details (present when type is bank_account)
structure PaymentMethodObjectbankAccount {
    ghana_bank_account: PaymentMethodObjectbankAccountghanaBankAccount
    @required
    type: PaymentMethodObjectbankAccounttype
}

/// Ghana bank account details
structure PaymentMethodObjectbankAccountghanaBankAccount {
    /// Branch name
    @dataExamples([
    {
        "json": "Accra Main"
    }
])
    branch: String
    /// Account holder name
    @dataExamples([
    {
        "json": "John Doe"
    }
])
    name: String
    /// Account number
    @dataExamples([
    {
        "json": "1234567890"
    }
])
    @required
    account_number: String
    /// Bank sort code
    @dataExamples([
    {
        "json": "030100"
    }
])
    sort_code: String
    /// SWIFT/BIC code
    @dataExamples([
    {
        "json": "GHBAGHAACCRA"
    }
])
    swift_code: String
}

/// A tokenized payment instrument tied to a customer
@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/archived_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/verification/initiated_at",
                    "/verification/completed_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/supplied/supplied_at",
                    "/created_at"
                ]
            }
        },
        {
            "equal": {
                "paths": [
                    "/verified_at",
                    "/verification/completed_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/archived_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": true,
                    "path": "/active"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": false,
                            "path": "/active"
                        }
                    ]
                },
                "when": {
                    "path": "/archived_at",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/verification/completed_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "path": "/verified_at",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/verified_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "path": "/verification/completed_at",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/mobile_money",
                            "state": "non-null"
                        },
                        {
                            "path": "/bank_account",
                            "state": "absent"
                        },
                        {
                            "path": "/card",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "mobile_money",
                    "path": "/type"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/bank_account",
                            "state": "non-null"
                        },
                        {
                            "path": "/mobile_money",
                            "state": "absent"
                        },
                        {
                            "path": "/card",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "bank_account",
                    "path": "/type"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/mobile_money",
                            "state": "absent"
                        },
                        {
                            "path": "/bank_account",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "card",
                    "path": "/type"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "path": "/mobile_money",
                            "state": "absent"
                        },
                        {
                            "path": "/bank_account",
                            "state": "absent"
                        },
                        {
                            "path": "/card",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "motito",
                    "path": "/type"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": "mobile_money",
                            "path": "/type"
                        }
                    ]
                },
                "when": {
                    "path": "/mobile_money",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": "bank_account",
                            "path": "/type"
                        }
                    ]
                },
                "when": {
                    "path": "/bank_account",
                    "state": "non-null"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": "card",
                            "path": "/type"
                        }
                    ]
                },
                "when": {
                    "path": "/card",
                    "state": "non-null"
                }
            }
        }
    ]
)
@mixin
structure PaymentMethodObjectMixin {
    /// Whether this payment method is active and reusable in new payment flows
    @dataExamples([
    {
        "json": true
    }
])
    @required
    active: Boolean
    /// Timestamp when the payment method was archived. Omitted while unarchived.
    @timestampFormat("date-time")
    archived_at: Timestamp
    bank_account: PaymentMethodObjectbankAccount
    card: PaymentMethodCard
    /// When this payment method was tokenized
    @dataExamples([
    {
        "json": "2025-11-23T13:00Z"
    }
])
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    custom_data: CustomData
    /// Customer who owns this payment method
    @dataExamples([
    {
        "json": "cu_a1b2c3d4e5"
    }
])
    @pattern("^cu_")
    @required
    customer_id: String
    /// Whether the method is limited to its originating flow and cannot be reused.
    @dataExamples([
    {
        "json": false
    }
])
    ephemeral: Boolean
    /// When this payment method expires. Omitted when no expiry is available.
    @timestampFormat("date-time")
    expires_on: Timestamp
    /// Customer-scoped fingerprint for this payment method within the merchant application. Matching nonempty values for the same customer indicate the same underlying method was added more than once. May be empty for records awaiting fingerprint backfill or methods lacking reliable fingerprint material. It does not identify the method across customers or applications.
    @required
    fingerprint: String
    /// Unique identifier for this payment method
    @dataExamples([
    {
        "json": "pm_xyz789"
    }
])
    @pattern("^pm_")
    @required
    id: String
    mobile_money: PaymentMethodObjectmobileMoney
    owner: PaymentMethodObjectowner
    @required
    type: PaymentMethodObjecttype
    supplied: PaymentMethodObjectsupplied
    verification: PaymentMethodObjectverification
    /// When ownership verification was completed
    @dataExamples([
    {
        "json": "2025-11-23T13:07Z"
    }
])
    @timestampFormat("date-time")
    verified_at: Timestamp
}

/// Masked mobile-money wallet details (present when type is mobile_money)
@simileConstraints(
[
        {
            "template": {
                "path": "/account_number",
                "value": "****{/last4}"
            }
        }
    ]
)
structure PaymentMethodObjectmobileMoney {
    /// Masked wallet number. The full account number is never returned.
    @dataExamples([
    {
        "json": "****7831"
    }
])
    @length(
        min: 8
        max: 8
    )
    @required
    account_number: String
    /// Last four numeric digits of the normalized wallet number.
    @dataExamples([
    {
        "json": "7831"
    }
])
    @length(
        min: 4
        max: 4
    )
    @pattern("^[0-9]{4}$")
    @required
    last4: String
    @required
    network: PaymentMethodObjectmobileMoneynetwork
}

/// Owner identity captured during tokenization when provided
structure PaymentMethodObjectowner {
    address: PaymentMethodObjectowneraddress
    /// Owner full legal name
    @dataExamples([
    {
        "json": "Yaw Boakye"
    }
])
    @required
    name: String
}

/// Postal address for the owner when available
structure PaymentMethodObjectowneraddress {
    /// City or locality
    @dataExamples([
    {
        "json": "Accra"
    }
])
    city: String
    /// Two-letter ISO country code
    @dataExamples([
    {
        "json": "GH"
    }
])
    @required
    country: String
    /// First line of the street address
    @dataExamples([
    {
        "json": "1 High Street"
    }
])
    line_1: String
    /// Second line of the street address
    @dataExamples([
    {
        "json": "Osu"
    }
])
    line_2: String
    /// Recipient name at this address, if different from owner name
    @dataExamples([
    {
        "json": "Jane Mensah"
    }
])
    name: String
    /// Phone number for this address
    @dataExamples([
    {
        "json": "+233201234567"
    }
])
    phone_number: String
    /// Postal or ZIP code
    @dataExamples([
    {
        "json": "GA-123-4567"
    }
])
    post_code: String
    /// Region, state, or province
    @dataExamples([
    {
        "json": "Greater Accra"
    }
])
    region: String
}

/// Public provenance for how the payment method was supplied.
structure PaymentMethodObjectsupplied {
    attempt_id: String
    @required
    by: String
    channel: String
    resource_id: String
    resource_type: String
    @required
    @timestampFormat("date-time")
    supplied_at: Timestamp
}

/// Most recent verification record when the payment method has entered a verification flow.
structure PaymentMethodObjectverification {
    /// When verification was completed
    @dataExamples([
    {
        "json": "2025-11-23T13:07Z"
    }
])
    @timestampFormat("date-time")
    completed_at: Timestamp
    /// When verification was initiated
    @dataExamples([
    {
        "json": "2025-11-23T13:00Z"
    }
])
    @required
    @timestampFormat("date-time")
    initiated_at: Timestamp
    /// Verification mechanism used
    @dataExamples([
    {
        "json": "otp"
    }
])
    mechanism: String
    /// ID of the verification request
    @dataExamples([
    {
        "json": "req_abc123"
    }
])
    @required
    request_id: String
    /// Verification type
    @dataExamples([
    {
        "json": "sms_otp"
    }
])
    @required
    type: String
}

structure PaymentMethodOwnerInput {
    @required
    address: PaymentMethodOwnerInputaddress
    /// Payment method owner's name.
    @dataExamples([
    {
        "json": "Jane Mensah"
    }
])
    @length(
        min: 1
    )
    @required
    name: String
}

structure PaymentMethodOwnerInputaddress {
    city: String
    /// Country associated with the owner address.
    @dataExamples([
    {
        "json": "GH"
    }
])
    @length(
        min: 1
    )
    @required
    country: String
    line1: String
    line2: String
    name: String
    phone_number: String
    post_code: String
    region: String
}

structure PaymentMethodPageRequest {
    /// Optional customer ID to scope the page to a single customer
    @dataExamples([
    {
        "json": "cu_a1b2c3d4e5"
    }
])
    customer_id: String
    /// Page index to fetch. `0` is accepted and normalized to page 1; returned pages are numbered 1-10.
    @range(
        min: 0
        max: 10
    )
    page_number: Integer
    /// Number of payment methods per page (1-256)
    @range(
        min: 1
        max: 256
    )
    page_size: Integer
}

structure PaymentMethodPageResponse {
    @required
    page: PaymentMethodPageResponsepage
}

@simileConstraints(
[
        {
            "aggregate": {
                "operation": "count",
                "source": "/payment_methods/*",
                "target": "/size"
            }
        }
    ]
)
structure PaymentMethodPageResponsepage {
    /// The page number returned
    @required
    number: Integer
    @required
    payment_methods: PaymentMethodPageResponsepagepaymentMethods
    /// The number of payment methods in this page
    @required
    size: Integer
}

/// Payment method acceptance configuration for an application
structure PaymentMethodSettings {
    mobile_money: PaymentMethodTypeSetting
    bank_account: PaymentMethodTypeSetting
    card: PaymentMethodTypeSetting
    motito: PaymentMethodTypeSetting
}

structure PaymentMethodShippingInput {
    @required
    address: PaymentMethodShippingInputaddress
}

structure PaymentMethodShippingInputaddress {
    @required
    country: String
}

/// Settings for a specific payment method type
structure PaymentMethodTypeSetting {
    type: PaymentMethodTypeSettingtype
    /// Human-readable name
    @dataExamples([
    {
        "json": "Mobile Money"
    }
])
    name: String
    /// Description of this payment method
    @dataExamples([
    {
        "json": "Pay with supported mobile money wallets"
    }
])
    description: String
    /// Whether this payment type can be used
    @dataExamples([
    {
        "json": true
    }
])
    @required
    enabled: Boolean
    /// Whether customers must explicitly agree before using
    @dataExamples([
    {
        "json": true
    }
])
    @required
    confirms_use: Boolean
}

