                "shape": "PurchaseIntentPriceSelection"
            },
            "price_id": {
                "description": "Active, unarchived app-owned price ID. It must belong to a selected product; for a bundle it must be fixed and use the bundle catalog currency.",
                "example": "pr_xyz789",
                "pattern": "^pr_",
                "type": "string"
            },
            "product": {
                "shape": "PurchaseIntentProductSelection"
            },
            "product_id": {
                "description": "App-owned product ID to sell through the Buy link when not using product",
                "example": "prod_abc123",
                "pattern": "^prod_",
                "type": "string"
            },
            "quantity": {
                "additionalProperties": false,
                "description": "Quantity bounds the Buy link should enforce. Omit max when the Buy link has no upper quantity bound. When present, max must be greater than or equal to min.",
                "properties": {
                    "max": {
                        "description": "Optional maximum quantity the customer can buy. It must be greater than or equal to min.",
                        "example": 5,
                        "minimum": 1,
                        "type": "integer"
                    },
                    "min": {
                        "description": "Minimum quantity the customer can buy",
                        "example": 1,
                        "minimum": 1,
                        "type": "integer"
                    }
                },
                "required": [
                    "min"
                ],
                "simileConstraints": [
                    {
                        "bounded": {
                            "minimum": {
                                "path": "/min"
                            },
                            "path": "/max"
                        }
                    }
                ],
                "type": "object"
            },
            "usage": {
                "additionalProperties": false,
                "description": "Optional link-use policy. Omit to create a reusable Buy link.",
                "not": {
                    "properties": {
                        "multi_use": {},
                        "single_use": {}
                    },
                    "required": [
                        "single_use",
                        "multi_use"
                    ]
                },
                "properties": {
                    "multi_use": {
                        "description": "The Buy link may create multiple orders",
                        "example": true,
                        "type": "boolean"
                    },
                    "single_use": {
                        "description": "Creating the first order consumes the Buy link",
                        "example": true,
                        "type": "boolean"
                    }
                },
                "type": "object"
            }
        },
        "required": [
            "quantity"
        ],
        "type": "object"
    }
)
structure CreatePurchaseIntentRequest {
    product: PurchaseIntentProductSelection
    /// App-owned product ID to sell through the Buy link when not using product
    @dataExamples([
    {
        "json": "prod_abc123"
    }
])
    @pattern("^prod_")
    product_id: String
    bundle: PurchaseIntentBundleSelection
    /// App-owned bundle ID to sell through the Buy link when not using bundle
    @dataExamples([
    {
        "json": "pbd_abc123"
    }
])
    @pattern("^pbd_")
    bundle_id: String
    price: PurchaseIntentPriceSelection
    /// Active, unarchived app-owned price ID. It must belong to a selected product; for a bundle it must be fixed and use the bundle catalog currency.
    @dataExamples([
    {
        "json": "pr_xyz789"
    }
])
    @pattern("^pr_")
    price_id: String
    @required
    quantity: CreatePurchaseIntentRequestquantity
    usage: CreatePurchaseIntentRequestusage
    /// Future RFC3339 timestamp after which the Buy link stops accepting purchases
    @dataExamples([
    {
        "json": "2030-12-01T09:00Z"
    }
])
    @timestampFormat("date-time")
    expires_at: Timestamp
    presentation: CreatePurchaseIntentPresentation
}

/// Quantity bounds the Buy link should enforce. Omit max when the Buy link has no upper quantity bound. When present, max must be greater than or equal to min.
@simileConstraints(
[
        {
            "bounded": {
                "minimum": {
                    "path": "/min"
                },
                "path": "/max"
            }
        }
    ]
)
structure CreatePurchaseIntentRequestquantity {
    /// Minimum quantity the customer can buy
    @dataExamples([
    {
        "json": 1
    }
])
    @range(
        min: 1
    )
    @required
    min: Integer
    /// Optional maximum quantity the customer can buy. It must be greater than or equal to min.
    @dataExamples([
    {
        "json": 5
    }
])
    @range(
        min: 1
    )
    max: Integer
}

/// Optional link-use policy. Omit to create a reusable Buy link.
structure CreatePurchaseIntentRequestusage {
    /// Creating the first order consumes the Buy link
    @dataExamples([
    {
        "json": true
    }
])
    single_use: Boolean
    /// The Buy link may create multiple orders
    @dataExamples([
    {
        "json": true
    }
])
    multi_use: Boolean
}

@simileSchema(
{
        "additionalProperties": false,
        "allOf": [
            {
                "oneOf": [
                    {
                        "not": {
                            "anyOf": [
                                {
                                    "properties": {
                                        "reason": {}
                                    },
                                    "required": [
                                        "reason"
                                    ]
                                },
                                {
                                    "properties": {
                                        "reason_details": {}
                                    },
                                    "required": [
                                        "reason_details"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "properties": {
                            "reason": {
                                "enum": [
                                    "requested_by_customer",
                                    "duplicate",
                                    "fraudulent",
                                    "order_canceled",
                                    "item_returned",
                                    "item_damaged",
                                    "item_not_received",
                                    "item_not_as_described"
                                ],
                                "type": "string"
                            }
                        },
                        "required": [
                            "reason"
                        ]
                    },
                    {
                        "properties": {
                            "reason": {
                                "enum": [
                                    "custom"
                                ],
                                "type": "string"
                            },
                            "reason_details": {}
                        },
                        "required": [
                            "reason",
                            "reason_details"
                        ]
                    }
                ]
            }
        ],
        "properties": {
            "order_line_item_id": {
                "description": "Strong identifier for the paid order line item being refunded.",
                "example": "oli_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN",
                "pattern": "^oli_",
                "type": "string"
            },
            "reason": {
                "shape": "RefundReason"
            },
            "reason_details": {
                "description": "Line-specific explanation. Requires a line-level reason; required when that reason is `custom`.",
                "maxLength": 2048,
                "type": "string"
            },
            "refund_amount": {
                "shape": "AmountParams"
            }
        },
        "required": [
            "order_line_item_id",
            "refund_amount"
        ],
        "type": "object"
    }
)
structure CreateRefundLineItem {
    /// Strong identifier for the paid order line item being refunded.
    @dataExamples([
    {
        "json": "oli_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN"
    }
])
    @pattern("^oli_")
    @required
    order_line_item_id: String
    reason: RefundReason
    /// Line-specific explanation. Requires a line-level reason; required when that reason is `custom`.
    @length(
        max: 2048
    )
    reason_details: String
    @required
    refund_amount: AmountParams
}

structure CreateRefundRequest {
    custom_data: CustomData
    @required
    line_items: CreateRefundRequestlineItems
    /// Paid order to refund.
    @dataExamples([
    {
        "json": "or_0123456789abcdefghijklmnopqrstuvwxyzABCD"
    }
])
    @pattern("^or_")
    @required
    order_id: String
    @required
    reason: RefundReason
    /// Overall explanation. Required when `reason` is `custom`.
    @length(
        max: 2048
    )
    reason_details: String
    /// Your reconciliation reference.
    @length(
        max: 256
    )
    reference: String
    request_meta: RefundRequestMeta
}

structure CreateSMSMessageTemplateRequest {
    about: String
    locale: String
    @required
    name: String
    @required
    purpose: String
    @required
    sms: MessageTemplateSMSContent
    variables: CreateSMSMessageTemplateRequestvariables
}

structure CreateUploadRequestRequest {
    @dataExamples([
    {
        "json": "support_document"
    }
])
    @required
    purpose: String
    constraints: UploadRequestConstraints
    display: UploadRequestDisplay
    subject: FileParty
    recipient: FileParty
    resource: FileResource
    requester: FileActorInput
    attempts: UploadRequestAttemptsRequest
    custom_data: CustomData
    @timestampFormat("date-time")
    expires_at: Timestamp
}

structure CurrencyBalanceSnapshot {
    @required
    available: BalanceValue
    @required
    held: BalanceHolds
    /// The snapshot includes transactions created before this timestamp
    @required
    @timestampFormat("date-time")
    includes_transactions_before: Timestamp
    @required
    pending: BalanceValue
    @required
    refund: CurrencyBalanceSnapshotrefund
    @required
    reserved: CurrencyBalanceSnapshotreserved
}

/// Funds intentionally earmarked for future refund obligations at the snapshot cutoff
structure CurrencyBalanceSnapshotrefund with [BalanceValueMixin] {}

/// Funds intentionally reserved for policy, risk, or remediation purposes at the snapshot cutoff
structure CurrencyBalanceSnapshotreserved with [BalanceValueMixin] {}

structure Customer {
    @required
    balance: CustomerBalance
    billing_address: CustomerAddress
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    custom_data: CustomData
    email_address: String
    /// Application-scoped value for spotting possible duplicate customer records. Matching nonempty fingerprints within the same application indicate that the records likely belong to the same buyer. Compare fingerprints only within that application, and continue to use each customer ID for API operations.
    @required
    fingerprint: String
    @required
    guest: Boolean
    @pattern("^cu_")
    @required
    id: String
    @required
    name: String
    phone_number: String
    reference: String
    shipping_address: CustomerAddress
    suffix: String
    title: String
    @timestampFormat("date-time")
    updated_at: Timestamp
}

structure CustomerAddress {
    city: String
    @required
    country: String
    line1: String
    line2: String
    name: String
    phone_number: String
    post_code: String
    region: String
}

structure CustomerAddressInput {
    city: String
    @required
    country: String
    line1: String
    line2: String
    name: String
    phone_number: String
    post_code: String
    region: String
}

structure CustomerBalanceValue {
    @required
    @timestampFormat("date-time")
    as_of: Timestamp
    @required
    available: Amount
}

