)
structure Refund {
    /// Omitted unless a reason was supplied when the refund was canceled.
    @length(
        max: 2048
    )
    cancel_reason: String
    /// Omitted unless the refund was canceled before processing began.
    @timestampFormat("date-time")
    canceled_at: Timestamp
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    custom_data: CustomData
    /// Omitted unless processing failed.
    @timestampFormat("date-time")
    failed_at: Timestamp
    failure: RefundfailureSchema
    @pattern("^rf_")
    @required
    id: String
    @required
    line_items: RefundlineItems
    @pattern("^or_")
    @required
    order_id: String
    order_amount: RefundorderAmount
    /// Omitted until processing starts.
    @timestampFormat("date-time")
    processing_at: Timestamp
    @required
    reason: RefundReason
    @length(
        max: 2048
    )
    reason_details: String
    reference: String
    @required
    settlement: RefundSettlement
    @required
    status: Refundstatus
    /// Omitted unless processing succeeded.
    @timestampFormat("date-time")
    succeeded_at: Timestamp
    @required
    total: Refundtotal
}

structure RefundBalanceTransaction {
    @required
    amount: BalanceTransactionAmount
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @dataExamples([
    {
        "json": "bt_0123456789abcdefghijklmnopqrstuvwxyzABCD"
    }
])
    @pattern("^bt_")
    @required
    id: String
    @dataExamples([
    {
        "json": "or_0123456789abcdefghijklmnopqrstuvwxyzABCD"
    }
])
    @pattern("^or_")
    @required
    order_id: String
    @dataExamples([
    {
        "json": "rf_1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZabcd"
    }
])
    @pattern("^rf_")
    @required
    refund_id: String
}

@mixin
structure RefundFailure {
    /// Safe explanation intended for the merchant. Raw provider and internal diagnostic messages are never returned.
    @required
    detail: String
    @required
    reason: RefundFailureReason
    /// Whether the underlying condition may be resolved before creating a new, intentional refund request. It never instructs clients to repeat an uncertain money movement.
    @required
    retryable: Boolean
}

/// Sanitized terminal failure information. Present only when `status` is `failed`. An uncertain provider outcome remains `processing` and does not produce this object.
structure RefundfailureSchema with [RefundFailure] {}

