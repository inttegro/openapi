structure Orderpayment {
    /// Payment intent ID
    @dataExamples([
    {
        "json": "py_OHFv6I3OZBvB1R46TQQGNxPPtgbPR6CXpQ8En9wl"
    }
])
    @pattern("^py_")
    @required
    id: String
    @required
    status: Orderpaymentstatus
    /// Optional statement descriptor shown on the customer's bank statement
    @dataExamples([
    {
        "json": "STATEMENT"
    }
])
    @required
    statement_descriptor: String
    @required
    amount: Amount
    balance_transaction: BalanceTransaction
    payment_method: OrderPaymentMethod
    billing_details: OrderpaymentbillingDetailsSchema
    receipt: OrderReceipt
    customer: Orderpaymentcustomer
    latest_attempt: OrderpaymentlatestAttempt
    next_action: PaymentNextAction
    latest_error: OrderpaymentlatestError
    /// When we kicked off the payment intent
    @required
    @timestampFormat("date-time")
    initiated_at: Timestamp
    /// When payment execution started
    @timestampFormat("date-time")
    executed_at: Timestamp
    /// When payment completed successfully
    @timestampFormat("date-time")
    paid_at: Timestamp
    /// When payment was canceled
    @timestampFormat("date-time")
    canceled_at: Timestamp
    /// When payment becomes overdue
    @timestampFormat("date-time")
    due_at: Timestamp
    /// When payment expired
    @timestampFormat("date-time")
    expired_at: Timestamp
    /// When payment failed
    @timestampFormat("date-time")
    failed_at: Timestamp
    /// Whether payment was recorded as received outside Inttegro
    paid_offline: Boolean
    payment_method_types: OrderpaymentpaymentMethodTypes
    payout_configuration: OrderpaymentpayoutConfiguration
}

