structure Product {
    /// Unique product identifier with prod_ prefix
    @dataExamples([
    {
        "json": "prod_abc123xyz"
    }
])
    @pattern("^prod_")
    @required
    id: String
    @required
    type: Producttype
    /// External reference or SKU
    @dataExamples([
    {
        "json": "SKU-12345"
    }
])
    reference: String
    /// Product name
    @dataExamples([
    {
        "json": "Premium Cotton T-Shirt"
    }
])
    @required
    name: String
    /// Short description
    @dataExamples([
    {
        "json": "Comfortable everyday wear"
    }
])
    description: String
    /// Full product description
    about: String
    /// Tax classification code
    tax_code: String
    /// Product category
    category: String
    prices: Productprices
    shipment: ProductShipment
    media: ProductMedia
    attributes: Productattributes
    dimensions: ProductDimensions
    custom_data: NonEmptyCustomData
    /// Whether product is published and available
    @dataExamples([
    {
        "json": true
    }
])
    @required
    active: Boolean
    /// Product creation timestamp
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    /// Last update timestamp
    @timestampFormat("date-time")
    updated_at: Timestamp
    /// Archive timestamp (if archived)
    @timestampFormat("date-time")
    archived_at: Timestamp
    /// When the product was published
    @timestampFormat("date-time")
    published_at: Timestamp
    /// Unit dimension label
    unit_dim: String
}

structure ProductActionRequest {
    /// Product ID to perform action on
    @dataExamples([
    {
        "json": "prod_abc123"
    }
])
    @pattern("^prod_")
    @required
    product_id: String
}

structure ProductAttribute {
    @length(
        max: 100
    )
    @required
    name: String
    @length(
        max: 500
    )
    @required
    value: String
}

/// Delivery fulfillment marker.
structure ProductDelivery {}

/// At most one of `physical`, `digital`, or `custom`.
structure ProductDimensions with [ProductDimensionsMixin] {}

structure ProductDimensionscustom {
    size_unit: String
    @range(
        min: 0
    )
    size: Double
    details: ProductDimensionDetails
}

structure ProductDimensionsdigital {
    @range(
        min: 0
    )
    bytes: Double
    size_unit: String
    @range(
        min: 0
    )
    size: Double
}

/// At most one of `physical`, `digital`, or `custom`.
@mixin
structure ProductDimensionsMixin {
    physical: ProductDimensionsphysical
    digital: ProductDimensionsdigital
    custom: ProductDimensionscustom
}

structure ProductDimensionsphysical {
    weight_unit: String
    @range(
        min: 0
    )
    weight: Double
    /// Legacy alias for weight in requests.
    @range(
        min: 0
    )
    size: Double
    volume_unit: String
    @range(
        min: 0
    )
    volume: Double
    @range(
        min: 0
    )
    length: Double
    @range(
        min: 0
    )
    height: Double
    @range(
        min: 0
    )
    width: Double
}

/// Download fulfillment marker.
structure ProductDownload {}

structure ProductLineItem {
    @required
    product: ProductDetails
}

structure ProductMedia with [ProductMediaMixin] {}

@mixin
structure ProductMediaMixin {
    hero_image: ProductMediaFileReference
    thumbnail: ProductMediaFileReference
    /// Public HTTP or HTTPS URL for the product's canonical landing page. Credentials and local or private literal addresses are rejected.
    @length(
        max: 2048
    )
    @pattern("^[Hh][Tt][Tt][Pp][Ss]?://")
    web_page_url: String
    brand_logo: ProductMediaFileReference
    infographic: ProductMediaFileReference
    promo_video: ProductMediaFileReference
    demo_video: ProductMediaFileReference
    gallery: ProductMediagallery
    downloads: ProductMediadownloads
}

/// Rendered fulfillment marker.
structure ProductRender {}

structure ProductResponse {
    @required
    product: Product
}

structure ProductSearchResponse {
    @required
    search: ProductSearchResponsesearch
}

structure ProductSearchResponsesearch with [ResourceSearchPageMixin] {}

structure ProductSearchResponsesearchallOf1resourceTotalsItem with [ResourceSearchResourceTotalMixin] {}

structure ProductSearchResponsesearchallOf1resultsItem with [ResourceSearchResultMixin] {}

structure ProductSearchResponsesearchallOf1resultsItemallOf1resource with [ResourceSearchResourceReferenceMixin] {}

/// Service fulfillment marker.
structure ProductService {}

structure ProductShipmentInput {
    @required
    type: ProductShipmentInputtype
}

structure ProductShipmentoneOfalt0 {
    @required
    type: ProductShipmentoneOfalt0type
    delivery: ProductDelivery
}

structure ProductShipmentoneOfalt1 {
    @required
