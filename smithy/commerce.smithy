structure ActivatePaymentMethodRequest {
    /// ID of the payment method to activate
    @dataExamples([
    {
        "json": "pm_xyz789"
    }
])
    @pattern("^pm_")
    @required
    payment_method_id: String
}

structure ActivatePaymentMethodResponse {
    @required
    payment_method: PaymentMethodObject
}

structure AddCustomerSelectedProductPriceRequest {
    /// Product ID to attach the new price to
    @dataExamples([
    {
        "json": "prod_abc123"
    }
])
    @pattern("^prod_")
    @required
    product_id: String
    /// Optional short label for the new price
    @dataExamples([
    {
        "json": "Wholesale"
    }
])
    @length(
        max: 100
    )
    label: String
    /// Optional internal description for the new price
    @dataExamples([
    {
        "json": "Preferred rate for repeat buyers"
    }
])
    @length(
        max: 500
    )
    about: String
    @required
    customer_selected_amount: AddCustomerSelectedProductPriceRequestcustomerSelectedAmount
}

/// Available only to Commerce internal services and Upper private beta organizations and applications.
structure AddCustomerSelectedProductPriceRequestcustomerSelectedAmount with [CustomerSelectedAmountParams] {}

structure AddFixedProductPriceRequest {
    /// Product ID to attach the new price to
    @dataExamples([
    {
        "json": "prod_abc123"
    }
])
    @pattern("^prod_")
    @required
    product_id: String
    /// Optional short label for the new price
    @dataExamples([
    {
        "json": "Wholesale"
    }
])
    @length(
        max: 100
    )
    label: String
    /// Optional internal description for the new price
    @dataExamples([
    {
        "json": "Preferred rate for repeat buyers"
    }
])
    @length(
        max: 500
    )
    about: String
    @required
    fixed_amount: AmountParams
}

structure AddProductPriceResponse {
    @required
    price: CatalogPrice
}

structure Address {
    /// Recipient name
    @dataExamples([
    {
        "json": "Customer Name"
    }
])
    name: String
    /// Contact phone number
    @dataExamples([
    {
        "json": "+233242058841"
    }
])
    phone_number: String
    /// Street address line 1
    @dataExamples([
    {
        "json": "23 Adenta High Street"
    }
])
    line1: String
    /// Street address line 2 (optional)
    @dataExamples([
    {
        "json": "Behind Pantang"
    }
])
    line2: String
    /// City or town
    @dataExamples([
    {
        "json": "Accra"
    }
])
    city: String
    /// State, province, or region
    @dataExamples([
    {
        "json": "Greater Accra"
    }
])
    region: String
    /// Country value recorded for the address.
    @dataExamples([
    {
        "json": "GH"
    }
])
    @required
    country: String
    /// Postal/ZIP code
    @dataExamples([
    {
        "json": "GHA-123-9822"
    }
])
    post_code: String
}

structure Amount with [AmountMixin] {}

@mixin
structure AmountMixin {
    @required
    currency: Currency
    /// Amount in the currency's smallest unit.
    @dataExamples([
    {
        "json": 20000
    }
])
    @required
    value: Integer
}

structure AmountParams with [AmountParamsMixin] {}

@mixin
structure AmountParamsMixin {
    @required
    currency: Currency
    /// Amount in smallest currency unit (e.g., pesewas for GHS)
    @dataExamples([
    {
        "json": 20000
    }
])
    @range(
        min: 0
    )
    @required
    value: Integer
}

structure ApplicationCapabilitiesResponse {
    @required
    capabilities: ApplicationCapabilitiesResponsecapabilities
}

structure ApplicationCapabilitiesResponsecapabilities {
    @required
    payments: ApplicationCapabilitiesResponsecapabilitiespayments
    @required
    payouts: ApplicationCapabilitiesResponsecapabilitiespayouts
}

/// Public capability states currently available to the application. Newly created applications can return an empty object until capabilities become available.
structure ApplicationCapabilityProjection {
    payments: ApplicationCapabilityProjectionpayments
    payouts: ApplicationCapabilityProjectionpayouts
}

@simileSchema(
{
        "additionalProperties": false,
        "properties": {
            "code": {
                "description": "Stable public identifier for the requirement.",
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
            },
            "description": {
                "description": "Public explanation of what must be completed.",
                "type": "string"
            },
            "due_at": {
                "description": "Requirement deadline, or null when no deadline applies.",
                "format": "date-time",
                "type": [
                    "string",
                    "null"
                ]
            }
        },
        "required": [
            "code",
            "description",
            "due_at"
        ],
        "type": "object"
    }
)
structure ApplicationCapabilityRequirement {
    /// Stable public identifier for the requirement.
    @pattern("^[a-z][a-z0-9_]*$")
    @required
    code: String
    /// Public explanation of what must be completed.
    @required
    description: String
    /// Requirement deadline, or null when no deadline applies.
    @required
    @timestampFormat("date-time")
    due_at: Timestamp
}

structure ApplicationCapabilityRequirements {
    @required
    currently_due: ApplicationCapabilityRequirementscurrentlyDue
}

/// Immutable operating policy snapshot applied to the application.
@mixin
structure ApplicationOperatingPolicy {
    @required
    capabilities: OperatingPolicyCapabilities
    @required
    source: OperatingPolicySource
}

