structure UpdateApplicationRequest {
    /// Display name for the application. Cannot be empty.
    name: String
    /// Short name for the application. Use an empty string to clear it.
    alias: String
    /// Application description. Use an empty string to clear it.
    description: String
    /// Caller-defined legal-entity label. Send an empty string to clear it.
    legal_entity_type: String
    operating_policy: UpdateApplicationRequestoperatingPolicy
}

@availability(
"private-beta"
)
structure UpdateApplicationRequestoperatingPolicy {}

structure UpdateApplicationResponse {
    @required
    app: UpdateApplicationResponseapp
}

structure UpdateApplicationResponseapp {
    @pattern("^app_")
    @required
    id: String
    @required
    name: String
    alias: String
    description: String
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @timestampFormat("date-time")
    updated_at: Timestamp
    @required
    capabilities: ApplicationCapabilityProjection
    children_policy: UpdateApplicationResponseappchildrenPolicy
    operating_policy: UpdateApplicationResponseappoperatingPolicy
}

/// Active children policy assigned to the application. Omitted when the private beta is unavailable to the caller.
@availability(
"private-beta"
)
structure UpdateApplicationResponseappchildrenPolicy with [ChildrenPolicyMixin] {}

/// Immutable operating policy applied to the application. Omitted for root applications and when the private beta is unavailable to the caller.
@availability(
"private-beta"
)
structure UpdateApplicationResponseappoperatingPolicy with [ApplicationOperatingPolicy] {}

