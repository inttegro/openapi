/// Public file link metadata. Token hashes and provider URLs are not exposed.
@simileConstraints(
[
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/updated_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/expires_at"
                ]
            }
        },
        {
            "ordered": {
                "paths": [
                    "/created_at",
                    "/revoked_at"
                ]
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": true,
                            "path": "/active"
                        },
                        {
                            "path": "/revoked_at",
                            "state": "absent"
                        }
                    ]
                },
                "when": {
                    "equals": "active",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": false,
                            "path": "/active"
                        },
                        {
                            "path": "/revoked_at",
                            "state": "non-null"
                        }
                    ]
                },
                "when": {
                    "equals": "revoked",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": false,
                            "path": "/active"
                        }
                    ]
                },
                "when": {
                    "equals": "expired",
                    "path": "/status"
                }
            }
        },
        {
            "implies": {
                "then": {
                    "all": [
                        {
                            "equals": false,
                            "path": "/active"
                        }
                    ]
                },
                "when": {
                    "equals": "disabled",
                    "path": "/status"
                }
            }
        }
    ]
)
structure FileLinkObject {
    @pattern("^flink_")
    @required
    id: String
    @required
    kind: FileLinkObjectkind
    @pattern("^file_")
    @required
    file_id: String
    @required
    purpose: String
    @required
    status: FileLinkObjectstatus
    @required
    active: Boolean
    @required
    delivery: FileLinkDelivery
    @required
    access: FileLinkAccess
    @required
    created_by: FileLinkActor
    revoked_by: FileLinkActor
    custom_data: CustomData
    metadata: FileMetadata
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @required
    @timestampFormat("date-time")
    updated_at: Timestamp
    @required
    @timestampFormat("date-time")
    expires_at: Timestamp
    @timestampFormat("date-time")
    revoked_at: Timestamp
}

@simileConstraints(
