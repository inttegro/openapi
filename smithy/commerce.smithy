/// Newly generated secret key. The token is returned once and cannot be retrieved later.
structure GeneratedSecretKey {
    /// Secret key identifier.
    @dataExamples([
    {
        "json": "sk_2xC7k9gK5yQnZ4w8P1sT6vR3"
    }
])
    @pattern("^sk_")
    @required
    id: String
    /// Optional human-readable label for the secret key.
    @dataExamples([
    {
        "json": "Production checkout"
    }
])
    label: String
    @required
    token_type: GeneratedSecretKeytokenType
    @required
    @timestampFormat("date-time")
    issued_at: Timestamp
    /// One-time bearer token for the generated key.
    @required
    token: String
}

/// Optional public input for secret key generation.
structure GenerateSecretKeyRequest {
    /// Optional human-readable label. Surrounding whitespace is trimmed; an empty value creates an unlabeled key.
    @dataExamples([
    {
        "json": "Production checkout"
    }
])
    label: String
}

structure GenerateSecretKeyResponse {
    @required
    key: GeneratedSecretKey
}

