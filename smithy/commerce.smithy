@simileSchema(
{
        "additionalProperties": false,
        "not": {
            "properties": {
                "email": {},
                "sms": {}
            },
            "required": [
                "sms",
                "email"
            ]
        },
        "properties": {
            "about": {
                "description": "Optional description of when this template should be used.",
                "example": "Sent after a successful payment.",
                "type": "string"
            },
            "attachments": {
                "shape": "MessageTemplateAttachmentIDs"
            },
            "channel": {
                "description": "Existing template channel. Channels cannot be changed.",
                "enum": [
                    "sms",
                    "email"
                ],
                "type": "string"
            },
            "email": {
                "shape": "MessageTemplateEmailContent"
            },
            "id": {
                "description": "API-generated message template id.",
                "example": "mtpl_receipt",
                "pattern": "^mtpl_",
                "type": "string"
            },
            "locale": {
                "example": "en",
                "type": "string"
            },
            "name": {
                "description": "Human-readable template name.",
                "example": "Receipt email",
                "type": "string"
            },
            "purpose": {
                "description": "Caller-defined purpose for filtering and analytics.",
                "example": "receipt",
                "type": "string"
            },
            "sms": {
                "shape": "MessageTemplateSMSContent"
            },
            "variables": {
                "items": {
                    "shape": "MessageTemplateVariableInput"
                },
                "type": "array"
            }
        },
        "required": [
            "id"
        ],
        "type": "object"
    }
)
structure UpdateMessageTemplateRequest {
    /// API-generated message template id.
    @dataExamples([
    {
        "json": "mtpl_receipt"
    }
])
    @pattern("^mtpl_")
    @required
    id: String
    /// Human-readable template name.
    @dataExamples([
    {
        "json": "Receipt email"
    }
])
    name: String
    /// Optional description of when this template should be used.
    @dataExamples([
    {
        "json": "Sent after a successful payment."
    }
])
    about: String
    channel: UpdateMessageTemplateRequestchannel
    /// Caller-defined purpose for filtering and analytics.
    @dataExamples([
    {
        "json": "receipt"
    }
])
    purpose: String
    @dataExamples([
    {
        "json": "en"
    }
])
    locale: String
    variables: UpdateMessageTemplateRequestvariables
    sms: MessageTemplateSMSContent
    email: MessageTemplateEmailContent
    attachments: MessageTemplateAttachmentIDs
}

