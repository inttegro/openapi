structure FileObject {
    @dataExamples([
    {
        "json": "file_2xC7k9gK5yQnZ4w8P1sT6vR3"
    }
])
    @pattern("^file_")
    @required
    id: String
    @dataExamples([
    {
        "json": "product_image"
    }
])
    @required
    purpose: String
    @required
    status: FileObjectstatus
    @required
    scan_status: FileObjectscanStatus
    @dataExamples([
    {
        "json": "Hero image"
    }
])
    name: String
    @dataExamples([
    {
        "json": "hero.png"
    }
])
    filename: String
    @dataExamples([
    {
        "json": "image/png"
    }
])
    @required
    content_type: String
    /// Original byte size.
    @dataExamples([
    {
        "json": 384221
    }
])
    @required
    size: Long
    @dataExamples([
    {
        "json": "02c26c6e49b2c332c8fb95d9f6a7c4f2d9e3f1f5a63f0b1a9d2a0ba"
    }
])
    @required
    checksum_sha256: String
    @required
    created_by: FileActor
    @required
    source: FileSource
    media: FileMedia
    @required
    storage: PublicFileStorage
    delivery: FileDelivery
    latest_error: FileLatestError
    custom_data: CustomData
    metadata: FileMetadata
    @required
    @timestampFormat("date-time")
    created_at: Timestamp
    @required
    @timestampFormat("date-time")
    updated_at: Timestamp
    @timestampFormat("date-time")
    available_at: Timestamp
    @timestampFormat("date-time")
    expires_at: Timestamp
}

