        "required": [
            "customer_data",
            "line_items"
        ],
        "type": "object"
    }
)
structure CreateOrderNewCustomer {
    @required
    customer_data: CustomerData
    payment_method_types: CreateOrderNewCustomerpaymentMethodTypes
    payment_method_data: CreateOrderNewCustomerpaymentMethodData
    /// Optional payment due time.
    @timestampFormat("date-time")
    payment_due_after: Timestamp
    /// Optional order number for reference. When omitted, Inttegro uses the generated order ID.
    @dataExamples([
    {
        "json": "ORDER-NUMBER-2"
    }
])
    number: String
    /// Optional receipt number for downstream reconciliation. Uses the same length rules as `number`.
    @dataExamples([
    {
        "json": "RCPT-NUMBER-2"
    }
])
    receipt_number: String
    /// Optional statement descriptor shown on the customer's bank statement
    @dataExamples([
    {
        "json": "STMTDESC"
    }
])
    @length(
        min: 3
        max: 22
    )
    statement_descriptor: String
    /// Optional static prefix used to build the statement descriptor as `prefix*order_id`. Mutually exclusive with `statement_descriptor`.
    @dataExamples([
    {
        "json": "LINE"
    }
])
    @length(
        min: 2
        max: 10
    )
    @pattern("^[^*]+$")
    statement_descriptor_prefix: String
    /// Whether to execute payment immediately after order creation
    execute_payment: Boolean
    /// Whether to explicitly finalize the order. When true, the order is finalized regardless of payment state. When false or omitted, finalization follows default heuristics (finalize if payment is executable).
    finalize: Boolean
    request_meta: CreateOrderNewCustomerrequestMeta
    checkout_settings: CreateOrderNewCustomercheckoutSettings
    invoice_settings: InvoiceSettings
    payout_settings: OrderPayoutSettingsRequest
    @required
    line_items: CreateOrderNewCustomerlineItems
    custom_data: CustomData
    billing_details: BillingDetails
    shipping: Shipping
}

/// Checkout and payment flow configuration. Strongly recommended to provide both redirect_url and cancel_url for a delightful customer experience.
structure CreateOrderNewCustomercheckoutSettings {
    /// URL to redirect customer after payment completion
    @dataExamples([
    {
        "json": "https://example.com/order/complete"
    }
])
    redirect_url: String
    /// URL to redirect customer if they cancel payment
    @dataExamples([
    {
        "json": "https://example.com/order/cancelled"
    }
])
    cancel_url: String
}

/// New payment instrument details to use when executing payment for the order.
structure CreateOrderNewCustomerpaymentMethodData with [PaymentMethodData] {}

/// Optional metadata controlling request processing
structure CreateOrderNewCustomerrequestMeta {
    idempotency_key: CreateOrderNewCustomerrequestMetaidempotencyKey
    response: RequestResponse
}

/// Unique key to prevent duplicate order creation
structure CreateOrderNewCustomerrequestMetaidempotencyKey {}

structure CreateProductRequest {
    @required
    type: CreateProductRequesttype
    /// External reference or SKU from your system
    @dataExamples([
    {
        "json": "SKU-12345"
    }
])
    @length(
        min: 1
        max: 100
    )
    reference: String
    /// Customer-facing product name
    @dataExamples([
    {
        "json": "Premium Cotton T-Shirt"
    }
])
    @length(
        min: 1
        max: 100
    )
    @required
    name: String
    /// Short product description or tagline
    @dataExamples([
    {
        "json": "Comfortable everyday wear"
    }
])
    @length(
        max: 200
    )
    description: String
    /// Full product description with details and features
    @dataExamples([
    {
        "json": "Made from 100% organic cotton, this premium t-shirt..."
    }
])
    @length(
        max: 5000
    )
    about: String
    /// Tax classification code for tax calculations
    @dataExamples([
    {
        "json": "TXCD001"
    }
])
    @length(
        max: 50
    )
    tax_code: String
    /// Product category for organization
    @length(
        max: 100
    )
    category: String
    shipment: ProductShipmentInput
    dimensions: ProductDimensions
    @length(
        max: 20
    )
    unit_dimension: String
    media: ProductMedia
    attributes: CreateProductRequestattributes
    /// Whether to publish the product immediately
    publish: Boolean
    custom_data: CustomData
}

/// Optional merchant-authored copy for the hosted Buy page. Omit it to use product-aware defaults.
structure CreatePurchaseIntentPresentation {
    @required
    buy_page: CreatePurchaseIntentPresentationbuyPage
}

structure CreatePurchaseIntentPresentationbuyPage {
    @required
    text: CreatePurchaseIntentPresentationbuyPagetext
}

structure CreatePurchaseIntentPresentationbuyPagetext {
    /// Plain, single-line title shown above the Buy page form
    @dataExamples([
    {
        "json": "Support this cause"
    }
])
    @length(
        min: 1
        max: 80
    )
    checkout_section_title: String
    /// Plain, single-line label for a customer-selected amount field
    @dataExamples([
    {
        "json": "Your contribution"
    }
])
    @length(
        min: 1
        max: 64
    )
    amount_field_label: String
    /// Plain, single-line label used for the ready primary action. Validation and loading labels remain system-owned.
    @dataExamples([
    {
        "json": "Continue to contribute"
    }
])
    @length(
        min: 1
        max: 48
    )
    primary_action_label: String
}

