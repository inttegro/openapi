            "application/json": {
                "bindings": [
                    {
                        "default": 1,
                        "from": "/page_number",
                        "to": "/page/number"
                    }
                ],
                "rules": [
                    {
                        "then": {
                            "set": {
                                "/page/number": 1
                            }
                        },
                        "when": {
                            "all": [
