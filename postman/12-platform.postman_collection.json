      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{api_key}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "Operating policies",
      "item": [
        {
          "name": "Create an operating policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/operating_policies/create"
            },
            "description": "Creates version one under the authenticated application's active children policy.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ghana payments\",\n  \"description\": \"Accept GHS payments without payouts\",\n  \"capabilities\": {\n    \"payments\": {\n      \"currencies\": [\"ghs\"],\n      \"limits\": {\n        \"amount\": {\n          \"min\": 1,\n          \"max\": 9999999\n        }\n      }\n    },\n    \"payouts\": {\n      \"enabled\": false,\n      \"bt_aging_spec\": {\n        \"id\": \"bt_aging_spec_24_hourly\"\n      }\n    },\n    \"payment_methods\": {\n      \"mobile_money\": {\n        \"enabled\": true,\n        \"confirms_use\": true\n      },\n      \"card\": {\n        \"enabled\": true,\n        \"confirms_use\": true\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  const operating_policy_id = jsonBody?.operating_policy?.id;",
                  "  pm.test('Returns version one of the operating policy', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('operating_policy');",
                  "    pm.expect(operating_policy_id).to.be.a('string').and.match(/^op_/);",
                  "    pm.expect(jsonBody?.operating_policy?.version).to.equal(1);",
                  "  });",
                  "  if (operating_policy_id) pm.environment.set('operating_policy_id', operating_policy_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup an operating policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/operating_policies/lookup"
            },
            "description": "Returns the active version. Historical selectors remain internal.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operating_policy_id\": \"{{operating_policy_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  pm.test('Returns the requested operating policy', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('operating_policy');",
                  "    pm.expect(jsonBody?.operating_policy?.id).to.equal(pm.variables.get('operating_policy_id'));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a new operating policy version",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/operating_policies/update"
            },
            "description": "Uses optimistic concurrency and leaves prior immutable versions available to internal forensics.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operating_policy_id\": \"{{operating_policy_id}}\",\n  \"expected_version\": 1,\n  \"description\": \"Accept GHS payments without payouts; reviewed for production\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  pm.test('Returns the newly active immutable version', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('operating_policy');",
                  "    pm.expect(jsonBody?.operating_policy?.id).to.equal(pm.variables.get('operating_policy_id'));",
                  "    pm.expect(jsonBody?.operating_policy?.active_version).to.equal(jsonBody?.operating_policy?.version);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ],
      "description": "Create, retrieve, and version reusable operating policies for a children_policy_v1 application.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{api_key}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "API keys",
      "item": [
        {
          "name": "Generate a key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/keys/generate"
            },
            "description": "Public reference: https://studio.inttegro.com/keys#generate-a-secret-key. The bearer token is returned only by this request; store it before continuing because later key reads return metadata only.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"checkout-api\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const secret_key_id = jsonBody?.key?.id;",
                  "  pm.test('Returns a key token exactly once', () => {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(jsonBody).to.have.all.keys('key');",
                  "    pm.expect(secret_key_id).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(jsonBody?.key?.token).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(jsonBody?.key?.token_type).to.equal('bearer');",
                  "    for (const field of Object.keys(jsonBody?.key ?? {})) {",
                  "      pm.expect(field).to.be.oneOf(['id', 'label', 'token_type', 'issued_at', 'token']);",
                  "    }",
                  "  });",
                  "  if (secret_key_id) pm.environment.set(\"secret_key_id\", secret_key_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Page API keys",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/keys/page"
            },
            "description": "Public reference: https://studio.inttegro.com/keys#list-keys",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"size\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  const page = jsonBody?.page;",
                  "  pm.test('Returns a safe key page without bearer tokens', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('page');",
                  "    pm.expect(page).to.have.all.keys('number', 'size', 'count', 'total', 'has_more', 'keys');",
                  "    pm.expect(page?.keys).to.be.an('array');",
                  "    for (const key of page?.keys ?? []) {",
                  "      for (const field of Object.keys(key)) {",
                  "        pm.expect(field).to.be.oneOf(['id', 'label', 'token_type', 'issued_at', 'updated_at', 'expires_at', 'status', 'active', 'revoked_at', 'last_used_at', 'usage_count']);",
                  "      }",
                  "    }",
                  "    pm.expect(JSON.stringify(jsonBody)).not.to.match(/\"token\"\\s*:/);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup an API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/keys/lookup"
            },
            "description": "Public reference: https://studio.inttegro.com/keys#look-up-a-key",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret_key_id\": \"{{secret_key_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  pm.test('Returns safe key metadata', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('key');",
                  "    pm.expect(jsonBody?.key?.id).to.equal(pm.variables.get('secret_key_id'));",
                  "    pm.expect(jsonBody?.key).not.to.have.property('token');",
                  "    for (const field of Object.keys(jsonBody?.key ?? {})) {",
                  "      pm.expect(field).to.be.oneOf(['id', 'label', 'token_type', 'issued_at', 'updated_at', 'expires_at', 'status', 'active', 'revoked_at', 'last_used_at', 'usage_count']);",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update an API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "call-key-update-{{secret_key_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/keys/update"
            },
            "description": "Public reference: https://studio.inttegro.com/keys#update-a-key-label",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret_key_id\": \"{{secret_key_id}}\",\n  \"label\": \"checkout-api-primary\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  pm.test('Returns the updated safe key metadata', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('key');",
                  "    pm.expect(jsonBody?.key?.id).to.equal(pm.variables.get('secret_key_id'));",
                  "    pm.expect(jsonBody?.key?.label).to.equal('checkout-api-primary');",
                  "    pm.expect(jsonBody?.key).not.to.have.property('token');",
                  "    for (const field of Object.keys(jsonBody?.key ?? {})) {",
                  "      pm.expect(field).to.be.oneOf(['id', 'label', 'token_type', 'issued_at', 'updated_at', 'expires_at', 'status', 'active', 'revoked_at', 'last_used_at', 'usage_count']);",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke an API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "call-key-revoke-{{secret_key_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/keys/destroy"
            },
            "description": "Public reference: https://studio.inttegro.com/keys#revoke-a-key",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret_key_id\": \"{{secret_key_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  pm.test('Returns revoked safe key metadata', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('key');",
                  "    pm.expect(jsonBody?.key?.id).to.equal(pm.variables.get('secret_key_id'));",
                  "    pm.expect(jsonBody?.key?.status).to.equal('revoked');",
                  "    pm.expect(jsonBody?.key).not.to.have.property('token');",
                  "    for (const field of Object.keys(jsonBody?.key ?? {})) {",
                  "      pm.expect(field).to.be.oneOf(['id', 'label', 'token_type', 'issued_at', 'updated_at', 'expires_at', 'status', 'active', 'revoked_at', 'last_used_at', 'usage_count']);",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve API key usage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/keys/usage"
            },
            "description": "Public reference: https://studio.inttegro.com/keys#review-key-usage. Returns only the key ID, event time, and authentication outcome for each activity row.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret_key_id\": \"{{secret_key_id}}\",\n  \"page\": 1,\n  \"size\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  pm.test('Returns key metadata and its usage page without a bearer token', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('key', 'usage');",
                  "    pm.expect(jsonBody?.key?.id).to.equal(pm.variables.get('secret_key_id'));",
                  "    pm.expect(jsonBody?.usage).to.have.all.keys('number', 'size', 'count', 'total', 'has_more', 'rows');",
                  "    pm.expect(jsonBody?.usage?.rows).to.be.an('array');",
                  "    for (const field of Object.keys(jsonBody?.key ?? {})) {",
                  "      pm.expect(field).to.be.oneOf(['id', 'label', 'token_type', 'issued_at', 'updated_at', 'expires_at', 'status', 'active', 'revoked_at', 'last_used_at', 'usage_count']);",
                  "    }",
