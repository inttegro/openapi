{
  "info": {
    "name": "Inttegro API — Platform",
    "description": "Manage applications and keys and retrieve reference data. Uses the shared Inttegro API global environment. Error reference: https://studio.inttegro.com/error-codes#applications\n\nGenerated from insomnia/12-platform.insomnia.yaml. Edit the Insomnia source and run npm run postman:generate.",
    "version": "0.1.0-beta51",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Apps",
      "item": [
        {
          "name": "Create an app",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/apps/create"
            },
            "description": "Public reference: https://studio.inttegro.com/apps#create-an-app",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alias\": \"acme-prod-api\",\n  \"description\": \"Production Inttegro API integration for Acme Marketplace\",\n  \"legal_entity_type\": \"business\",\n  \"name\": \"Acme Production API\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const jsonBody = pm.response.json();",
                  "  const app_id = jsonBody?.app?.id;",
                  "  pm.test('Returns the created app and one-time credentials', () => {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(jsonBody).to.have.all.keys('app');",
                  "    pm.expect(app_id).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(jsonBody?.app?.relationship).to.be.an('object');",
                  "    pm.expect(jsonBody?.app?.secret_key?.token).to.be.a('string').and.not.be.empty;",
                  "  });",
                  "  if (app_id) pm.environment.set(\"app_id\", app_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup an app",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/apps/lookup"
            },
            "description": "Public reference: https://studio.inttegro.com/apps#lookup-an-app"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  pm.test('Returns safe metadata for the authenticated app', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('app');",
                  "    pm.expect(jsonBody?.app?.id).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(jsonBody?.app).not.to.have.property('secret_key');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve app capabilities",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/apps/capabilities"
            },
            "description": "Public reference: https://studio.inttegro.com/apps#retrieve-app-capabilities",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  pm.test('Returns public capability states for the authenticated app', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('capabilities');",
                  "    pm.expect(jsonBody?.capabilities).to.be.an('object');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update an app",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/apps/update"
            },
            "description": "Public reference: https://studio.inttegro.com/apps#update-an-app",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alias\": \"acme-checkout-api\",\n  \"description\": \"Checkout API for Acme Marketplace\",\n  \"legal_entity_type\": \"business\",\n  \"name\": \"Acme Checkout API\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  pm.test('Returns the updated app without credentials', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('app');",
                  "    pm.expect(jsonBody?.app?.name).to.equal('Acme Checkout API');",
                  "    pm.expect(jsonBody?.app).not.to.have.property('secret_key');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ],
      "description": "Create, retrieve, and update applications when the calling key has the required authority.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{api_key}}",
            "type": "string"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(",
              "  'future_timestamp',",
              "  new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString(),",
              ");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns a successful HTTP status', () => {",
              "  pm.expect(pm.response.code).to.be.within(200, 299);",
              "});"
            ]
          }
        }
      ]
    },
    {
