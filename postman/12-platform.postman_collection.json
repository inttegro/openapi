              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonBody = pm.response.json();",
                  "  const children_policy_id = jsonBody?.children_policy?.id;",
                  "  pm.test('Returns the active children policy', () => {",
                  "    pm.expect(jsonBody).to.have.all.keys('children_policy');",
                  "    pm.expect(children_policy_id).to.be.a('string').and.match(/^cp_/);",
                  "    pm.expect(jsonBody?.children_policy?.capabilities).to.be.an('object');",
